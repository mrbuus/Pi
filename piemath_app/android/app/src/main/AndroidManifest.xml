<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- API-тай холбогдох (release-д ч заавал). SECURITY.md §2 -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Шалгалтын үеийн скриншот илрүүлэх (Android 14+, энгийн зөвшөөрөл, хэрэглэгчээс асуухгүй).
         EXAM-INTEGRITY.md §2 -->
    <uses-permission android:name="android.permission.DETECT_SCREEN_CAPTURE"/>
    <!-- Шалгалтын үеийн дэлгэц бичлэг илрүүлэх (Android 15+, энгийн зөвшөөрөл) -->
    <uses-permission android:name="android.permission.DETECT_SCREEN_RECORDING"/>
    <!-- Push мэдэгдэл (Android 13+, нэвтэрсний дараа асууна). Firebase тохируулаагүй бол асуухгүй. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Залгаасаас орж ирж болох, апп-д ХЭРЭГГҮЙ зөвшөөрлийг хасна (COMPLIANCE.md §2.5).
         - Зураг сонгохдоо image_picker нь Android Photo Picker ашиглана: өргөн медиа зөвшөөрөл хэрэггүй
           (Play «Photo and Video Permissions» бодлого).
         - Биометр (flutter_secure_storage-ийн сонголт) ашиглахгүй.
         - Реклам ID ашиглахгүй (зар, tracking байхгүй; Families бодлого). -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove"/>
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" tools:node="remove"/>
    <uses-permission android:name="android.permission.USE_BIOMETRIC" tools:node="remove"/>
    <uses-permission android:name="android.permission.USE_FINGERPRINT" tools:node="remove"/>
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove"/>

    <!-- allowBackup=false: токен (flutter_secure_storage) Google Drive-д нөөцлөгдөхгүй,
         сэргээхэд "Failed to unwrap key" алдаа гарахгүй. dataExtractionRules нь Android 12+
         төхөөрөмж хооронд шилжүүлэхийг ч хаана.
         usesCleartextTraffic=false + networkSecurityConfig: зөвхөн HTTPS (debug-д л localhost).
         enableOnBackInvokedCallback=true: Android 13+ predictive back (Flutter PopScope-той ажиллана,
         targetSdk 36-д өгөгдмөл; COMPLIANCE.md §2.4). -->
    <application
        android:label="Piemath"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Номын QR (https://pimath.mn/q/<код>) апп-д нээгдэнэ (Android App Links).
                 Баталгаажуулалтад вэбийн /.well-known/assetlinks.json хэрэгтэй (bundle ID батлагдсаны дараа). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="pimath.mn" android:pathPrefix="/q/"/>
                <data android:scheme="https" android:host="www.pimath.mn" android:pathPrefix="/q/"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
