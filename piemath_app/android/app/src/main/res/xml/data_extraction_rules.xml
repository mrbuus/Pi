<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: үүлэн нөөц ба төхөөрөмж хооронд шилжүүлэхэд апп-ын өгөгдлийг (токен,
     кэш) ОРУУЛАХГҮЙ. Шинэ утсанд дахин нэвтэрнэ (SECURITY.md §1, §3). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
