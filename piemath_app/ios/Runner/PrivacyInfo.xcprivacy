<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Piemath апп-ын нууцлалын манифест (docs/COMPLIANCE.md §1.1).
  - Tracking үгүй, tracking домэйн үгүй (реклам, ATT байхгүй).
  - Цуглуулах өгөгдөл: App Store Connect-ийн App Privacy хариулттай ЯГ ижил байх ёстой.
  - Required-reason API: апп-ын өөрийн код (Dart → App.framework):
      UserDefaults CA92.1 — shared_preferences (зөвхөн апп-ын өөрийн тохиргоо)
      FileTimestamp C617.1 — lib/core/files/file_cache.dart statSync (апп-ын контейнер доторх кэш)
    Flutter engine, залгаасууд (firebase, google_sign_in, image_picker, mobile_scanner,
    url_launcher, connectivity_plus, secure_storage, shared_preferences, path_provider)
    өөрсдийн PrivacyInfo.xcprivacy-тэй.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeName</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
