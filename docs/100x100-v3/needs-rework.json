 {
  "page": 74,
  "num": 8,
  "token": "100V3-RATEQ-11-B-08",
  "statement": "$\\begin{cases} \\frac{x-y}{5} - \\frac{x+y}{3} = 12 \\\\ \\frac{x+y}{6} - \\frac{x-y}{2} = 10 \\end{cases}$ системийн шийдүүдийн харьцаа $\\frac{x_0}{y_0} - $ үйүт үг ол."
 },
 {
  "page": 74,
  "num": 9,
  "token": "100V3-RATEQ-11-B-09",
  "statement": "$\\begin{cases} 3x + ay = 8 \\\\ 3x - 2y = b \\end{cases}$ системийн тэгшитгэлийн шийд $(2; 2)$ бол $a + b - $ үйүт үг ол."
 },
 {
  "page": 77,
  "num": 6,
  "token": "100V3-RATEQ-12-A-06",
  "statement": "$\\begin{cases} x^{2} + y^{2} = 25 \\\\ x + y = 7 \\end{cases}$ систем тэгшитгэлийн шийдүүд $(x_1; y_1)$ ба $(x_2; y_2)$ бол $x_1 + y_2 - $ үйүт үг ол. (Энд $x_1 > x_2$)"
 },
 {
  "page": 77,
  "num": 7,
  "token": "100V3-RATEQ-12-A-07",
  "statement": "$\\begin{cases} x^{2} - y^{2} = 1 \\\\ x^{2} + 4y^{2} = 1 \\end{cases}$ систем тэгшитгэлийн шийдүүд $(x_1; y_1)$ ба $(x_2; y_2)$ бол $(y_2 + y_1) - (x_2 - x_1) - $ үйүт үг ол. (Энд $x_1 < x_2$)"
 },
 {
  "page": 77,
  "num": 8,
  "token": "100V3-RATEQ-12-A-08",
  "statement": "$\\begin{cases} \\frac{1}{x-y} + x = 1 \\\\ \\frac{x^{2}}{x-y} = -2 \\end{cases}$ систем тэгшитгэлийн шийдүүдийн харьцаа $x_0 - y_0 - $ үйүт үг ол."
 },
 {
  "page": 77,
  "num": 9,
  "token": "100V3-RATEQ-12-A-09",
  "statement": "$\\begin{cases} x^{2} - 9y^{2} - x + 3y = 12 \\\\ x + 3y = 5 \\end{cases}$ систем тэгшитгэлийн шийдүүдийн харьцаа $\\frac{x}{y} - $ үйүт үг ол."
 },
 {
  "page": 78,
  "num": 10,
  "token": "100V3-RATEQ-12-A-10",
  "statement": "$\\begin{cases} x - 2y = 3 \\\\ x^{2} + 4y^{2} = 5 \\end{cases}$ систем тэгшитгэлийн шийдүүд $(x_1; y_1)$ ба $(x_2; y_2)$ бол $x_1 + x_2 - $ үйүт үг ол."
 },
 {
  "page": 78,
  "num": 11,
  "token": "100V3-RATEQ-12-A-11",
  "statement": "$\\begin{cases} x^{2} - 4y^{2} = -3 \\\\ x^{2} + 4y + 4y^{2} = 9 \\end{cases}$ систем тэгшитгэлийн шийдүүд $(x_1; y_1)$ ба $(x_2; y_2)$ бол $y_1 + y_2 - $ үйүт үг ол."
 },
 {
  "page": 78,
  "num": 12,
  "token": "100V3-RATEQ-12-A-12",
  "statement": "$\\begin{cases} 2x + y = 6 \\\\ (3x - y)^{2} - 2(3x - y) - 8 = 0 \\end{cases}$ систем тэгшитгэлийн шийдүүд $(x_1, y_1)$ ба $(x_2, y_2)$ бол $y_1 + y_2 - $ үйүт үг ол."
 },
 {
  "page": 79,
  "num": 2,
  "token": "100V3-RATEQ-12-A-02",
  "statement": "$\\begin{cases} y = x^{2} + x \\\\ y - x = 4 \\end{cases}$ систем тэгшитгэлийн шийдүүд $(x_1, y_1)$ ба $(x_2, y_2)$ бол $(x_1 + y_1) - (x_2 - y_2) - $ үйүт үг ол. (Энд $y_1 < y_2$)"
 },
 {
  "page": 79,
  "num": 3,
  "token": "100V3-RATEQ-12-A-03",
  "statement": "$\\begin{cases} xy = 8 \\\\ y = 4x - 4 \\end{cases}$ систем тэгшитгэлийн шийдүүд $(x_1, y_1)$ ба $(x_2, y_2)$ бол $(x_1 - y_1) - (x_2 - y_2) - $ үйүт үг ол. (Энд $x_1 > x_2$)"
 },
 {
  "page": 79,
  "num": 4,
  "token": "100V3-RATEQ-12-A-04",
  "statement": "$\\begin{cases} x^{2} + 2y = 1 \\\\ y - 2x = -2 \\end{cases}$ систем тэгшитгэлийн шийдүүд $(x_1, y_1)$ ба $(x_2, y_2)$ бол $y_1 + y_2 - $ үйүт үг ол."
 },
 {
  "page": 80,
  "num": 6,
  "token": "100V3-RATEQ-12-B-06",
  "statement": "$\\begin{cases} x^{2} + y^{2} = 13 \\\\ x + y = 5 \\end{cases}$ систем тэгшитгэлийн шийдүүд $(x_1; y_1)$ ба $(x_2; y_2)$ бол $x_1 + y_2 - $ үйүт үг ол. (Энд $x_1 > x_2$)"
 },
 {
  "page": 80,
  "num": 7,
  "token": "100V3-RATEQ-12-B-07",
  "statement": "$\\begin{cases} x^{2} - y^{2} = 4 \\\\ x^{2} + 2y^{2} = 4 \\end{cases}$ систем тэгшитгэлийн шийдүүд $(x_1; y_1)$ ба $(x_2; y_2)$ бол $(y_1 + y_2) - (x_2 - x_1) - $ үйүт үг ол. (Энд $x_1 < x_2$)"
 },
 {
