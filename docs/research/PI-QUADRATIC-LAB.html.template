header{padding:20px max(18px,calc((100vw - 920px)/2))}header h1{font-size:25px;letter-spacing:-.4px;margin:0}.eyebrow{margin-bottom:4px}.wrap,main{max-width:960px}.controls{margin:8px auto}.controls>details{margin:0}.controls>details>summary{color:var(--muted);font-size:13px}.steps{padding:9px max(18px,calc((100vw - 920px)/2));gap:5px}.steps button{font-size:13px;padding:7px 10px}.steps span{display:none}.panel{padding:26px}.question{max-width:720px;margin:18px auto;border:0;padding:0}.question .math{font-size:25px;padding:26px 18px}.question h2{font-size:22px}.quiet-details{font-size:14px;color:var(--muted)}.quiet-details[open]{color:var(--ink)}.question-head{max-width:720px;margin:auto}.question-head h2{font-size:21px;margin:0}.question-head .muted{font-size:14px}.sticky-next{max-width:720px;margin:22px auto 0;align-items:center}.sticky-next .primary{min-width:145px}.question-tools{max-width:720px;margin:16px auto}.answer-preview{min-height:34px;color:var(--blue);padding:8px 0}.answer-preview:empty{display:none}.inline-number math{font-size:1em}.answer-chip{display:inline-flex;align-items:center;gap:6px;padding:4px 9px;border-radius:7px}.compact-result{display:flex;align-items:baseline;gap:12px;margin:16px 0}.compact-result strong{font-size:32px}.pause-screen{text-align:center;padding:50px 20px}.session-summary{display:flex;align-items:center;gap:12px}.measure-table{font-size:12px}details>summary{user-select:none}.quiet-link{font-size:13px;color:var(--muted)}main>.panel{margin-top:12px}.progress{margin:15px 0}.choices button{min-height:58px}.choices .chosen{background:#e4f4ef}.question .card{background:#f8fafc}.context-intro{max-width:680px}.context-intro h2{font-size:25px}.context-intro p{color:var(--muted)}footer{padding:8px 20px}footer .wrap{margin:0 auto}.first-help{font-size:13px;color:var(--muted)}.review-plan{font-size:14px}.telemetry-body{overflow:auto}.paused-label{color:var(--muted)}
