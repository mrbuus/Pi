:flex;flex-direction:column;gap:6px}.field>label{font-size:13px;color:var(--muted)}.field select{width:100%}.panel a{overflow-wrap:anywhere}.badge{display:inline-block;padding:3px 8px;border-radius:6px;background:#eaf0f6;color:#4a6380;font-size:12px;font-weight:650}.good{background:#e2f4eb;color:#146844}.bad{background:#fae9ed;color:var(--red)}.warn{background:#fff2e5;color:var(--warm)}.purple{background:#eee8f8;color:var(--purple)}.note{background:#edf6f4;border-left:3px solid var(--teal);padding:13px 16px;border-radius:0 9px 9px 0;margin:16px 0}.note.warn{border-color:var(--warm);background:#fff5eb}.note.blue{border-color:var(--blue);background:#eef3ff}.grid2{display:grid;grid-template-columns:1.15fr 1fr;gap:20px}.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:13px}.card{overflow-wrap:anywhere;overflow-x:auto;padding:18px;background:#f8fafc;border:1px solid var(--line);border-radius:12px;margin:12px 0}.card p:last-child{margin-bottom:0}.steps{display:flex;gap:6px;overflow:auto;position:sticky;top:0;background:#ffffffee;z-index:4;border-block:1px solid var(--line);padding:12px max(20px,calc((100vw - 1140px)/2));backdrop-filter:blur(7px)}.steps button{white-space:nowrap}.steps button[aria-current=step]{background:var(--navy);border-color:var(--navy);color:white}.steps span{margin-right:6px;font-weight:700}main{max-width:1180px;margin:20px auto 60px;padding:0 20px;scroll-margin-top:70px}#message{color:var(--red);padding:0 20px;max-width:1180px;margin:10px auto;font-weight:600}.flow{display:flex;flex-direction:column;gap:7px}.flow .card{margin:0;border-left:4px solid var(--teal)}.arrow{text-align:center;color:#8196a9;font-size:24px;line-height:1.2}.math{font-size:22px;padding:18px 12px;border:1px solid var(--line);border-radius:10px;background:white;overflow:auto;margin:14px 0}.math math{font-size:1.1em}math{font-family:Cambria,Georgia,serif}.choices{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.choices button{text-align:left;display:flex;gap:12px;align-items:center;min-height:52px}.choices button span{overflow:auto;min-width:0}.choices b{color:var(--blue)}.meta{display:flex;flex-wrap:wrap;gap:7px;font-size:12px;color:var(--muted)}.id{font:11px/1.5 ui-monospace,monospace;overflow-wrap:anywhere;color:#72859a}.numbers{display:flex;gap:6px;flex-wrap:wrap;margin:18px 0}.numbers button{min-width:40px;position:relative}.numbers button.filled:after{content:'•';font-size:12px;color:var(--teal);position:absolute;right:3px;top:0}.numbers button.current{background:var(--navy);color:white}.question{border:1px solid var(--line);border-radius:14px;padding:22px}.blanks{display:flex;flex-wrap:wrap;gap:9px;margin:15px 0}.blanks label{flex-direction:column;font-size:13px}.blanks input{width:48px;text-align:center}.answer-input{width:min(100%,380px)}.progress{height:7px;background:#e3ebf2;border-radius:7px;margin-top:15px;overflow:hidden}.progress>div{height:100%;background:var(--teal)}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:18px 0}.metric{border:1px solid var(--line);padding:15px;border-radius:12px;background:white}.metric strong{display:block;font-size:27px;line-height:1.35}.metric small{font-size:12px}.solution{padding:18px;border:1px solid #bbdcd2;background:#edf6f3;border-radius:10px;margin-top:15px}.solution .math{padding:12px;font-size:19px}.sticky-next{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;border-top:1px solid var(--line);padding-top:18px;margin-top:20px}.scroll{overflow:auto}table{width:100%;border-collapse:collapse;font-size:14px}td,th{padding:11px;border-bottom:1px solid var(--line);vertical-align:top;text-align:left}th{background:#edf2f7}summary{cursor:pointer;font-weight:650;padding:10px 0}details{margin:12px 0}.legend{display:flex;flex-wrap:wrap;gap:8px}.legend span{background:#f6f9fc;border:1px solid var(--line);padding:5px 10px;border-radius:8px;font-size:13px}.paper{background:repeating-linear-gradient(white,white 33px,#edf2f6 34px);border:1px solid var(--line);padding:18px;border-radius:12px}.scope{display:flex;gap:10px;flex-wrap:wrap}.scope label{font-size:13px}.tick{color:var(--teal)}.empty{padding:20px;border:1px dashed #b6c8d9;border-radius:10px;color:var(--muted)}.switch{display:flex;gap:0}.switch button:first-child{border-radius:9px 0 0 9px}.switch button:last-child{border-radius:0 9px 9px 0}.photo{display:inline-flex;justify-content:center;align-items:center;background:#eff3f7;border:1px dashed #aabccd;min-height:65px;width:calc(20% - 8px);border-radius:9px;font-size:12px}.photos{display:flex;gap:9px}.review-plan li{margin:12px 0}.timeline{padding-left:22px}.timeline li{margin-bottom:10px}.timeline small{display:block}.scope-note{font-size:12px;color:var(--muted)}footer{border-top:1px solid var(--line);padding:25px;color:var(--muted);font-size:13px}.hidden{display:none!important}input[data-review-count],input[data-grade]{width:85px}.error{color:var(--red)}.grid2>*,.grid3>*,.control-grid>*,.field{min-width:0}.keyhint{font-size:12px;margin:10px 0;color:var(--muted)}
