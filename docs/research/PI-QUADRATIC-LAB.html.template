<header><div class="topline"><div><div class="eyebrow">ШИНЭ ИРЭЭДҮЙН ЭЗЭД · PI.MN</div><h1>Өнөөдрийн ажил</h1></div><span class="badge">Тусдаа туршилт</span></div></header>
<div class="wrap controls"><details id="lab-tools"><summary>Суралцах зам, туршилтын тохиргоо</summary><section class="panel"><div class="control-grid"><div class="field"><label for="route">Суралцах зам · виртуал сурагч</label><select id="route"><option value="class">Танхим → гэрт бүртгэх</option><option value="makeup">Тасалсан хичээлээ нөхөх</option><option value="online">Веб, апп-аар бие даан сурах</option><option value="review">Өөрийн давтлага / алдааны сан</option><option value="weekly">Долоо хоногийн шалгалтын загвар</option></select></div><div class="field"><label for="test">Номын хүрээ</label><select id="test"><option value="9">Есдүгээр тест · өндөр зэргийн тэгшитгэл</option><option value="5">Тавдугаар тест · квадрат тэгшитгэл</option></select></div><div class="field"><label for="profile">Виртуал хариуны хувилбар</label><select id="profile"><option value="mixed">Алдаа, эргэлзээ холилдсон</option><option value="strong">Бүгд зөв, тусламжгүй</option><option value="struggle">Сууриа шалгах шаардлагатай</option><option value="guess">Зөв боловч ихэнхийг таасан</option><option value="partial">Дутуу ажил, санахгүй хариу</option><option value="helped">Тусламжтай зөв хийсэн</option><option value="slow">Зөв, эргэлзсэн · хурд тодорхойгүй</option></select></div></div><div class="topline" style="margin-top:15px"><small id="save-status"></small><div class="actions"><button class="small" data-act="export">Өгөгдөл, хугацааны JSON</button><button class="small" data-act="reset">Энэ замыг шинээр эхлэх</button></div></div><p class="scope-note">Бодит хүүхэд, API, өгөгдлийн сантай холбогдоогүй. Зам бүр тусдаа виртуал сурагч; энэ браузерт хадгална.</p></section></details></div>
<nav class="steps" id="steps" aria-label="Сургалтын алхмууд"></nav><div id="message" role="status" aria-live="polite"></div><main id="main"></main>
<footer><div class="wrap"><details><summary>Туршилтын тайлбар, судалгаа</summary><div class="actions"><a href="PI-QUADRATIC-LAB-INTERACTION.html">Дэлгэц, хугацааны бүртгэлийн загвар</a><a href="PI-QUADRATIC-LAB-COVERAGE.html">Нөхцөлүүд, судалгааны тайлбар</a><a href="PI-QUADRATIC-LAB-SOURCE-REVIEW.html">Эх ном, хариуны тулгалт</a><a href="PI-QUADRATIC-LAB-QA.html">Гүйцэтгэсэн шалгалт</a><a href="PI-MATH-PROJECT.html">Төслийн төлөвлөгөө</a><a href="PI-LOCAL-PROBLEM-GENERATION.html">Бодлого зохиогчийн судалгаа</a></div><p>Зураг/PDF, жинхэнэ багш/эцэг эхийн эрх, үүлэн синк, live шалгалтын сервер энэ HTML-д хэрэгжээгүй. Номын хариуны түлхүүр агуулсан тул нийтийн шалгалтын сервер болгон ашиглахгүй.</p></details></div></footer>
<script>/*KATEX_RUNTIME*/</script>
<script>
'use strict';
const DATA=/*DATASET*/;
const KEY='pi-quadratic-lab-v1';const Q=Object.fromEntries(DATA.questions.map(q=>[q.sourceId,q]));
const ROUTES={class:'Танхим → гэр',makeup:'Хичээл нөхөх',online:'Вебээр бие даалт',review:'Өөрийн давтлага',weekly:'Долоо хоногийн шалгалт'};
const STAGES=['Хичээл','Бодох','Даалгавар','Давтах','Үр дүн'];
const CONF={unmarked:'Тэмдэглээгүй',sure:'● Итгэлтэй',unsure:'? Эргэлзсэн',guess:'~ Таасан'};
const HELP={unknown:'Тусламж тэмдэглээгүй',no:'Тусламжгүй',yes:'Тусламж авсан'};
const esc=x=>String(x??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

const texCache=new Map();
function tex(v){const key=String(v);if(texCache.has(key))return texCache.get(key);let html;try{html=katex.renderToString(key,{output:'mathml',throwOnError:true,strict:'error',trust:false});}catch{html='<span class="error">Томьёоны бичлэгийг шалгана уу</span>';}if(texCache.size>500)texCache.clear();texCache.set(key,html);return html;}
function textTex(v){return '\\text{'+String(v).replace(/[\\{}%$#&_~^]/g,' ').slice(0,100)+'}';}
function numTex(v){const raw=String(v??'').trim().replace(/−/g,'-');if(numeric(raw)===null)return textTex(raw||'—');const parts=raw.split('/');return parts.length===2?'\\frac{'+parts[0]+'}{'+parts[1]+'}':raw;}
function typesetNumbers(root){if(!root)return;const walker=document.createTreeWalker(root,NodeFilter.SHOW_TEXT,{acceptNode(n){return n.parentElement?.closest('math,.katex,script,style,input,textarea,select,[data-no-typeset]')?NodeFilter.FILTER_REJECT:NodeFilter.FILTER_ACCEPT;}});const nodes=[];while(walker.nextNode())if(/\d/.test(walker.currentNode.nodeValue))nodes.push(walker.currentNode);for(const n of nodes){const str=n.nodeValue,re=/-?\d+(?:[./:×–-]\d+)*(?:%|[A-B])?/g;let match,last=0,frag=document.createDocumentFragment();while((match=re.exec(str))){frag.append(str.slice(last,match.index));const span=document.createElement('span');span.className='inline-number';span.innerHTML=tex(/[:×–-].*\d|\d-\d|[AB]$/.test(match[0])?textTex(match[0]):match[0].endsWith('%')?match[0].slice(0,-1)+'\\%':numTex(match[0]));frag.append(span);last=re.lastIndex;}frag.append(str.slice(last));n.replaceWith(frag);}}
const numberWords={0:'Тэг',1:'Нэг',2:'Хоёр',3:'Гурав',4:'Дөрөв',5:'Тав',6:'Зургаа',7:'Долоо',8:'Найм',9:'Ес',10:'Арав',11:'Арван нэг',12:'Арван хоёр',13:'Арван гурав',14:'Арван дөрөв',15:'Арван тав',20:'Хорь',30:'Гуч',40:'Дөч',60:'Жар'};
function plainNumberLabel(v){return numberWords[v]||'Бодлого';}
const badge=(t,c='')=>'<span class="badge '+c+'">'+esc(t)+'</span>';
function opts(map,v){return Object.entries(map).map(([k,t])=>'<option value="'+k+'" '+(k===v?'selected':'')+'>'+esc(t)+'</option>').join('');}
const now=()=>new Date().toISOString();
function defaultState(route='class',test=9){return {schema:1,route,test,profile:'mixed',stage:0,published:!['class','makeup'].includes(route),theory:false,paperReady:false,authorized:true,lessonDate:'2026-10-06',attemptDate:route==='makeup'?'2026-10-08':'2026-10-06',attendance:route==='makeup'?'өвчтэй':'ирсэн',scopeA:bookIDs(test,'A'),scopeB:bookIDs(test,'B'),sessions:{},drafts:{},retries:{},entryCorrections:{},entryCorrectionHistory:[],exposed:{},shown:{},events:[],material:null,materialHistory:[],teacher:null,teacherHistory:[],gradeMode:'solved',gradeCount:0,examWindow:'before',reviewConfig:{mode:'new',budget:10,count:0,foundation:false},proposal:null,notes:'',departure:'19:10',serial:0,warning:false,telemetry:null};}
function bookIDs(test,variant){return DATA.questions.filter(q=>q.kind==='book'&&q.testNumber===test&&q.variant===variant).map(q=>q.sourceId);}
let STORE={schema:1,active:'9_class',runs:{}},storageOK=true;
try{const loaded=JSON.parse(localStorage.getItem(KEY)||'null');if(loaded&&loaded.schema===1&&loaded.runs&&typeof loaded.runs==='object')STORE=loaded;}catch{}
if(!/^(5|9)_(class|makeup|online|review|weekly)$/.test(STORE.active||''))STORE.active='9_class';
function valid(s){return s&&s.schema===1&&ROUTES[s.route]&&DATA.sets[s.test]&&Array.isArray(s.scopeA)&&Array.isArray(s.scopeB)&&s.scopeA.concat(s.scopeB).every(id=>Q[id])&&s.sessions&&s.drafts&&s.retries&&s.exposed&&s.shown&&Array.isArray(s.events)&&s.reviewConfig;}
let S=STORE.runs[STORE.active];if(!valid(S)){const [t,r]=STORE.active.split('_');S=defaultState(r,Number(t));STORE.runs[STORE.active]=S;}

let timing=null,renderedTarget=null,manualPaused=false,lastViewKey=null,lastAction=null,saveTimer=null,renderEpoch=0;
const INTERACTION_IDLE_CAP_MS=90000,EVENT_LIMIT=2000,VIEW_LIMIT=800;
function telemetry(){if(!S.telemetry||S.telemetry.schema!==1||!Array.isArray(S.telemetry.events)||!S.telemetry.views)S.telemetry={schema:1,events:[],views:{},sequence:0,droppedEvents:0,droppedViews:0,policy:{idleCapMs:INTERACTION_IDLE_CAP_MS,clock:'performance.now intervals; ISO timestamps',rawKeystrokes:false,network:false}};return S.telemetry;}
function save(){STORE.runs[STORE.active]=S;try{localStorage.setItem(KEY,JSON.stringify(STORE));storageOK=true;}catch{storageOK=false;}const e=document.getElementById('save-status');if(e)e.textContent=storageOK?'Энэ браузерт хадгалсан · бусад төхөөрөмжтэй синк хийхгүй':'Хадгалалт боломжгүй · JSON экспортлоорой';}
function scheduleSave(){if(saveTimer)return;saveTimer=setTimeout(()=>{saveTimer=null;save();},1000);}
function flushSave(){if(saveTimer){clearTimeout(saveTimer);saveTimer=null;}save();}
function event(type,data={}){S.events.push({id:++S.serial,time:now(),virtualDate:S.attemptDate,type,...data});save();}
function viewKey(se,id,phase){return se.id+'|'+id+'|'+phase;}
function measureView(name,id,phase='first'){const se=S.sessions[name];if(!se||!id)return null;const t=telemetry(),key=viewKey(se,id,phase);if(!t.views[key]){if(Object.keys(t.views).length>=VIEW_LIMIT){t.droppedViews++;return null;}t.views[key]={sessionId:se.id,session:name,questionId:id,phase,origin:se.origin,firstShownAt:now(),visibleFocusedMs:0,interactionWindowEstimateMs:0,visits:0,buttonCount:0,editCount:0,pauseCount:0,firstAnswerLatencyMs:null,firstCommittedAnswerLatencyMs:null,firstInteractionLatencyMs:null,fixture:!!se.fixture};}return {key,v:t.views[key],se};}
function checkpoint(){if(!timing)return;const at=performance.now(),dt=Math.max(0,at-timing.start),obj=telemetry().views[timing.key];if(obj){obj.visibleFocusedMs+=dt;obj.interactionWindowEstimateMs+=Math.max(0,Math.min(at,timing.idleUntil)-timing.start);}const se=S.sessions[timing.session];if(se&&timing.phase==='first')se.entryMs=(se.entryMs||0)+dt;timing.start=at;}
function stopTiming(){checkpoint();timing=null;flushSave();}
function startTiming(name,id,phase='first'){const se=S.sessions[name];id=id||se?.ids[se.pos];renderedTarget={name,id,phase};if(document.hidden||manualPaused||!document.hasFocus()||!se||phase==='first'&&se.submitted)return;const obj=measureView(name,id,phase);if(!obj)return;const at=performance.now();if(lastViewKey!==obj.key){obj.v.visits++;lastViewKey=obj.key;lastAction=null;}timing={session:name,key:obj.key,phase,start:at,idleUntil:at+INTERACTION_IDLE_CAP_MS};scheduleSave();}
function pauseMeter(reason){checkpoint();if(timing){const v=telemetry().views[timing.key];if(v)v.pauseCount++;}timing=null;lastViewKey=null;lastAction=null;pushInteraction({type:'pause',action:reason});flushSave();}
function resumeMeter(){lastViewKey=null;if(renderedTarget&&!document.hidden&&!manualPaused&&document.hasFocus()){const {name,id,phase}=renderedTarget;startTiming(name,id,phase);}updateClock();}
function pushInteraction(row){const t=telemetry();t.events.push({sequence:++t.sequence,at:now(),run:STORE.active,...row});if(t.events.length>EVENT_LIMIT){t.droppedEvents+=t.events.length-EVENT_LIMIT;t.events.splice(0,t.events.length-EVENT_LIMIT);}scheduleSave();}
function interaction(type,action,el,answer=false){checkpoint();const at=performance.now(),name=el?.dataset.session||renderedTarget?.name,id=el?.dataset.id||el?.dataset.answer||el?.dataset.retryAnswer||renderedTarget?.id,se=S.sessions[name]||S.sessions[renderedTarget?.name],v=timing?telemetry().views[timing.key]:null;const delta=lastAction===null?null:Math.max(0,at-lastAction);if(v){if(v.firstInteractionLatencyMs===null)v.firstInteractionLatencyMs=v.visibleFocusedMs;if(type==='button')v.buttonCount++;if(type==='answer')v.editCount++;if(answer&&v.firstAnswerLatencyMs===null)v.firstAnswerLatencyMs=v.visibleFocusedMs;if(timing)timing.idleUntil=at+INTERACTION_IDLE_CAP_MS;}lastAction=at;const dest=action==='position'&&se?Math.max(0,Math.min(Number(el.dataset.pos),se.ids.length-1)):null;const navigation=dest===null?null:el.closest('.numbers')?'picker':dest>se.pos?'next':dest<se.pos?'previous':'current';pushInteraction({type,action,navigation,targetQuestionId:dest===null?null:se.ids[dest],targetStage:action==='stage'?Number(el.dataset.stage):null,sessionId:se?.id||null,questionId:id||null,origin:se?.origin||null,phase:renderedTarget?.phase||null,previousActionGapMs:delta,visibleFocusedMs:v?.visibleFocusedMs??null,inputMethod:type==='button'?'button':type==='answer'?'text-input':'control',viewport:innerWidth<600?'small':'large',fixture:!!se?.fixture,levelEvidenceEligible:!!se&&!se.fixture&&se.origin!=='paper-backfill'&&answer&&renderedTarget?.phase==='first'});}
function commitQuestion(name,id){checkpoint();const se=S.sessions[name],v=se&&telemetry().views[viewKey(se,id,'first')];if(v&&v.firstCommittedAnswerLatencyMs==null&&evaluate(Q[id],draft(name,id)).correct!==null)v.firstCommittedAnswerLatencyMs=v.visibleFocusedMs;}
function measurementSnapshot(se,id){commitQuestion(se.name,id);checkpoint();const v=telemetry().views[viewKey(se,id,'first')];return {schema:1,...(v?structuredClone(v):{}),measured:!!v,fixture:!!se.fixture,solveTimeEligible:!!v&&!se.fixture&&se.origin!=='paper-backfill'&&evaluate(Q[id],draft(se.name,id)).correct!==null,limitations:['visible time is not verified thinking time','idle cap is a heuristic','device and interruption effects require calibration']};}
function telemetryView(){checkpoint();const t=telemetry(),rows=Object.values(t.views).slice(-35);return '<details id="interaction-report"><summary>Үйлдэл, хугацааны бүртгэл</summary><p>Харагдаж, фокустай байсан хугацаа болон товч хоорондын зай. Бодох хугацаа, чадварын оноо гэж шууд үзэхгүй. Фото/цаасан ажлаас оруулсан хугацаа, виртуал бөглөлт нь түвшин тогтоох нотолгоо биш.</p><p>Үйлдэл '+t.events.length+' · хязгаараас хасагдсан '+t.droppedEvents+' · хэмжилт үүсээгүй '+t.droppedViews+'</p><div class="telemetry-body"><table class="measure-table"><tr><th>Бодлого / ажил</th><th>Харагдсан секунд</th><th>Анхны оролт / баталсан секунд</th><th>Товч / засалт</th><th>Хязгаар</th></tr>'+rows.map(v=>'<tr><td>'+esc(v.questionId)+'<br>'+esc(v.phase)+'</td><td>'+tex((v.visibleFocusedMs/1000).toFixed(1))+'</td><td>'+(v.firstAnswerLatencyMs===null?'Хариу бүртгээгүй':tex((v.firstAnswerLatencyMs/1000).toFixed(1)))+' / '+(v.firstCommittedAnswerLatencyMs==null?'—':tex((v.firstCommittedAnswerLatencyMs/1000).toFixed(1)))+'</td><td>'+v.buttonCount+' / '+v.editCount+'</td><td>'+(v.fixture?'Виртуал':v.origin==='paper-backfill'?'Хуулж оруулсан':'Браузерын ажиглалт')+'</td></tr>').join('')+'</table></div><details><summary>Сүүлийн үйлдлүүд</summary><ol class="timeline">'+t.events.slice(-25).map(e=>'<li>'+esc(e.action)+' · '+esc(e.questionId||'')+'<small>'+esc(e.at)+' · өмнөх үйлдлээс '+(e.previousActionGapMs==null?'—':tex((e.previousActionGapMs/1000).toFixed(2)))+' секунд</small></li>').join('')+'</ol></details><a href="PI-QUADRATIC-LAB-INTERACTION.html">Өгөгдлийн утга, дараах түвшний загвар</a></details>';}

function message(t=''){document.getElementById('message').textContent=t;typesetNumbers(document.getElementById('message'));}
function switchRun(route,test){stopTiming();renderedTarget=null;lastViewKey=null;lastAction=null;manualPaused=false;STORE.active=test+'_'+route;if(!valid(STORE.runs[STORE.active]))STORE.runs[STORE.active]=defaultState(route,test);S=STORE.runs[STORE.active];save();render();message('Зам бүр тусдаа виртуал сурагчтай; нэг замын хариуг нөгөөд нь хуулж холихгүй.');}
function draft(se,id){const key=se+'|'+id;return S.drafts[key]||(S.drafts[key]={answer:Q[id].answerType==='blanks'?{}:'',confidence:'unmarked',help:'unknown',status:'answered',method:'unknown'});}
function numeric(v){const s=String(v??'').trim().replace(/−/g,'-');if(!/^[+-]?(?:\d+(?:\.\d+)?|\.\d+)(?:\/[+-]?\d+(?:\.\d+)?)?$/.test(s))return null;const p=s.split('/').map(Number),n=p.length===2?p[0]/p[1]:p[0];return Number.isFinite(n)&&Math.abs(n)<=1e9?n:null;}
function evaluate(q,d){if(d.status!=='answered')return {outcome:d.status==='forgot'?'unknown':'notdone',correct:null};const a=d.answer;if(q.answerType==='choice'){if(!a)return {outcome:'notdone',correct:null};if(!q.choicesHTML[a])return {outcome:'invalid',correct:null};return {outcome:a===q.key?'correct':'wrong',correct:a===q.key};}
 if(q.answerType==='blanks'){const keys=Object.keys(q.key);const values=keys.map(k=>String(a?.[k]??'').trim());if(values.every(x=>!x))return {outcome:'notdone',correct:null};if(values.some(x=>!x))return {outcome:'incomplete',correct:null};if(values.some(x=>!/^\d$/.test(x)))return {outcome:'invalid',correct:null};const correct=keys.every(k=>Number(a[k])===q.key[k]);return {outcome:correct?'correct':'wrong',correct};}
 if(!String(a??'').trim())return {outcome:'notdone',correct:null};if(q.answerType==='none'){const s=String(a).trim().toLowerCase();if(!['шийдгүй','бодит шийдгүй','none','∅','0'].includes(s)){if(/[a-z]/i.test(s))return {outcome:'invalid',correct:null};return {outcome:'wrong',correct:false};}const correct=s!=='0';return {outcome:correct?'correct':'wrong',correct};}
 if(q.answerType==='scalar'){const n=numeric(a);if(n===null)return {outcome:'invalid',correct:null};const correct=Math.abs(n-numeric(q.key))<1e-9;return {outcome:correct?'correct':'wrong',correct};}
 const chunks=String(a).replace(/[{}]/g,'').split(/[;,\n]/).map(x=>x.trim());if(chunks.some(x=>numeric(x)===null))return {outcome:'invalid',correct:null};const vals=[...new Set(chunks.map(numeric))].sort((a,b)=>a-b);const want=[...new Set(q.key.map(numeric))].sort((a,b)=>a-b);const correct=vals.length===want.length&&vals.every((v,i)=>Math.abs(v-want[i])<1e-9);return {outcome:correct?'correct':'wrong',correct};}
function hasValue(d){return typeof d.answer==='object'?Object.values(d.answer).some(v=>String(v).trim()):String(d.answer??'').trim().length>0;}
function formatAnswer(q,a){if(q.answerType==='blanks')return tex(Object.keys(q.key).map(k=>k+'='+numTex(a?.[k]??'—')).join('\\,,\\quad '));if(q.answerType==='roots')return tex('\\{'+String(a||'').replace(/[{}]/g,'').split(/[;,\n]/).map(numTex).join(',\\,')+'\\}');if(q.answerType==='choice')return tex(/^[A-E]$/.test(String(a))?String(a):textTex(a||'—'));return tex(numTex(a===null||a===undefined||a===''?'—':a));}

function sourceLabel(q){return q.kind==='book'?'Ном · '+q.test+' · №'+q.number:'Шинэ тоон жишээ · ижил арга';}
function newSession(name,ids,origin){for(const key of Object.keys(S.drafts))if(key.startsWith(name+'|'))delete S.drafts[key];const session={id:STORE.active+'-'+(++S.serial),name,ids:[...ids],origin,records:[],submitted:false,pos:0,entryMs:0,fixture:false,startedAt:now(),virtualDate:S.attemptDate,status:'active'};S.sessions[name]=session;event('session_start',{session:name,origin,ids:[...ids]});return session;}
function allRecords(){return Object.values(S.sessions).flatMap(se=>se.records||[]);}
function latestFirst(id){return allRecords().filter(r=>r.questionId===id).at(-1);}
function summary(se){const rows=se?.records||[];return {correct:rows.filter(r=>r.correct===true).length,wrong:rows.filter(r=>r.correct===false).length,missing:rows.filter(r=>r.correct===null).length,assisted:rows.filter(r=>r.correct===true&&(r.help==='yes'||r.exposureBefore)).length,guess:rows.filter(r=>r.correct===true&&r.confidence==='guess').length,total:se?.ids.length||0,attempted:rows.filter(r=>r.correct!==null).length};}
function metrics(se){const m=summary(se);return '<div class="metrics"><div class="metric"><strong>'+m.correct+'/'+m.total+'</strong><small>Анхны зөв · бүх оноосон бодлого</small></div><div class="metric"><strong>'+m.wrong+'</strong><small>Анхны буруу</small></div><div class="metric"><strong>'+m.missing+'</strong><small>Хийгээгүй / санахгүй / дутуу</small></div><div class="metric"><strong>'+m.assisted+' / '+m.guess+'</strong><small>Зөвөөс тусламжтай / таасан</small></div></div>';}
function inputHTML(q,d,se,retry=false){const attr=retry?'data-retry-answer="'+q.sourceId+'"':'data-answer="'+q.sourceId+'" data-session="'+se+'"';if(q.answerType==='choice')return '<div class="choices">'+Object.entries(q.choicesHTML).map(([k,v])=>'<button '+(retry?'data-act="retry-choice"':'data-act="choice"')+' data-session="'+se+'" data-id="'+q.sourceId+'" data-value="'+k+'" class="'+(d.answer===k?'chosen':'')+'" aria-pressed="'+(d.answer===k)+'"><b>'+k+'</b><span>'+v+'</span></button>').join('')+'</div>';
 if(q.answerType==='blanks')return '<div class="blanks">'+Object.keys(q.key).map(k=>'<label>'+tex(k)+'<input '+attr+' data-blank="'+k+'" inputmode="numeric" maxlength="1" aria-label="'+q.test+' '+q.number+' бодлогын '+k+' нүд" value="'+esc(d.answer?.[k]??'')+'"></label>').join('')+'</div><div class="answer-preview" data-preview="'+q.sourceId+'">'+(hasValue(d)?formatAnswer(q,d.answer):'')+'</div><p class="keyhint">Нүд бүр нэг цифр. [cd] гэх хос нүдийг тус тусад нь нөхнө. Эх номын чиглүүлэх бодолттой даалгавар.</p>';
 return '<input class="answer-input" '+attr+' autocomplete="off" aria-label="Бодлогын хариу" placeholder="'+(q.answerType==='roots'?'Шийдүүдээ оруулна':q.answerType==='none'?'Бодит шийдгүй бол: шийдгүй':'Хариугаа оруулна')+'" value="'+esc(d.answer??'')+'"><div class="answer-preview" data-preview="'+q.sourceId+'">'+(hasValue(d)?formatAnswer(q,d.answer):'')+'</div><p class="keyhint">'+(q.answerType==='roots'?'Шийдүүдээ ; тэмдэг эсвэл таслалаар тусгаарлана. Дараалал хамаарахгүй. Бутархайг 1/2 гэж бичнэ.':'Аравтын тоонд цэг хэрэглэнэ. “0” нь “шийдгүй” гэсэн үг биш.')+'</p>';}
function questionMeta(q){return '<details class="quiet-details"><summary>Бодлогын мэдээлэл</summary><div class="meta">'+badge(sourceLabel(q),q.kind==='generated'?'purple':'')+q.tags.map(t=>badge(DATA.skills[t])).join('')+'</div><p class="id">'+esc(q.sourceId)+(q.bookPage?' · номын хуудас '+q.bookPage:'')+'</p><p class="scope-note">Эх номтой тулгасан LaTeX сангаас дүрсэлсэн. Шинэ тоон жишээ тусдаа ID-тай.</p></details>';}

function renderQuestion(name){const se=S.sessions[name];if(!se)return '<div class="empty">Эхний алхмаас эхэлнэ үү.</div>';if(se.submitted)return renderResults(name);const pos=Math.max(0,Math.min(se.pos,se.ids.length-1));se.pos=pos;const q=Q[se.ids[pos]],d=draft(name,q.sourceId);renderedTarget={name,id:q.sourceId,phase:'first'};if(manualPaused)return '<div class="pause-screen"><h2>Түр завсарласан</h2><p>Энэ хугацааг идэвхтэй ажилласан хугацаанд оруулахгүй.</p><button class="primary" data-act="pause">Үргэлжлүүлэх</button></div>';S.exposed[q.sourceId]=true;startTiming(name,q.sourceId);
 const count=se.ids.filter(id=>hasValue(draft(name,id))).length,last=pos===se.ids.length-1;
 return '<div class="question-head"><div class="topline"><h2>'+({foundation:'Суурийн жишээ',primary:S.route==='class'?'Номын тэмдэглэлээ оруулах':'A · анхны оролдлого',home:'B · дараагийн ажил',review:'Миний давтлага',probe:'Шинэ жишээгээр шалгах',delayed:'Дараах өдрийн жишээ'}[name]||name)+'</h2><span class="muted">'+tex((pos+1)+'/'+se.ids.length)+'</span></div><div class="progress" aria-label="Бөглөсөн бодлого"><div style="width:'+Math.round(100*count/se.ids.length)+'%"></div></div>'+(S.route==='class'&&name==='primary'?'<p class="first-help">Ангид бодсон анхны хариугаа оруулна.</p>':'')+'</div><article class="question" data-question="'+q.sourceId+'" data-session="'+name+'"><div class="math">'+q.statementHTML+'</div>'+(q.scaffoldHTML?'<div class="card">'+q.scaffoldHTML+'</div>':'')+inputHTML(q,d,name)+'<details class="quiet-details"><summary>Тэмдэглэл нэмэх</summary><div class="control-grid"><div class="field"><label>Итгэл</label><select data-draft="confidence" data-session="'+name+'" data-id="'+q.sourceId+'">'+opts(CONF,d.confidence)+'</select></div><div class="field"><label>Тусламж</label><select data-draft="help" data-session="'+name+'" data-id="'+q.sourceId+'">'+opts(HELP,d.help)+'</select></div><div class="field"><label>Ажилласан эсэх</label><select data-draft="status" data-session="'+name+'" data-id="'+q.sourceId+'">'+opts({answered:'Хариулт өгнө',notdone:'Чадаагүй / хийгээгүй',forgot:'Анхны хариугаа санахгүй'},d.status)+'</select></div></div><p><label>Арга <select data-draft="method" data-session="'+name+'" data-id="'+q.sourceId+'">'+opts({unknown:'Тэмдэглээгүй',factor:'Үржигдэхүүн / бүлэглэх',formula:'Ерөнхий томьёо / D',vieta:'Виет / нийлбэр, үржвэр',power:'Зэргийн чанар',other:'Өөр арга'},d.method)+'</select></label></p><small>Сонгоогүй бол тэмдэглээгүй хэвээр. Зөв хариунаас итгэл, тусламжийг таахгүй.</small></details>'+questionMeta(q)+'</article><div class="sticky-next session-nav"><button data-act="position" data-session="'+name+'" data-pos="'+(pos-1)+'" '+(pos===0?'disabled':'')+'>← Өмнөх</button>'+(last?'<button class="primary" data-act="submit" data-session="'+name+'">Дуусгаж дүн харах</button>':'<button class="primary" data-act="position" data-session="'+name+'" data-pos="'+(pos+1)+'">Дараах →</button>')+'</div><div class="question-tools"><details class="quiet-details"><summary>Бодлогын жагсаалт · '+tex(count+'/'+se.ids.length)+' бөглөсөн</summary><div class="numbers">'+se.ids.map((id,i)=>'<button data-act="position" data-session="'+name+'" data-pos="'+i+'" class="'+(i===pos?'current ':'')+(hasValue(draft(name,id))?'filled':'')+'" aria-label="'+(i+1)+'-р бодлого" '+(i===pos?'aria-current="true"':'')+'>'+tex(String(i+1))+'</button>').join('')+'</div>'+(!last?'<button data-act="submit" data-session="'+name+'">Энд хүрээд дуусгах</button>':'')+'</details><button class="small quiet-link" data-act="pause">Түр завсарлах</button><details class="quiet-details"><summary>Виртуал өгөгдлөөр турших</summary><p>Автоматаар бөглөсөн хугацаа бодит UX хэмжилт биш.</p><button data-act="fixture" data-session="'+name+'">Сонгосон хувилбарын хариуг бөглөх</button></details></div>';
}

function submit(name,allowMissing=false,reason='submitted'){const se=S.sessions[name];if(!se||se.submitted)return;if(name==='primary'&&S.route==='weekly'&&S.examWindow!=='open'&&reason!=='timeout-modeled'){message('Шалгалтын цонх хаагдсан. Хариунууд браузерт хадгалагдсан; илгээхийг түр хориглов.');return;}if(!S.authorized&&reason!=='timeout-modeled'){message('Виртуал эрх хаалттай байна. Хариу энэ браузерт үлдсэн; илгээх эрхийг нээгээд үргэлжлүүлнэ.');return;}
 const rows=se.ids.map(id=>({id,d:draft(name,id),v:evaluate(Q[id],draft(name,id))}));const invalid=rows.find(r=>r.v.outcome==='invalid');if(invalid&&reason!=='timeout-modeled'){se.pos=se.ids.indexOf(invalid.id);render();message('Хариуны бичлэг хүчингүй. Нүдэнд нэг цифр, тоонд бутархай/цэг, шийдүүдэд ; тэмдэг хэрэглэнэ.');return;}
 const missing=rows.filter(r=>r.v.correct===null);if(missing.length&&!allowMissing){S.warning={session:name,count:missing.length};render();message(missing.length+' бодлого хийгээгүй, санахгүй эсвэл нүд дутуу. Тэдгээрийг буруу хариулттай адил үзэхгүй.');return;}
 stopTiming();se.records=rows.map(({id,d,v})=>({attemptId:se.id+'-'+id,questionId:id,answer:structuredClone(d.answer),confidence:d.confidence,help:d.help,status:d.status,method:d.method,...v,origin:se.origin,virtualDate:S.attemptDate,recordedAt:now(),exposureBefore:!!S.shown[id],sourceScaffold:!!Q[id].scaffoldHTML,fixture:se.fixture,interaction:measurementSnapshot(se,id)}));se.submitted=true;se.status=reason;se.finishedAt=now();S.warning=false;event('session_submit',{session:name,reason,missing:missing.length});render();}
function fixture(name){const se=S.sessions[name];if(!se||se.submitted)return;se.fixture=true;for(const v of Object.values(telemetry().views))if(v.sessionId===se.id)v.fixture=true;se.ids.forEach((id,i)=>{const q=Q[id],d=draft(name,id);let wrong=(S.profile==='mixed'&&i%4===0)||(S.profile==='struggle'&&i%3!==2);d.status='answered';d.confidence=S.profile==='guess'?'guess':S.profile==='struggle'?'unsure':S.profile==='slow'&&i%3===0?'unsure':'sure';d.help=S.profile==='helped'?'yes':'no';d.answer=structuredClone(q.key);if(wrong){if(q.answerType==='choice')d.answer=Object.keys(q.choicesHTML).find(k=>k!==q.key);else if(q.answerType==='blanks')d.answer={...q.key,[Object.keys(q.key)[0]]:(q.key[Object.keys(q.key)[0]]+1)%10};else if(q.answerType==='roots')d.answer=q.key.map(x=>numeric(x)+1).join(';');else if(q.answerType==='scalar')d.answer=String(numeric(q.key)+1);else d.answer='0';}else if(q.answerType==='roots')d.answer=q.key.join(';');else if(q.answerType==='none')d.answer='шийдгүй';if(S.profile==='mixed'&&i%5===1)d.confidence='unsure';if(S.profile==='mixed'&&i%5===2)d.confidence='guess';if(S.profile==='mixed'&&i===3)d.help='yes';if(S.profile==='partial'&&i>=Math.floor(se.ids.length/2)){d.status=i%2?'forgot':'notdone';d.answer=q.answerType==='blanks'?{}:'';}S.exposed[id]=true;});event('fixture_fill',{session:name,profile:S.profile});render();}
function retryDraft(id){return draft('retry',id);}
function resultName(r){return {correct:'Зөв',wrong:'Буруу',notdone:'Хийгээгүй',unknown:'Санахгүй',incomplete:'Нүд дутуу',invalid:'Бичлэг хүчингүй'}[r.outcome];}
function renderResults(name){const se=S.sessions[name],m=summary(se);const needs=se.records.filter(r=>r.correct!==true||r.confidence==='guess'||r.confidence==='unsure'||r.help==='yes');const selected=se.resultID&&se.ids.includes(se.resultID)?se.resultID:(needs[0]?.questionId||se.ids[0]);se.resultID=selected;const r=se.records.find(r=>r.questionId===selected),q=Q[selected],rs=S.retries[selected]||[],latest=rs.at(-1),d=retryDraft(selected);const solutionAllowed=r.correct===true||rs.length>0||S.shown[selected];startTiming(name,selected,'correction');
 return '<h2>'+({foundation:'Суурийн 3 жишээ · үр дүн',primary:'Анхны ажил · үр дүн',home:'B ажил · үр дүн',review:'Давтлагын үр дүн',probe:'Шинэ тоон нөхцөлийн үр дүн',delayed:'Дараах өдрийн үр дүн'}[name])+'</h2><div class="compact-result"><strong>'+tex(m.correct+'/'+m.total)+'</strong><span>анхны зөв</span></div><details class="quiet-details"><summary>Үр дүнгийн тайлбар, тусламжийн мэдээлэл</summary>'+metrics(se)+'<p class="muted">Зөвийн тоо нь анхны хариу. Хийгээгүйг буруу гэж оношлохгүй. Таасан зөв, тусламжтай зөв, номын чиглүүлэх бодолттой даалгаврыг тусад нь хадгална.</p><div class="note blue">'+(se.origin==='paper-backfill'?'Цаасан ажлаас нөхөж оруулсан мэдүүлэг. Бүртгэлийн хугацаа бодсон хугацаа биш.':'Веб дээр өгсөн хариу. Браузер гаднах тусламжийг баталгаатай илрүүлэхгүй; “тусламжгүй” нь өөрийн мэдүүлэг.')+(se.fixture?' Виртуал хариу ашигласан; хугацааны хэмжилт хүчинтэй биш.':' Бөглөх дэлгэц идэвхтэй байсан '+Math.round(se.entryMs/1000)+' секунд; сурах/бодох хурд гэж шууд дүгнэхгүй.')+'</div></details><label>Шалгах бодлого <select data-result-session="'+name+'">'+se.records.map(r=>'<option value="'+r.questionId+'" '+(r.questionId===selected?'selected':'')+'>'+plainNumberLabel(Q[r.questionId].number)+' · '+resultName(r)+' · '+(CONF[r.confidence]||'')+'</option>').join('')+'</select></label><article class="question" style="margin-top:17px">'+questionMeta(q)+'<div class="math">'+q.statementHTML+'</div><div class="chips">'+'<span class="answer-chip '+(r.correct?'good':r.correct===false?'bad':'warn')+'">Анхны: '+formatAnswer(q,r.answer)+'</span>'+badge(resultName(r))+(r.confidence!=='unmarked'?badge(CONF[r.confidence]):'')+(r.help!=='unknown'?badge(HELP[r.help]):'')+'</div>'+(r.sourceScaffold?'<p class="scope-note">Энэ бодлого номондоо чиглүүлэх бодолттой. Туслах алхамгүй шинэ бодлогын нотолгоотой адил биш.</p>':'')+(latest?'<div class="note">Давтан: '+badge(resultName(latest),latest.correct?'good':'bad')+' · '+(latest.assisted?'бодолт/тусламжтай':latest.help==='no'?'тусламжгүй гэж мэдүүлсэн':'тусламж тэмдэглээгүй')+' · анхны хариуг солихгүй.</div>':'')+'<details '+(r.correct!==true?'open':'')+'><summary>Дахин бодож үзэх</summary>'+inputHTML(q,d,'retry',true)+'<p><label>Давтан бодолтын тусламж <select data-draft="help" data-session="retry" data-id="'+selected+'">'+opts(HELP,d.help)+'</select></label></p><div class="actions" style="margin-top:12px"><button class="primary" data-act="retry" data-id="'+selected+'">Давтан хариугаа шалгах</button><button data-act="need-help" data-id="'+selected+'">Яаж бодохоо мэдэхгүй</button><button data-act="solution" data-id="'+selected+'" '+(!solutionAllowed?'disabled':'')+'>Бодолт харах</button></div><small>Анхны буруу + дахин буруу үед бодолт харах боломж нээгдэнэ. Тусламж хүсвэл шууд тайлбар руу орж болно.</small></details>'+(S.shown[selected]?'<div class="solution"><h3>Алхам, шалгах зүйл</h3><p>'+esc(q.hint)+'</p>'+q.stepsHTML.map(x=>'<div class="math">'+x+'</div>').join('')+'<p>'+esc(q.note)+'</p><p>Зөв хариу: '+formatAnswer(q,q.answerType==='roots'?q.key.join(';'):q.key)+'</p></div>':'')+(se.origin==='paper-backfill'?'<details><summary>Зөвхөн хуулж оруулахдаа алдсан уу?</summary><p>Энэ нь шинэ бодолт биш. Анхны бүртгэл үлдэж, “бүртгэлийн засвар” гэсэн шинэ мөр нэмэгдэнэ. Зөрүүтэй мөрийг оношлох нотолгооноос түр гаргана.</p><button data-act="entry-correction" data-id="'+selected+'" data-attempt="'+r.attemptId+'">Дээрх шинэ хариуг бүртгэлийн засвар гэж үлдээх</button>'+(S.entryCorrections[selected]?'<p>'+formatAnswer(q,S.entryCorrections[selected].answer)+' · бүртгэлийн засвар тэмдэглэсэн</p>':'')+'</details>':'')+'</article><details><summary>Бүх анхны хариу · өөрчлөгдөхгүй түүх</summary><div class="scroll"><table><tr><th>Бодлого</th><th>Анхны</th><th>Төлөв</th><th>Итгэл / тусламж</th></tr>'+se.records.map(r=>'<tr><td>'+esc(sourceLabel(Q[r.questionId]))+'</td><td>'+formatAnswer(Q[r.questionId],r.answer)+'</td><td>'+resultName(r)+'</td><td>'+esc(CONF[r.confidence]+' · '+HELP[r.help])+'</td></tr>').join('')+'</table></div></details><div class="sticky-next"><small>Анхны хариу, давтан бодолт, бодолт үзсэн түүх тусдаа.</small><button class="primary" data-act="stage" data-stage="'+(name==='foundation'?0:name==='primary'?(S.route==='weekly'?4:2):name==='home'?3:4)+'">'+(name==='foundation'?'Үндсэн ажилдаа буцах':name==='primary'?(S.route==='weekly'?'Шалгалтын дүн харах':'B ажил руу'):name==='home'?'Давтлага төлөвлөх':'Ахиц харьцуулах')+' →</button></div>';
}
function scopeEditor(variant){const locked=!!S.sessions.primary;const chosen=variant==='A'?S.scopeA:S.scopeB;return '<div class="scope">'+bookIDs(S.test,variant).map(id=>'<label><input type="checkbox" data-scope="'+variant+'" value="'+id+'" '+(chosen.includes(id)?'checked':'')+' '+(locked?'disabled':'')+'>'+Q[id].number+'</label>').join('')+'</div>';}
function context(){const set=DATA.sets[S.test],absent=S.route==='makeup';const intro=S.route==='class'?'Ном дээр бодсон ажлаа гэртээ бүртгээд, алдаагаа засаж, дараагийн хувилбараар шалгана.':absent?'Тасалсан өдрийн онолыг уншаад, тухайн ажлаа нөхөж хийнэ.':S.route==='online'?'Онол → анхны оролдлого → алдааны тайлбар → шинэ хувилбар.':'Хугацаа эсвэл бодлогын тоогоо сонгоод мэдлэгээ бататгана.';
 return '<section class="panel"><div class="context-intro"><span class="badge">'+esc(ROUTES[S.route])+'</span><h2 style="margin-top:15px">'+esc(set.title)+'</h2><p>'+intro+'</p><p>'+tex(String(S.scopeA.length))+' бодлого · дараагийн B ажил '+tex(String(S.scopeB.length))+'</p></div><details '+(absent?'open':'')+'><summary>Онолын товч сануулга · '+(S.theory?'уншсан':'уншаагүй')+'</summary><div class="card"><h3>Тэг үржвэр</h3><div class="math">'+tex('ab=0\\Rightarrow a=0\\;\\text{эсвэл}\\; b=0')+'</div><p>Үл мэдэгдэх үржигдэхүүнээр хуваахаас өмнө тэг болох нөхцөлийг үлдээнэ.</p><h3>Квадратын шийд</h3><div class="math">'+tex('ax^2+bx+c=0,\\quad a\\ne0')+'</div><div class="math">'+tex('D=b^2-4ac,\\qquad x=\\frac{-b\\pm\\sqrt D}{2a}')+'</div><p>'+tex('D<0')+' бодит шийдгүй; '+tex('D=0')+' нэг ялгаатай шийд; '+tex('D>0')+' хоёр.</p><p>Бүх шийд, их/бага шийд, нийлбэр, үржвэрийг ялгана.</p><button data-act="theory">Онолын сануулгыг уншсан</button><p class="scope-note">Багшийн бүтэн онол, зураг/видео холбох ажил үлдэнэ.</p></div></details>'+(S.route==='weekly'?'<div class="card"><label>Шалгалтын цонх <select data-state="examWindow">'+opts({before:'Хараахан нээгдээгүй',open:'Нээлттэй',closed:'Хаагдсан'},S.examWindow)+'</select></label><small> · Виртуал таймер, live сервер биш.</small></div>':'')+'<div class="sticky-next"><span class="muted">'+(!S.authorized?'Виртуал эрх хаалттай.':'Анхны хариугаа хадгалаад дараа нь дүнгээ харна.')+'</span><button class="primary" data-act="start-primary">'+(S.route==='review'?'Давтлага сонгох →':S.sessions.primary?'Үргэлжлүүлэх →':absent?'Нөхөлт эхлэх →':'Эхлэх →')+'</button></div><details class="quiet-details"><summary>Хичээлийн хүрээ, багшийн тохиргоо</summary><p>Тавдугаар тест квадрат; есдүгээр тест куб, дөрөвдүгээр зэрэг, үржигдэхүүнд задлах агуулгатай. Номын '+set.time+' минут нь хүүхэд бүрийн хурдны тооцоо биш.</p><h4>A ажил</h4>'+scopeEditor('A')+'<h4>B ажил</h4>'+scopeEditor('B')+'<p><button data-act="publish" '+(S.sessions.primary?'disabled':'')+'>Хүрээ баталж нээх</button></p>'+(absent?'<label>Өмнөх ирц <select data-state="attendance">'+opts({'өвчтэй':'Өвчтэй','чөлөөтэй':'Чөлөөтэй','тасалсан':'Тасалсан'},S.attendance)+'</select></label><p>Эх хичээл '+S.lessonDate+' · нөхөх '+S.attemptDate+'</p>':'')+'<label><input type="checkbox" data-state="authorized" '+(S.authorized?'checked':'')+'>Виртуал эрх нээлттэй</label></details><details class="quiet-details"><summary>Суурийн жишээ · заавал биш</summary><p>Гурван жижиг жишээ; бүтэн чадварын оношилгоо биш. Үндсэн тестийг хаахгүй.</p><button data-act="foundation">Суурийн 3 жишээг нээх</button></details>'+(S.sessions.foundation?'<section class="card">'+renderQuestion('foundation')+'</section>':'')+'</section>';
}

function primary(){if(!S.sessions.primary)return '<section class="panel"><h2>Эхний ажил эхлээгүй</h2><p>Хүрээ, онолын алхмаас эхэлнэ.</p><button data-act="stage" data-stage="0">Хүрээ рүү</button></section>';return '<section class="panel">'+(S.route==='weekly'&&!S.sessions.primary.submitted?'<div class="note warn">Шалгалтын загвар · <span id="exam-clock"></span> <button class="small" data-act="timeout">Хугацаа дуусах нөхцөлийг турших</button> · Бодолт дуусахаас өмнө нээгдэхгүй.</div>':'')+renderQuestion('primary')+'</section>';}
function home(){if(!S.sessions.primary?.submitted)return '<section class="panel"><h2>A ажил дуусаагүй</h2><p>Эхний ажил, дутуу төлөвөө эхлээд илгээнэ.</p><button data-act="stage" data-stage="1">A ажил</button></section>';let html='<section class="panel"><h2>B · '+(S.route==='makeup'?'Нөхөлтийн даалгавар':S.route==='online'?'Шинэ тоон нөхцөлтэй хувилбар':'Гэрийн даалгавар')+'</h2><p>Ажлын огноо '+S.attemptDate+' · '+S.scopeB.length+' бодлого. A-ийн зассан хариунаас тусдаа оролдлого. A/B нь ойролцоо арга; өргөн сэдвийн эзэмшлийг дангаар батлахгүй.</p>';
 if(!S.sessions.home)html+='<button class="primary" data-act="start-home">B ажлыг эхлэх</button>';else html+=renderQuestion('home');html+='</section>';
 if(S.sessions.home?.submitted&&['class','makeup'].includes(S.route)){const m=S.material;html+='<section class="panel"><h3>Дэвтрийн материал · загвар</h3><p>Дунджаар 5 фото гэж үзсэн виртуал багц. Файл унших, зураг → PDF шахах, хадгалах, интернэтээр илгээх үйлдэл хийхгүй.</p><div class="photos">'+[1,2,3,4,5].map(i=>'<div class="photo">Жишээ хуудас '+i+'</div>').join('')+'</div><div class="chips" style="margin:12px 0">'+badge(m?'v'+m.version+' · '+m.status:'Материал илгээгээгүй',m?.status==='буцаасан'?'warn':'')+badge(S.route==='makeup'?'MAKEUP · тусдаа зориулалт':'HOMEWORK · тусдаа зориулалт')+'</div><button data-act="material">'+(m?'Шинэ v'+(m.version+1)+' материалаар дахин илгээх · загвар':'5 хуудасны материал илгээх · загвар')+'</button>'+(S.teacher?'<p>Багшийн үнэлгээ: '+S.teacher.solved+'/'+S.scopeB.length+' · '+Math.round(100*S.teacher.solved/S.scopeB.length)+'% хийсэн. Автомат зөв/буруугийн дүн биш.</p>':'<p>Багш хараахан шалгаагүй.</p>')+'</section>';}
 return html;}
function hasEntryCorrection(r){return [S.entryCorrections[r.questionId],...(S.entryCorrectionHistory||[])].filter(Boolean).some(c=>c.attemptId===r.attemptId);}
function priorities(){const p={};for(const r of allRecords()){if(hasEntryCorrection(r))continue;const q=Q[r.questionId];if(r.correct===false||r.correct===true&&(r.confidence==='guess'||r.confidence==='unsure'||r.help==='yes'))for(const t of q.tags)p[t]=(p[t]||0)+(r.correct===false?2:1);}return p;}
function buildProposal(){const c=S.reviewConfig,p=priorities();let candidates=DATA.questions.filter(q=>q.testNumber===S.test);if(c.mode==='new'){const reserved=new Set(Object.values(S.sessions).flatMap(se=>se.ids));if(S.route!=='review'&&!S.sessions.home?.submitted)S.scopeB.forEach(id=>reserved.add(id));candidates=candidates.filter(q=>!S.exposed[q.sourceId]&&!reserved.has(q.sourceId));}else if(c.mode==='errors'){const ids=new Set(allRecords().filter(r=>r.correct===false&&!hasEntryCorrection(r)).map(r=>r.questionId));candidates=candidates.filter(q=>ids.has(q.sourceId));}else{candidates=S.scopeA.map(id=>Q[id]);}
 if(c.foundation&&S.test===9)candidates=candidates.concat(DATA.questions.filter(q=>q.testNumber===5&&q.kind==='generated'&&!S.exposed[q.sourceId]));
 candidates.sort((a,b)=>{const pa=a.tags.reduce((s,t)=>s+(p[t]||0),0),pb=b.tags.reduce((s,t)=>s+(p[t]||0),0);return pb-pa||(a.kind==='book'?-1:1)-(b.kind==='book'?-1:1)||a.number-b.number;});let chosen=[],minutes=0;
 for(const q of candidates){if(c.count>0){if(chosen.length>=c.count)break;}else if(minutes+q.minutes>c.budget)continue;chosen.push(q.sourceId);minutes+=q.minutes;}
 S.proposal={ids:chosen,minutes,available:candidates.length,mode:c.mode,created:now(),priorities:p,requestedCount:c.count,budget:c.budget};event('review_proposed',{ids:chosen,minutes,available:candidates.length,config:{...c}});render();}
function review(){if(S.sessions.review&&!S.sessions.review.submitted)return '<section class="panel">'+renderQuestion('review')+'</section>';let html='<section class="panel"><h2>Дараа нь юуг, яагаад давтах вэ?</h2><p>Алдаатай, эргэлзсэн, таасан, тусламжтай бодсон аргыг давтах санал гаргана. Энэ бол турших дүрэм; сурсан түвшний магадлал, машин сургалтын батлагдсан загвар биш.</p><div class="control-grid"><div class="field"><label>Багцын төрөл</label><select data-review="mode">'+opts({new:'Шинэ нөхцөлтэй багц',errors:'Миний анхны алдаа',old:'Хуучин A тестээ дахин бодох'},S.reviewConfig.mode)+'</select></div><div class="field"><label>Хугацааны зорилт</label><select data-review="budget">'+opts({10:'Арван минут',30:'Гучин минут',60:'Жаран минут'},String(S.reviewConfig.budget))+'</select></div><div class="field"><label>Эсвэл бодлогын тоо · хугацаа зөөлөн</label><select data-review="count">'+opts({0:'Хугацаагаар багтаах',3:'Гурван бодлого',5:'Таван бодлого',10:'Арван бодлого',20:'Хорин бодлого',40:'Дөчин бодлого'},String(S.reviewConfig.count))+'</select></div></div>'+(S.test===9?'<p><label><input type="checkbox" data-review="foundation" '+(S.reviewConfig.foundation?'checked':'')+'>Квадратын суурь руу буцахыг би зөвшөөрнө · Тест 5-ийн шинэ жишээ</label></p>':'')+'<div class="actions" style="margin-top:15px"><button class="primary" data-act="propose">Багц санал болгох</button></div><details class="quiet-details"><summary>Саналын тооцооны тайлбар</summary><div class="note blue">Эх номын тестийн хугацааг хүүхдийн нэг бодлого бодох хурд болгож хуваагаагүй. Энд нэг жишээний 3–7 минут нь багштай тулгах анхны тооцоо. Бүртгэлийн хурд нь бодох хурд биш.</div></details>';
 const p=S.proposal;if(p){html+='<div class="card"><h3>Санал: '+p.ids.length+' бодлого · ойролцоогоор '+p.minutes+' минут</h3><p>Сонгож болох сан: '+p.available+' · хүсэлт: '+(p.requestedCount?p.requestedCount+' бодлого':p.budget+' минут')+'</p>'+(!p.requestedCount&&p.available===p.ids.length&&p.minutes<p.budget?'<div class="note warn">Тохирох сангийн бүх бодлого багцад орлоо. Сонгосон хугацаанаас богино багц; илүү олон бодлого нэмэхийн тулд хүрээг зориуд өргөжүүлнэ.</div>':'')+(p.requestedCount>p.ids.length?'<div class="note warn">Хүссэн тоонд хүрэх бодлого хүрэлцэхгүй. Хүрээг далдуур өөрчлөхгүй; богино багц эсвэл илүү өргөн сэдвийг зориуд сонгоно.</div>':'')+(!p.ids.length?'<div class="empty">Тохирох бодлого олдсонгүй. Алдааны сан хоосон эсвэл хараагүй бодлого дууссан байж болно. Өмнөх тестээ давтах эсвэл хүрээг өөрөө өөрчилнө.</div>':'')+'<details class="quiet-details"><summary>Ямар бодлого, яагаад сонгов?</summary><ol class="review-plan">'+p.ids.map(id=>{const q=Q[id],tags=q.tags.filter(t=>p.priorities[t]);return '<li><b>'+esc(sourceLabel(q))+'</b> · '+q.minutes+' мин <br><small>'+(tags.length?'Саналын шалтгаан: '+tags.map(t=>DATA.skills[t]).join(', '):'Мэдээлэл бага / аргуудыг шалгаж эхлэх')+' · '+(S.exposed[id]?'Өмнө харсан бодлого':'Энэ замд хараахан хараагүй')+'</small><br><span class="id">'+esc(id)+'</span></li>';}).join('')+'</ol></details><button class="primary" data-act="start-review" '+(!p.ids.length?'disabled':'')+'>Энэ багцыг эхлэх</button></div>';}
 html+='</section>';if(S.sessions.review)html+='<section class="panel">'+renderQuestion('review')+'</section>';return html;}
function skillRows(){const rows=allRecords();return '<div class="scroll"><table><tr><th>Аргын шошго · багш тулгах</th><th>Анхны зөв / хариулсан</th><th>Буруу</th><th>Таасан / тусламжтай</th></tr>'+Object.entries(DATA.skills).map(([tag,title])=>{const rs=rows.filter(r=>Q[r.questionId].tags.includes(tag));return rs.length?'<tr><td>'+esc(title)+'</td><td>'+rs.filter(r=>r.correct===true).length+' / '+rs.filter(r=>r.correct!==null).length+'</td><td>'+rs.filter(r=>r.correct===false).length+'</td><td>'+rs.filter(r=>r.confidence==='guess').length+' / '+rs.filter(r=>r.help==='yes'||r.exposureBefore).length+'</td></tr>':'';}).join('')+'</table></div><p class="scope-note">Нэг бодлого хэд хэдэн шошготой тул мөрийн тоонуудыг хооронд нь нэмж нийт оноо гаргахгүй. Сэдвийн эзэмшлийн хувь биш.</p>';}
function teacherView(){const n=S.scopeB.length;return '<details><summary>Багшийн цонх · виртуал</summary><div class="card"><p>Өөрийн ангийн тухайн өдрийн хүрээ: '+esc(DATA.sets[S.test].title)+' · A '+S.scopeA.length+' / B '+n+'</p><p>Илгээсэн: '+(S.sessions.home?.submitted?'1/1 виртуал сурагч':'0/1 виртуал сурагч')+' · шалгасан: '+(S.teacher?'1/1':'0/1')+'</p><p>Материал: '+(S.material?'v'+S.material.version+' · '+S.material.status:'байхгүй')+'</p><div class="switch"><button data-act="grade-mode" data-value="solved" class="'+(S.gradeMode==='solved'?'chosen':'')+'">Бодсон тоо</button><button data-act="grade-mode" data-value="missing" class="'+(S.gradeMode==='missing'?'chosen':'')+'">Дутуу тоо</button></div><p><label>'+ (S.gradeMode==='solved'?'Бодсон':'Дутуу')+' <input data-grade="true" type="number" min="0" max="'+n+'" value="'+S.gradeCount+'"></label> / '+n+' · <strong id="grade-preview">'+Math.round(100*(S.gradeMode==='solved'?S.gradeCount:n-S.gradeCount)/n)+'%</strong> хийсэн</p><div class="actions"><button data-act="teacher-save" '+(!S.material||S.material.status==='буцаасан'?'disabled':'')+'>Материалын эцсийн үнэлгээ хадгалах</button><button data-act="teacher-return" '+(!S.material?'disabled':'')+'>Уншигдахгүй хуудас · буцаах</button></div><p class="scope-note">Зураг өөрөө үнэндээ илгээгдээгүй. Энэ үнэлгээ нь багшийн ажлын урсгалын загвар; хүүхдийн жинхэнэ хөдөлмөрийг баталгаажуулаагүй.</p></div></details>';}
function parentView(){const a=summary(S.sessions.primary),b=summary(S.sessions.home);return '<details><summary>Эцэг эхийн цонх · виртуал</summary><div class="card"><h3>Тухайн өдрийн харагдац</h3><p>Ирц: '+esc(S.attendance)+' · эх хичээл '+S.lessonDate+'</p>'+(S.route==='makeup'?'<p>Нөхөлт: '+(S.sessions.home?.submitted?'A/B ажлын хариу илгээсэн':'дуусаагүй')+' · нөхсөн огноо '+S.attemptDate+' · багш '+(S.teacher?'шалгасан':'шалгаагүй')+'</p>':'<p>Анги тарсан ойролцоо цаг: '+esc(S.departure)+' · жишээ. Хүүхэд бүрийн яг гарсан цаг гэж тайлбарлахгүй.</p>')+'<p>A: '+a.correct+'/'+a.total+' анхны зөв · '+a.wrong+' буруу · '+a.missing+' хариу дутуу</p><p>B: '+b.correct+'/'+b.total+' анхны зөв · зураг '+(S.material?'v'+S.material.version+' · '+S.material.status+(S.material.status==='буцаасан'?' · засаж дахин илгээх шаардлагатай':''):'илгээгээгүй')+' · багшийн үнэлгээ '+(S.teacher?S.teacher.solved+'/'+S.scopeB.length+' хийсэн':'хүлээгдэж байгаа')+'</p><p>Автомат зөв/буруу, багшийн хийсэн ажлын үнэлгээ хоёр өөр. Багшийн дотоод тэмдэглэл, хувийн мэдээллийн цонх энд байхгүй.</p></div></details>';}
function progress(){let html='<section class="panel"><h2>Миний ахиц</h2><p>Алдаагаа зассан уу? Шинэ жишээг тусламжгүй хийж чадах уу?</p><details class="quiet-details"><summary>Анхны ажил, засвар, арга тус бүрийн мэдээлэл</summary><div class="grid3"><div class="card"><b>1 · Анхны</b><p>Тусламж, итгэл, нөхөж оруулсан эсэхтэй нь хамт.</p></div><div class="card"><b>2 · Засвар</b><p>Зөв болгож зассан нь анхны алдсаныг арилгахгүй. Бодолт үзсэн бол тусламжтай.</p></div><div class="card"><b>3 · Шинэ нөхцөл</b><p>Өмнө хараагүй тоон жишээг өөрөө хийсэн эсэх. Ижил арга тул ойрын шилжилтийн ажиглалт.</p></div></div><div class="scroll"><table><tr><th>Ажил</th><th>Анхны зөв</th><th>Буруу</th><th>Дутуу</th><th>Эх сурвалж</th></tr>'+Object.entries(S.sessions).filter(([k,se])=>se.submitted).map(([k,se])=>{const m=summary(se);return '<tr><td>'+esc({foundation:'Суурийн жишээ',primary:'A анхны',home:'B ажил',review:'Давтлага',probe:'Шинэ тоон нөхцөл',delayed:'Дараах өдөр'}[k]||k)+'</td><td>'+m.correct+'/'+m.total+'</td><td>'+m.wrong+'</td><td>'+m.missing+'</td><td>'+esc(se.origin)+(se.fixture?' · виртуал':'')+'</td></tr>';}).join('')+'</table></div><p>Давтан зөв: '+Object.values(S.retries).flat().filter(r=>r.correct).length+' · үүнээс тусламж/бодолттой: '+Object.values(S.retries).flat().filter(r=>r.correct&&r.assisted).length+' · бүх хувь/зөвийн тоог нэг “эзэмшил” оноо болгон нийлүүлэхгүй.</p><h3>Аргуудын ажиглалт</h3>'+skillRows()+'</details><div class="actions"><button class="primary" data-act="probe">Өмнө хараагүй 3 тоон жишээгээр шалгах</button><button data-act="delayed" '+(!S.sessions.probe?.submitted?'disabled':'')+'>Дараах өдрийг виртуалаар турших</button></div><div class="note warn">Шинэ жишээ бүгд ижил 5 аргын хүрээнд зохиосон. Тусламжгүй зөв хийсэн ч бүх квадрат/өндөр зэргийн тэгшитгэлийг эзэмшсэн гэж нэрлэхгүй. “Дараах өдөр” товч нь цаг алгассан загвар; бодит мартагдал, ахицыг хэмжээгүй.</div>'+teacherView()+parentView()+telemetryView()+'<details><summary>Өөрийн шүүмж, засах санаагаа хадгалах</summary><textarea data-notes="true" aria-label="Туршилтын санал">'+esc(S.notes)+'</textarea><p class="scope-note">Энэ браузерт хадгална. Багшид мэдэгдэл, имэйл илгээхгүй.</p></details><details><summary>Үйлдлийн түүх</summary><ol class="timeline">'+S.events.slice(-35).map(e=>'<li><b>'+esc(e.type)+'</b><small>'+esc(e.virtualDate+' · '+e.time)+' · '+esc(e.session||e.questionId||'')+'</small></li>').join('')+'</ol></details></section>';
 const active=S.sessions.delayed?'delayed':S.sessions.probe?'probe':null;if(active)html+='<section class="panel">'+renderQuestion(active)+'</section>';return html;}
function render(){const epoch=++renderEpoch,renderRun=STORE.active,renderStarted=performance.now();const opened=[...document.querySelectorAll('#main details[open]')].map(el=>el.querySelector(':scope>summary')?.textContent);const focus=document.activeElement;const focusData=focus?.dataset?{...focus.dataset}:null;stopTiming();renderedTarget=null;document.getElementById('route').value=S.route;document.getElementById('test').value=String(S.test);document.getElementById('profile').value=S.profile;document.getElementById('steps').innerHTML=STAGES.map((x,i)=>'<button data-act="stage" data-stage="'+i+'" '+(S.stage===i?'aria-current="step"':'')+'><span>'+(i+1)+'</span>'+x+'</button>').join('');document.getElementById('main').innerHTML=[context,primary,home,review,progress][S.stage]();if(S.warning)document.getElementById('main').insertAdjacentHTML('afterbegin','<div class="note warn"><b>'+S.warning.count+' хариу дутуу байна.</b><div class="actions"><button data-act="submit-missing" data-session="'+S.warning.session+'">Дутуу төлөвийг үлдээгээд дуусгах</button><button data-act="cancel-missing">Буцаад нөхөж оруулах</button></div></div>');for(const el of document.querySelectorAll('#main details'))if(opened.includes(el.querySelector(':scope>summary')?.textContent))el.open=true;typesetNumbers(document.body);save();updateClock();if(!renderedTarget)lastViewKey=null;if(focusData?.act){const selector=Object.entries(focusData).map(([k,v])=>'[data-'+k.replace(/[A-Z]/g,c=>'-'+c.toLowerCase())+'="'+CSS.escape(v)+'"]').join('');const next=document.querySelector(selector);if(next?.getClientRects().length)next.focus({preventScroll:true});}const elapsed=performance.now()-renderStarted;requestAnimationFrame(()=>{if(epoch!==renderEpoch||STORE.active!==renderRun||document.hidden)return;pushInteraction({type:'render',action:'screen_ready',renderMs:elapsed,nextFrameMs:performance.now()-renderStarted,stage:S.stage,levelEvidenceEligible:false});});}
function beginPrimary(){if(S.route==='review'){S.stage=3;render();return;}if(!S.authorized){message('Виртуал эрх хаалттай. Дээрх эрхийн сонголтоор нээгээд үргэлжлүүлнэ.');return;}if(S.route==='weekly'&&S.examWindow!=='open'){message('Шалгалтын цонх '+(S.examWindow==='before'?'хараахан нээгдээгүй.':'хаагдсан.')+' Хариу авахгүй.');return;}if(!S.scopeA.length||!S.scopeB.length){message('A болон B хүрээнд тус бүр дор хаяж нэг бодлого сонгоно.');return;}if(S.route==='makeup'&&!S.theory){message('Нөхөлт эхлэхээс өмнө тухайн өдрийн онолын сануулгыг уншиж тэмдэглэнэ.');return;}S.published=true;if(S.route==='class'){S.paperReady=true;S.scopeA.forEach(id=>S.exposed[id]=true);event('paper_work_modeled',{ids:S.scopeA});}if(!S.sessions.primary){const se=newSession('primary',S.scopeA,S.route==='class'?'paper-backfill':S.route==='makeup'?'makeup-web':S.route==='weekly'?'exam-web':'selfstudy-web');if(S.route==='weekly')se.deadline=Date.now()+DATA.sets[S.test].time*60000;}S.stage=1;event('primary_open');render();}
function recordRetry(id){const q=Q[id],d=retryDraft(id),v=evaluate(q,d);if(v.correct===null){message('Давтан хариу дутуу эсвэл хүчингүй. Хариугаа шалгана уу.');return;}const r={questionId:id,answer:structuredClone(d.answer),...v,recordedAt:now(),virtualDate:S.attemptDate,assisted:!!S.shown[id]||latestFirst(id)?.help==='yes'||d.help==='yes',help:d.help,confidence:d.confidence,type:'mathematical_retry'};(S.retries[id]||(S.retries[id]=[])).push(r);event('retry',{questionId:id,correct:v.correct,assisted:r.assisted});render();}
function chooseProbe(name){if(!S.authorized){message('Виртуал эрх нээгдээгүй.');return;}const used=new Set(Object.values(S.sessions).flatMap(se=>se.ids));const p=priorities();let pool=DATA.questions.filter(q=>q.kind==='generated'&&q.testNumber===S.test&&!S.exposed[q.sourceId]&&!used.has(q.sourceId));pool.sort((a,b)=>b.tags.reduce((n,t)=>n+(p[t]||0),0)-a.tags.reduce((n,t)=>n+(p[t]||0),0));const ids=[];const families=new Set();for(const q of pool){if(families.has(q.family))continue;ids.push(q.sourceId);families.add(q.family);if(ids.length===3)break;}if(!ids.length){message('Хараагүй шинэ тоон жишээ үлдээгүй. Хуучин ажлаа давтах эсвэл хүрээгээ зориуд өргөжүүлнэ.');return;}if(S.sessions[name]){S.sessions['archived_'+name+'_'+S.serial]=S.sessions[name];}if(name==='delayed')S.attemptDate='2026-10-09';newSession(name,ids,name==='delayed'?'virtual-delayed-web':'unseen-near-template-web');S.stage=4;render();message(ids.length+' шинэ тоон нөхцөл. Хамрагдсан арга '+families.size+'; бусад аргыг энэ багц шалгахгүй.');}

document.addEventListener('click',e=>{const b=e.target.closest('[data-act]');if(!b||b.disabled)return;interaction('button',b.dataset.act,b,['choice','retry-choice'].includes(b.dataset.act));},true);
document.addEventListener('click',e=>{const summary=e.target.closest('summary');if(summary)interaction('details',summary.parentElement.open?'close_details':'open_details',summary);},true);
document.addEventListener('change',e=>{const el=e.target;const action=el.dataset.draft||el.dataset.state||el.dataset.review||el.dataset.scope||el.id||'result_selection';interaction('control',action,el);},true);
document.addEventListener('input',e=>{const el=e.target;if(el.dataset.answer||el.dataset.retryAnswer)interaction('answer','answer_edit',el,true);},true);
document.addEventListener('click',e=>{const b=e.target.closest('[data-act]');if(!b||b.disabled)return;const a=b.dataset.act;message();if(a==='pause'){manualPaused=!manualPaused;if(manualPaused)pauseMeter('manual');render();return;}if(a==='stage'){S.stage=Number(b.dataset.stage);S.warning=false;render();return;}if(a==='start-primary')beginPrimary();else if(a==='publish'){if(!S.scopeA.length||!S.scopeB.length){message('A, B хүрээ хоосон байж болохгүй.');return;}S.published=true;event('scope_published');render();}else if(a==='theory'){S.theory=true;event('theory_read');render();}else if(a==='position'){const se=S.sessions[b.dataset.session];if(Number(b.dataset.pos)!==se.pos)commitQuestion(b.dataset.session,se.ids[se.pos]);se.pos=Math.max(0,Math.min(Number(b.dataset.pos),se.ids.length-1));render();const head=document.querySelector('.question-head');if(head&&(head.getBoundingClientRect().top<65||head.getBoundingClientRect().top>innerHeight/2))head.scrollIntoView({block:'start'});}else if(a==='choice'||a==='retry-choice'){draft(a==='choice'?b.dataset.session:'retry',b.dataset.id).answer=b.dataset.value;save();render();}else if(a==='fixture')fixture(b.dataset.session);else if(a==='submit')submit(b.dataset.session);else if(a==='submit-missing')submit(b.dataset.session,true);else if(a==='cancel-missing'){S.warning=false;render();}else if(a==='start-home'){if(!S.authorized){message('Эрх нээгдээгүй.');return;}newSession('home',S.scopeB,S.route==='makeup'?'makeup-home-web':S.route==='online'?'selfstudy-B-web':'homework-web');render();}else if(a==='retry')recordRetry(b.dataset.id);else if(a==='need-help'){const id=b.dataset.id;S.shown[id]=now();(S.retries[id]||(S.retries[id]=[])).push({questionId:id,type:'help_requested',correct:null,outcome:'notdone',assisted:true,recordedAt:now()});event('help_requested',{questionId:id});render();}else if(a==='solution'){S.shown[b.dataset.id]=now();event('solution_open',{questionId:b.dataset.id});render();}else if(a==='entry-correction'){const id=b.dataset.id,d=retryDraft(id),v=evaluate(Q[id],d);if(v.correct===null){message('Бүртгэлийн засварын хариугаа дээрх хэсэгт оруулна.');return;}if(S.entryCorrections[id])(S.entryCorrectionHistory||(S.entryCorrectionHistory=[])).push({questionId:id,...S.entryCorrections[id]});S.entryCorrections[id]={attemptId:b.dataset.attempt,answer:structuredClone(d.answer),recordedAt:now(),selfReported:true,...v};event('entry_correction',{questionId:id,correction:structuredClone(S.entryCorrections[id])});render();}else if(a==='material'){if(S.material)S.materialHistory.push(structuredClone(S.material));S.material={version:(S.material?.version||0)+1,pages:5,status:'илгээсэн',purpose:S.route==='makeup'?'MAKEUP':'HOMEWORK',submittedAt:now()};if(S.teacher){S.teacherHistory.push(S.teacher);S.teacher=null;}event('material_modeled',{version:S.material.version});render();}else if(a==='teacher-return'){S.material.status='буцаасан';if(S.teacher){S.teacherHistory.push(S.teacher);S.teacher=null;}event('material_returned',{reason:'уншигдахгүй хуудас · загвар'});render();}else if(a==='grade-mode'){if(S.gradeMode===b.dataset.value)return;S.gradeCount=S.scopeB.length-S.gradeCount;S.gradeMode=b.dataset.value;save();render();}else if(a==='teacher-save'){const n=S.scopeB.length;if(!Number.isInteger(S.gradeCount)||S.gradeCount<0||S.gradeCount>n){message('Багшийн тоо 0–'+n+' хооронд бүхэл байна.');return;}if(!S.material||S.material.status==='буцаасан')return;S.teacher={solved:S.gradeMode==='solved'?S.gradeCount:n-S.gradeCount,materialVersion:S.material.version,at:now(),synthetic:true};S.material.status='шалгасан';event('teacher_review_modeled',{...S.teacher});render();}else if(a==='propose')buildProposal();else if(a==='start-review'){if(!S.authorized){message('Эрх нээгдээгүй.');return;}if(!S.proposal?.ids.length)return;if(S.sessions.review)S.sessions['archived_review_'+S.serial]=S.sessions.review;newSession('review',S.proposal.ids,'review-web');S.proposal=null;render();}else if(a==='foundation'){if(!S.authorized){message('Эрх нээгдээгүй.');return;}if(!S.sessions.foundation)newSession('foundation',['GEN-5-0-2','GEN-5-1-2','GEN-5-2-2'],'foundation-web');render();}else if(a==='probe')chooseProbe('probe');else if(a==='delayed')chooseProbe('delayed');else if(a==='timeout'){if(S.sessions.primary&&!S.sessions.primary.submitted){S.sessions.primary.deadline=Date.now()-1;submit('primary',true,'timeout-modeled');}}else if(a==='reset'){if(!confirm('Зөвхөн энэ замын виртуал өгөгдлийг шинээр эхлэх үү? Бусад зам хэвээр үлдэнэ.'))return;stopTiming();lastViewKey=null;lastAction=null;manualPaused=false;S=defaultState(S.route,S.test);save();render();}else if(a==='export'){checkpoint();flushSave();const payload={schema:1,exportedAt:now(),scope:'only-isolated-synthetic-prototype',dataVersion:DATA.date,run:S};const blob=new Blob([JSON.stringify(payload,null,2)],{type:'application/json'}),u=URL.createObjectURL(blob),link=document.createElement('a');link.href=u;link.download='pi-quadratic-'+S.test+'-'+S.route+'.json';link.click();setTimeout(()=>URL.revokeObjectURL(u),1000);}});
document.addEventListener('change',e=>{const el=e.target;if(el.id==='route'||el.id==='test'){switchRun(document.getElementById('route').value,Number(document.getElementById('test').value));return;}if(el.id==='profile'){S.profile=el.value;save();return;}if(el.dataset.draft){draft(el.dataset.session,el.dataset.id)[el.dataset.draft]=el.value;save();}else if(el.dataset.scope){if(S.sessions.primary)return;const key=el.dataset.scope==='A'?'scopeA':'scopeB';S[key]=el.checked?[...S[key],el.value].sort((a,b)=>Q[a].number-Q[b].number):S[key].filter(x=>x!==el.value);S.published=false;save();render();}else if(el.dataset.state){S[el.dataset.state]=el.type==='checkbox'?el.checked:el.value;save();render();}else if(el.dataset.review){S.reviewConfig[el.dataset.review]=el.type==='checkbox'?el.checked:['budget','count'].includes(el.dataset.review)?Number(el.value):el.value;S.proposal=null;save();}else if(el.dataset.resultSession){S.sessions[el.dataset.resultSession].resultID=el.value;render();}});
document.addEventListener('input',e=>{const el=e.target;if(el.dataset.answer||el.dataset.retryAnswer){const id=el.dataset.answer||el.dataset.retryAnswer,d=draft(el.dataset.retryAnswer?'retry':el.dataset.session,id);if(el.dataset.blank)d.answer[el.dataset.blank]=el.value;else d.answer=el.value;const preview=document.querySelector('[data-preview="'+id+'"]');if(preview)preview.innerHTML=hasValue(d)?formatAnswer(Q[id],d.answer):'';scheduleSave();}else if(el.dataset.grade){S.gradeCount=Number(el.value);save();const n=S.scopeB.length;document.getElementById('grade-preview').textContent=(Number.isInteger(S.gradeCount)&&S.gradeCount>=0&&S.gradeCount<=n?Math.round(100*(S.gradeMode==='solved'?S.gradeCount:n-S.gradeCount)/n)+'%':'Тоогоо шалгана уу');typesetNumbers(document.getElementById('grade-preview'));}else if(el.dataset.notes){S.notes=el.value;save();}});
function updateClock(){const se=S.sessions.primary,e=document.getElementById('exam-clock');if(!se?.deadline||se.submitted)return;const left=Math.max(0,Math.ceil((se.deadline-Date.now())/1000));if(e)e.innerHTML=tex(textTex(Math.floor(left/60)+':'+String(left%60).padStart(2,'0')));if(left===0){submit('primary',true,'timeout-modeled');}}
setInterval(()=>{updateClock();checkpoint();scheduleSave();},1000);
document.addEventListener('visibilitychange',()=>{if(document.hidden)pauseMeter('hidden');else resumeMeter();});
window.addEventListener('blur',()=>pauseMeter('blur'));window.addEventListener('focus',resumeMeter);
window.addEventListener('pagehide',()=>{pauseMeter('pagehide');flushSave();});

window.PI_LAB={get state(){return S;},get store(){return STORE;},DATA,Q,evaluate,numeric,summary,priorities,buildProposal,chooseProbe,fixture,submit,render,switchRun,defaultState,save,telemetry,checkpoint,measurementSnapshot,tex,typesetNumbers};
render();
