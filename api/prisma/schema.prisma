generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ============ Хэрэглэгчид ============

enum Role {
  ADMIN
  TEACHER_PLUS
  TEACHER
  STUDENT
  PARENT
  BUYER
}

enum StudentType {
  CLASSROOM // танхимын сурагч
  ONLINE
}

model User {
  id                 String    @id @default(cuid())
  // Нэвтрэх түлхүүрүүд: утас, имэйл (gmail), эсвэл username — аль нэгээр нэвтэрнэ.
  // Утсыг сонголттой болгосон тул зөвхөн имэйлээр ч бүртгүүлж болно.
  phone              String?   @unique
  email              String?   @unique
  username           String?   @unique // нийтэд харагдах нэр (овог нэр эсвэл өөрийн nickname)
  studentCode        String?   @unique // сурагчийн дотоод код (дугаараас тусдаа)
  teacherCode        String?   @unique // багшийн дотоод код (дугаараас тусдаа)
  firstName          String
  lastName           String
  passwordHash       String
  // Дараагийн нэвтрэлтээр нууц үг СОЛИУЛАХ шаардлагатай эсэх. Одоогоор ХААЛТТАЙ
  // (@default(false)) — эзэн байнга турших тул саад болохгүй. Ирээдүйд идэвхжүүлэхэд
  // энэ талбарыг create үед true болгоод/эсвэл эндхийн default-ыг true болговол хангалттай.
  mustChangePassword Boolean   @default(false)
  // Нууц үг ХАМГИЙН СҮҮЛД солигдсон мөч. JwtStrategy энэ мөчийг токены `iat`-тай
  // харьцуулж, түүнээс ӨМНӨ олгогдсон бүх токеныг хүчингүйд тооцно. Ингэснээр
  // нууц үгээ сэргээхэд хулгайлагдсан сесс автоматаар тасарна — сэргээлтийн
  // гол утга учир нь энэ (эс бөгөөс халдагч хуучин токеноороо орсоор байна).
  termsAcceptedAt    DateTime?
  privacyVersion     String?
  guardianConsentAt  DateTime?
  passwordChangedAt  DateTime?
  role               Role
  avatarUrl          String?
  // Сайтад хамгийн сүүлд орсон мөч (эзэн 2026-10-13). JwtStrategy 5 минут
  // тутамд нэг л удаа raw UPDATE-аар шинэчилнэ — updatedAt-ыг хөндөхгүй.
  lastSeenAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  formulaReviews         FormulaReview[]
  formulaReviewDays       FormulaReviewDay[]
  formulaReviewAttempts   FormulaReviewAttempt[]

  staffCapabilities      StaffCapabilityGrant[]
  feedback               Feedback[]
  studentProfile         StudentProfile?
  mockRegistrations      MockExamRegistration[]
  teacherProfile         TeacherProfile?
  externalTeacherProfile ExternalTeacherProfile?

  parentLinks             ParentLink[]         @relation("ParentSide")
  childLinks              ParentLink[]         @relation("ChildSide")
  teacherGroups           TeacherGroup[]       @relation("TeacherGroupOwner")
  teacherGroupMemberships TeacherGroupMember[]
  payments                Payment[]
  userPasses              UserPass[]
  attempts                Attempt[]
  mistakeEntries          MistakeEntry[]
  attendances             Attendance[]         @relation("AttendanceStudent")
  submissions             Submission[]
  dailyHomeworkMarks      DailyHomeworkMark[]  @relation("DailyHomeworkMarkStudent")
  testResults             TestResult[]
  testDrafts              TestDraft[]
  predictions             Prediction[]
  colorTags               StudentColorTag[]    @relation("TaggedStudent")
  ownedClassrooms         Classroom[]          @relation("ClassroomTeacher")
  assistedClassrooms      Classroom[]          @relation("ClassroomAssistantTeacher")
  enrollments             Enrollment[]
  attemptSessions         TestAttemptSession[]
  learningEvents          LearningEvent[]
  studyReviewRuns         StudyReviewRun[]
  studyReviewResponses    StudyReviewResponse[]

  // Wave 3: ажилтны төлөвлөгч / хуваарь / сурагчийн зорилго / стрийк
  createdStaffTasks     StaffTask[]
  staffTaskAssignments  StaffTaskAssignee[]
  taughtSchedules       ClassSchedule[]
  studentGoals          StudentGoal[]
  streakFreezes         StreakFreeze[]
  teacherWorkDays       TeacherWorkDay[]       @relation("TeacherWorkDayTeacher")
  teacherWorkExceptions TeacherWorkException[] @relation("TeacherWorkExceptionTeacher")

  // Эцсийн долгион: сурагчийн тэмдэглэл
  studentNotes StudentNote[]

  // Төлбөрийн буцаалт — эзэмшлийн гурван шуу: сурагч + үүсгэгч + баталгаажуулагч
  tuitionRefundsAsStudent TuitionRefund[] @relation("StudentTuitionRefunds")
  createdTuitionRefunds   TuitionRefund[] @relation("TuitionRefundCreatedBy")
  approvedTuitionRefunds  TuitionRefund[] @relation("TuitionRefundApprovedBy")
  paidTuitionRefunds      TuitionRefund[] @relation("TuitionRefundPaidBy")
  cancelledTuitionRefunds TuitionRefund[] @relation("TuitionRefundCancelledBy")

  // Худалдан авалтууд
  purchases Purchase[]

  passwordResetTokens PasswordResetToken[]

  // Google-ээр нэвтрэх (20260908_add_google_identity_auth). Нэг хэрэглэгч ↔ нэг
  // Google бүртгэл. Шинэ бүртгэл Google-ээр ҮҮСГЭХГҮЙ — зөвхөн холбосон хүн нэвтэрнэ.
  googleIdentity       GoogleIdentity?
  googleOAuthStates    GoogleOAuthState[]
  googleLoginExchanges GoogleLoginExchange[]

  // Secure schedule calendar feed tokens (G39). Only a one-way token hash is stored.
  calendarTokenHash    String?         @unique
  calendarTokenVersion Int?
  notifications        Notification[]
  notificationPreference NotificationPreference?
  notificationDeliveries NotificationDelivery[]

  // SMS: бүртгэл, загвар, батч
  smsMessagesAsRecipient SmsMessage[]      @relation("SmsMessageRecipient")
  smsMessagesAsCreator   SmsMessage[]      @relation("SmsMessageCreatedBy")
  smsBatches             SmsBatch[]        @relation("SmsBatchCreatedBy")
  smsTemplates           SmsTemplate[]     @relation("SmsTemplateCreatedBy")

  // Банкны гүйлгээ тулгалт + эцэг эхийн танилцуулга + имэйл OTP (2026-08-08)
  bankTransactionsMatched  BankTransaction[]       @relation("BankTxMatchedUser")
  bankTransactionsImported BankTransaction[]       @relation("BankTxImportedBy")
  resultAcknowledgements   ResultAcknowledgement[]
  emailOtps                EmailOtp[]

  // Архивласан сурагчийн түүхийг хадгална; үйлдлийг auditLog давхар мөрдөнө.
  archivedAt    DateTime?
  archivedById  String?
  archiveReason String?

  // 1000 бодлогын шалгалтын эргэн харалтыг гараар нээсэн ажилтан
  testAccessesReviewOpened TestAccess[] @relation("TestAccessReviewOpenedBy")

  // Шалгалтын бодлого/алхам бүрийн зөв-буруу ба ирээгүй тэмдэглэгээ (сурагч талаас)
  testItemMarks TestItemMark[] @relation("TestItemMarkStudent")
  testAbsences  TestAbsence[]  @relation("TestAbsenceStudent")

  @@index([archivedAt])
}

// ============ Нууц үг сэргээлт ============

enum NotifyChannel {
  SMS
  EMAIL
}

// ============ SMS Бүртгэл & Шалгалт (SMS Logging & Audit) ============

/**
 * SMS илгээлтийн статус — хүсэлтийг системэд хүлээлгэе (QUEUED), илгээлээ (SENT),
 * алдаа байлаа (FAILED), эсвэл цуцалсан (CANCELLED).
 */
enum SmsStatus {
  QUEUED
  SENT
  FAILED
  CANCELLED
}

/**
 * SMS мессежийн төрөл — юугаар илгээснийг ангилна, ингэснээр:
 * • Ирээдүйд загвар (SmsTemplate)-аар дахин ашиглах
 * • Сурагч/эзэн өөр өөр төрлийг дахиулах давтамжаа сонгох
 * • Аналитик: "нууц үг сэргээлтийн SMS хэдий хэмжээний хариу авсан"
 */
enum SmsKind {
  PASSWORD_RESET
  ANNOUNCEMENT
  PAYMENT_REMINDER
  ATTENDANCE
  EXAM
  MANUAL
  OTHER
}

/**
 * Бөөн SMS илгээлтийн статус — DRAFT үед сурагчдыг сонгож байж болно,
 * SENDING үед горим идэвхтэй (цуцлах боломжтой), DONE үед дууссан.
 */
enum SmsBatchStatus {
  DRAFT
  SENDING
  DONE
  CANCELLED
}

/**
 * Нэг удаагийн нууц үг сэргээх код.
 * ЯАГААД КОДЫГ ЭНД ХАДГАЛААГҮЙ ВЭ: `codeHash` нь серверийн нууц түлхүүрээр
 * (RESET_TOKEN_SECRET) хийсэн HMAC-SHA256. Ингэснээр өгөгдлийн сан бүхэлдээ
 * алдагдсан ч тэр түлхүүргүйгээр 6 оронтой кодыг сэргээж БОЛОХГҮЙ. Энгийн
 * SHA-256 бол 6 оронтой код дээр сая хүрэхгүй хувилбартай тул шууд эвдэгдэнэ.
 * `attempts` нь буруу оролдлогыг тоолж, тодорхой тооноос хэтэрвэл кодыг үхүүлнэ
 * (брутфорсоос хамгаална). `consumedAt` нь нэг удаагийн байдлыг баталгаажуулна.
 */
model PasswordResetToken {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash     String
  channel      NotifyChannel @default(SMS)
  /// Хаана илгээснийг харуулах МАСКЛАСАН хаяг (жишээ нь "8033****"). Бүтэн
  /// дугаарыг энд давхардуулж хадгалахгүй — User дээр аль хэдийн байгаа.
  sentToMasked String
  expiresAt    DateTime
  consumedAt   DateTime?
  attempts     Int           @default(0)
  /// Хүсэлт ирсэн IP — хэт олон хүсэлтийг мөрдөх, аудитад ашиглана.
  requestIp    String?
  createdAt    DateTime      @default(now())

  // Хэрэглэгчийн хамгийн сүүлийн идэвхтэй кодыг олох, мөн цонхон доторх
  // хүсэлтийн тоог тоолоход хоёуланд нь энэ индекс ажиллана.
  @@index([userId, createdAt])
  @@index([expiresAt])
}

/**
 * SMS мессежийн бүртгэл — илгээсэн бүр мессеж бүртгэлийн ленте ходолдна.
 * НУУЦЛАЛ: PASSWORD_RESET төрлийн мессежийн body дээр код БАЙХГҮЙ.
 * Зөвхөн "код илгээсэн" гэсэн үйл явдлыг бүртгэнэ, кодыг хадгалахгүй.
 * Ингэснээр нууцлалын эрсдэл бага байна — өгөгдлийн сан ялгарсан ч
 * хүмүүсийн нууц үгийн код яг сүүлийн үеийн байхгүй болно.
 */
model SmsMessage {
  id          String        @id @default(cuid())
  toPhone     String
  body        String
  status      SmsStatus
  kind        SmsKind
  userId      String?
  user        User?         @relation("SmsMessageRecipient", fields: [userId], references: [id], onDelete: SetNull)
  batchId     String?
  batch       SmsBatch?     @relation(fields: [batchId], references: [id], onDelete: SetNull)
  templateId  String?
  template    SmsTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  provider    String? // console | twilio | http
  providerRef String? // нийлүүлэгчийн месседжийн ID
  error       String? // амжилтгүй болсон шалтгаан
  segments    Int     @default(1) // SMS хэсгийн тоо (1 SMS = 160 символ)
  createdById String
  createdBy   User    @relation("SmsMessageCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  sentAt      DateTime?

  @@index([toPhone])
  @@index([status])
  @@index([batchId])
  @@index([createdAt])
}

/**
 * Бөөн SMS илгээлт — админ эсвэл багш+ дурын ангийн сурагчдад нэгэлгээр
 * мессеж илгээхдээ "батч" үүсгэнэ.
 */
model SmsBatch {
  id          String         @id @default(cuid())
  title       String
  kind        SmsKind
  total       Int // хэдэн хүнийг сонгосон
  sent        Int            @default(0)
  failed      Int            @default(0)
  status      SmsBatchStatus
  createdById String
  createdBy   User           @relation("SmsBatchCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime       @default(now())
  finishedAt  DateTime?

  messages    SmsMessage[]
}

/**
 * SMS загвар — {{name}}, {{amount}} зэрэг орлуулагчтай дахин ашиглах
 * мессежүүд. Админ/Багш+ нь сэтгэл ханамжтай загвар үүсгээд
 * мөн мөн иллүүлэхэд ашигладаг.
 */
model SmsTemplate {
  id          String    @id @default(cuid())
  name        String    @unique
  kind        SmsKind
  body        String // {{name}}, {{amount}} гэх мэт орлуулагчтай байж болно
  active      Boolean   @default(true)
  createdById String
  createdBy   User      @relation("SmsTemplateCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  messages    SmsMessage[]
}

// Жилийн төлбөрийн багц: Excel-ийн бүртгэлд байдаг төлбөрийн нөхцөл.
// UNKNOWN = хуучин импортоос орж ирсэн, төлбөрийн нөхцөл нь бүртгэлд
// тэмдэглэгдээгүй сурагч (дараа нь багш/багш+ гараар тодруулна).
enum TuitionPlan {
  FULL_YEAR
  INSTALLMENT
  MONTHLY
  UNKNOWN
}

model StudentProfile {
  userId         String      @id
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           StudentType
  grade          Int? // 1–12, бүртгүүлэхдээ сонгоно
  school         String?
  // Танхимын сурагч идэвхжүүлэх код (= тухайн өдрийн огноо) оруулсан эсэх
  activatedAt    DateTime?
  activationCode String?

  // Excel-ийн бүртгэлээс ирсэн бодит мэдээлэл (импортоор type/grade/school-оос
  // цааш алдагдаж байсан дата) — гэр бүлийн холбоо барих, байршил, төлбөр.
  fatherPhone   String?
  motherPhone   String?
  guardianNote  String?
  branch        String? // "Баруун 4" | "Зүүн 4"
  section       String? // "12-2" — бүртгэлд тэмдэглэсэн ангийн шошго (label)
  tuitionAmount Int?
  tuitionPlan   TuitionPlan?
  tuitionNote   String?
  joinedOn      DateTime?    @db.Date
  leftOn        DateTime?    @db.Date

  // Онлайнаар ТАНХИМЫН ангид бүртгүүлсэн сурагчийн зөвшөөрлийн урсгал
  // (эзний дүрэм 2026-08-08): багш зөвшөөрөх + эхний сарын төлбөр CONFIRMED
  // («суудал баталгаажуулалт») хоёул биелмэгц сурагчийн код үүснэ.
  // Багш гараар бүртгэсэн бол энэ урсгал алгасагдана (approvalPending=false).
  approvalPending Boolean   @default(false)
  approvedAt      DateTime?
  approvedById    String?

  @@index([branch])
  @@index([section])
  @@index([approvalPending])
}

model TeacherProfile {
  userId            String  @id
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Админ олгодог эрх: сурагч нэмэх/хасах/анги солих (зөвхөн TEACHER_PLUS-д утгатай)
  canManageStudents Boolean @default(false)
  // Хуваарьт багш болж оногддог эсэх (эзэн 2026-10-08): удирдлагын ажилтан,
  // туршилтын бүртгэл false — өдрийн хуваарийн багшийн жагсаалтад гарахгүй.
  teachesLessons    Boolean @default(true)
}

// Гадны багш (манай төвийн бус). Баталгаажаагүй багш сурагчийн мэдээлэл ХАРАХГҮЙ.
model ExternalTeacherProfile {
  userId       String    @id
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization String? // ажилладаг сургууль/төв
  verifiedAt   DateTime? // админ баталгаажуулсан эсэх
  verifiedById String? // ADMIN эсвэл TEACHER_PLUS-ийн ID
  note         String? // админ тайлбар

  @@index([verifiedAt])
}

model ParentLink {
  id           String    @id @default(cuid())
  parentId     String
  parent       User      @relation("ParentSide", fields: [parentId], references: [id], onDelete: Cascade)
  studentId    String
  student      User      @relation("ChildSide", fields: [studentId], references: [id], onDelete: Cascade)
  // Багш+/Админ баталгаажуулсан эсэх
  verifiedAt   DateTime?
  verifiedById String?

  @@unique([parentId, studentId])
}

// ============ Анги ============

enum ClassroomType {
  IN_PERSON
  ONLINE
}

model Classroom {
  id                String        @id @default(cuid())
  name              String
  type              ClassroomType
  grade             Int?
  teacherId         String?
  teacher           User?         @relation("ClassroomTeacher", fields: [teacherId], references: [id])
  // Туслах ангийн багш (эзэн 2026-10-13): анги дээд тал нь ХОЁР ангийн багштай —
  // үндсэн (teacherId) ба туслах. Энгийн Багшийн ангийн эрхэд ижил тооцогдоно
  // (common/class-teachers.ts).
  assistantTeacherId String?
  assistantTeacher   User?        @relation("ClassroomAssistantTeacher", fields: [assistantTeacherId], references: [id])
  // Асуудалтай хүүхдийн шалгуур (эзэн 2026-10-18) — Багш+ тавина, бүх багш хуваалцана:
  // { windowDays, minAttendance, maxAbsences, maxLates, minHomework, missingStreak }; null = анхдагч
  riskCriteria       Json?
  archived          Boolean       @default(false)
  createdAt         DateTime      @default(now())
  // Хөтөлбөрийн түгжээний гараар override (Шийдвэр 5). null = ClassTestSession-ээс
  // автоматаар тооцно; багш гараар урагшлуулж/буцаах бол энд Chapter.id тавина.
  progressChapterId String?
  // Ангийн хичээл (эзэн 2026-10-18): null = MATH (анхдагч). MATH-аас бусад хичээлийн
  // контентыг (ном, бүлэг, тест) зөвхөн тухайн хичээлийн идэвхтэй ангийн сурагч
  // харна; ангитай сурагчийн номын сан өөрийн ангиудын хичээлээр шүүгдэнэ.
  // Төвийн ажилтан бүгдийг харна (common/access.ts — catalogSubjectsFor).
  subject           Subject?

  enrollments         Enrollment[]
  attendances         Attendance[]
  assignments         Assignment[]
  testAccess          TestAccess[]
  dailySummaries      DailyClassSummary[]
  announcementTargets AnnouncementClassroomTarget[]
  dailyHomeworkMarks  DailyHomeworkMark[]

  // Wave 3: ажилтны төлөвлөгч / хичээлийн хуваарь
  staffTasks     StaffTask[]
  classSchedules ClassSchedule[]
  calendarDayLinks AcademicCalendarDayClassroom[]

  // Түнш хөрөнгө — ТӨВИЙН ангийн буцаалт
  tuitionRefunds TuitionRefund[]
  dismissals     ClassDismissal[]
  lessonPackets  LessonPacket[]
  lessonRotation LessonRotation?

  @@index([assistantTeacherId])
}

// ============ Гадны багшийн анги ============

model TeacherGroup {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation("TeacherGroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  joinCode  String   @unique // сурагч кодоор нэгдэнэ
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())

  members TeacherGroupMember[]

  @@index([ownerId, archived])
}

model TeacherGroupMember {
  id        String       @id @default(cuid())
  groupId   String
  group     TeacherGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  studentId String
  student   User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  joinedAt  DateTime     @default(now())
  leftAt    DateTime?

  @@unique([groupId, studentId])
  @@index([studentId])
}

model Enrollment {
  id          String    @id @default(cuid())
  studentId   String
  student     User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  // Орсон өдрөөс хойшхи мэдээлэл л сурагчид харагдана; анги солиход leftAt бөглөгдөж шинэ бичилт үүснэ
  joinedAt    DateTime  @default(now())
  leftAt      DateTime?
  movedById   String?

  @@index([studentId, leftAt])
  @@index([classroomId, leftAt])
}

// ============ Ирц ============

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

// Хоцролтын хугацааны интервал (зөвхөн status=LATE үед утгатай).
// Багш ангийн өмнө зогсоод хурдан сонгох тул сонголтууд цөөхөн, тодорхой.
enum LateRange {
  FIVE_TO_TEN // 5–10 минут
  TEN_TO_THIRTY // 10–30 минут
  THIRTY_TO_SIXTY // 30 минут – 1 цаг
  OVER_ONE_HOUR // 1 цагаас дээш
}

model Attendance {
  id          String           @id @default(cuid())
  classroomId String
  classroom   Classroom        @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  studentId   String
  student     User             @relation("AttendanceStudent", fields: [studentId], references: [id], onDelete: Cascade)
  date        DateTime         @db.Date
  status      AttendanceStatus
  markedById  String
  // Сурагч тус бүрийн өдрийн тайлбар (ж: "Өвчтэй", "Гэрээсээ хожуу гарсан")
  note        String?
  // Хэдий хугацаагаар хоцорсон (зөвхөн status=LATE үед; бусад бүх статуст
  // NULL байх ёстой — mark() service дотор status LATE-ээс өөр болоход
  // автоматаар цэвэрлэгдэнэ). Чөлөөт тайлбар `note`-оос ялгаатайгаар
  // queryable, тайлагдах боломжтой бүтэцтэй утга учир тусдаа enum багана.
  lateRange   LateRange?

  @@unique([classroomId, studentId, date])
  @@index([studentId, date])
}

// ============ Даалгавар ============

enum AssignmentType {
  DAILY
  EXTRA
}

enum SubmissionState {
  NOT_DONE
  SUBMITTED // сурагч илгээсэн, багш хараагүй
  DONE_ONLINE // багш онлайнаар баталгаажуулсан
  DONE_IN_CLASS // багш ангид дэвтрийг биетээр шалгасан
  RETURNED // буцаасан — дахин илгээнэ
}

model Assignment {
  id          String         @id @default(cuid())
  classroomId String
  classroom   Classroom      @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  type        AssignmentType @default(DAILY)
  title       String
  description String?
  imageKeys   String[] // S3 түлхүүрүүд
  dueDate     DateTime?
  createdById String
  createdAt   DateTime       @default(now())
  // Даалгавар ӨГСӨН хичээлийн өдөр (эзэн 2026-10-27): сурагч сэдэв сонгохгүй,
  // «10-р сарын 26 — Сэдэв» шошгыг анги + энэ өдрийн төлөвлөгөөнөөс угсарна.
  // null = 2026-10-27-оос өмнөх мөр → createdAt-ийн УБ өдрөөр тооцно.
  lessonDate  DateTime?      @db.Date

  // Зөөлөн устгал: hard DELETE хийвэл Submission-ы түүхэн бичлэгүүд орфон
  // үлдэнэ. Уншихдаа заавал deletedAt: null гэж шүүнэ.
  deletedAt DateTime?

  submissions Submission[]

  @@index([deletedAt])
  @@index([classroomId, lessonDate])
}

model Submission {
  id           String          @id @default(cuid())
  assignmentId String
  assignment   Assignment      @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      User            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  state        SubmissionState @default(NOT_DONE)
  imageKeys    String[]
  note         String? // legacy: author may be ambiguous
  studentNote  String?
  reviewNote   String? // pupil-visible teacher feedback only
  revisions    SubmissionRevision[]
  checkedById  String?
  submittedAt  DateTime?
  checkedAt    DateTime?
  updatedAt    DateTime        @updatedAt

  @@unique([assignmentId, studentId])
  @@index([studentId])
}

// Durable snapshots retain original student evidence and visible teacher feedback.
model SubmissionRevision {
  id           String          @id @default(cuid())
  submissionId String
  submission   Submission      @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  action       String
  actorId      String
  state        SubmissionState
  studentNote  String?
  reviewNote   String?
  legacyNote   String?
  imageKeys    String[]
  at           DateTime        @default(now())

  @@index([submissionId, at])
}

// ============ Өдөр тутмын гэрийн даалгаврын тэмдэглэгээ (Daily Homework Marking) ============
// Эзний #1 хүсэлт: багш ангийнхаа гэрийн даалгаврыг өдөр бүр НЭГ ХУРДАН
// тороор (grid) тэмдэглэдэг байх ёстой — Assignment/Submission-ы "багш
// даалгавар үүсгээд сурагч илгээх" урсгалаас ЯЛГААТАЙ, "багш л ангиа хурдан
// нэг өнгөөр дүгнэнэ" гэсэн энгийн урсгал. Тиймээс Submission.state-ийг
// contort хийхгүй (өөр дэлгэцүүд үүнийг ашигладаг), харин тусдаа энгийн
// хүснэгт нэмэв: анги+сурагч+өдөр бүрийн НЭГ тэмдэглэгээ (өнгө + чөлөөт
// тайлбар). Мөр байхгүй бол "тэмдэглээгүй" (цагаан/хоосон, багш хараахан
// дүгнээгүй) — status null-ийг зөвшөөрнө.
enum HomeworkMarkStatus {
  DONE // хийсэн — ногоон
  PARTIAL // дутуу — шар
  NOT_DONE // хийгээгүй — улаан
}

model DailyHomeworkMark {
  id          String              @id @default(cuid())
  classroomId String
  classroom   Classroom           @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  studentId   String
  student     User                @relation("DailyHomeworkMarkStudent", fields: [studentId], references: [id], onDelete: Cascade)
  date        DateTime            @db.Date
  // null = багш хараахан тэмдэглээгүй (өгөгдмөл, цагаан харагдана)
  status      HomeworkMarkStatus?
  comment     String?
  markedById  String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([classroomId, studentId, date])
  @@index([classroomId, date])
  @@index([studentId, date])
}

// ============ Контент: Ном → Бүлэг сэдэв → Бодлого ============

// Хичээлийн төрөл — төв Математикаас гадна Нийгэм судлал, SAT мөн заадаг болсон.
// Enum-ыг Book дээр л тавьсан (тусдаа Subject модель биш): Chapter/Test/Topic-ийн
// хичээл нь Book-оор дамжин л тодорхойлогдоно (энэ migration-д тэдгээрт нэмэхгүй).
// SAT: одоогоор ЗӨВХӨН танхимд, бат бэх болоогүй тул EnrollmentWindow-д
// COMING_SOON статустай эхэлнэ (доор харна уу).
enum Subject {
  MATH
  SOCIAL_STUDIES
  SAT
}

model Book {
  id          String  @id @default(cuid())
  code        String  @unique // нийтэд харагдах цэвэр код: "100", "200", "300", "1000"
  title       String // нийтэд харагдах цэвэр нэр: "100x100"
  coverKey    String?
  // Жинхэнэ эх фолдер (админд мөрдөгдөх): UI-д "100x100" гэж харагдах ч дата нь
  // "100x100 V2" фолдероос ирснийг тэмдэглэнэ. ProblemAnalysis.sourcePath-тай уялдана.
  sourceLabel String?
  // Хуучин (V2 биш) шилжүүлсэн ном — каталогт харагдахгүй, харин дата нь хэвээр.
  archived    Boolean @default(false)
  // Аль хичээлд хамаарах вэ. Одоо байгаа ~6000 мөр Математик тул @default(MATH)
  // автоматаар бөглөнө.
  subject     Subject @default(MATH)

  // Зөөлөн устгал (soft delete): Attempt/TestResult зэрэг түүхэн бичлэгийг
  // орфон үлдээхгүйн тулд hard DELETE хийхгүй. Уншихдаа заавал deletedAt: null
  // гэж шүүнэ.
  deletedAt DateTime?

  // Сурагчид харагдах нэр/дараалал (2026-10-29 эзний шийдвэр 6): «Е-1», «Е-2» ...
  // title нь дотоод/импортын нэр хэвээр; сурагчид displayName ?? title харагдана.
  displayName   String?
  displayOrder  Int?
  // true бол сурагчийн каталог/номын сангаас нуугдана (V2 давхардал, LAB, тест ном)
  studentHidden Boolean @default(false)

  chapters Chapter[]

  @@index([archived])
  @@index([subject])
  @@index([deletedAt])
  @@index([studentHidden, displayOrder])
}

model Chapter {
  id          String  @id @default(cuid())
  bookId      String?
  book        Book?   @relation(fields: [bookId], references: [id])
  title       String
  order       Int
  grade       Int? // аль ангийн хүүхдэд харагдах вэ
  // Нийтэд үнэгүй preview эсэх (эхний онол + эхний тест)
  freePreview Boolean @default(false)
  // БҮТ-ийн үндсэн сэдвийн муж (админ засварладаг, Шийдвэр 5)
  topicId     String?
  topic       Topic?  @relation(fields: [topicId], references: [id])

  // Зөөлөн устгал: hard DELETE хийвэл Attempt/TestResult зэрэг түүхэн
  // бичлэгүүд орфон үлдэнэ. Уншихдаа заавал deletedAt: null гэж шүүнэ.
  deletedAt DateTime?

  problems Problem[]
  theories TheoryBlock[]
  lessonPackets LessonPacket[]
  videos   Video[]
  tests    Test[]

  @@index([grade, order])
  @@index([topicId])
  @@index([deletedAt])
}

// БҮТ-ийн үндсэн агуулгын муж (Тоо тоолол, Алгебр, Функц, Геометр, Магадлал...).
// Админ засварладаг жагсаалт — код хөндөхгүйгээр нэр/дараалал өөрчлөгдөнө (Шийдвэр 5).
model Topic {
  id    String @id @default(cuid())
  name  String @unique
  order Int    @default(0)

  // Зөөлөн устгал: hard DELETE хийвэл холбогдох Chapter-үүдийн түүхэн дата
  // орфон үлдэнэ. Уншихдаа заавал deletedAt: null гэж шүүнэ.
  deletedAt DateTime?

  chapters Chapter[]

  @@index([deletedAt])
}

model TheoryBlock {
  createdById     String?
  clientRequestId String?
  id          String   @id @default(cuid())
  chapterId   String
  chapter     Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  title       String
  content     String // markdown
  imageKeys   String[]
  order       Int
  freePreview Boolean  @default(false)
  // Retain source text, media references and historical packet identity.
  archivedAt DateTime?
  @@unique([createdById, clientRequestId])
  @@index([chapterId, archivedAt])

}

model Video {
  problemId   String?
  problem     Problem? @relation(fields: [problemId], references: [id], onDelete: Restrict)
  createdById String?
  id        String   @id @default(cuid())
  title     String
  s3Key     String
  duration  Int? // секунд
  chapterId String?
  chapter   Chapter? @relation(fields: [chapterId], references: [id])
  createdAt DateTime @default(now())

  // Зөөлөн устгал: hard DELETE хийвэл холбогдох LearningEvent зэрэг түүхэн
  // лог орфон үлдэнэ. Уншихдаа заавал deletedAt: null гэж шүүнэ.
  deletedAt DateTime?

  @@index([deletedAt])
  @@index([problemId, deletedAt])
}

enum ProblemFormat {
  CHOICE // сонгох тест (A,B,C,D…)
  FILL_NUMBER // ЭЕШ маягийн тоо нөхөх (a=…, b=…)
  OPEN // задгай хариулт
}

// Сурагч буруу хариу сонгосон бол ЯАГААД сонгосон шалтгааны төрөл.
// Энэ нь "энэ хүүхэд ингэж алдсан" гэсэн дата цуглуулахад чухал (SPEC §9).
enum MistakeType {
  NONE // зөв хариу — алдаа биш
  SIGN_ERROR // тэмдэг алдсан (+/−)
  INCOMPLETE_STEP // үйлдэл дутуу хийж зогссон
  CALC_ERROR_NEAR // энгийн нэмэх/хасах алдаа → ойролцоо хариу дугуйлсан
  CONCEPT_GAP // ухагдахуун/арга ойлгоогүйгээс
  UNRELATED_GUESS // огт хамааралгүй хариу → буудсан
  OTHER // бусад (тайлбар бичнэ)
}

// Бодлогын нэг сонголт (A–E). Зөв/буруу эсэх + буруу бол ЯАГААД алдсаныг хадгална.
// Багш/Багш+ гараар нэг бүрчлэн засна (AI автоматаар "баталгаажсан" гэж тэмдэглэхгүй).
model ProblemChoice {
  id          String      @id @default(cuid())
  problemId   String
  problem     Problem     @relation(fields: [problemId], references: [id], onDelete: Cascade)
  label       String // "A".."E" эсвэл "a".."e"
  text        String // сонголтын утга (LaTeX-тэй байж болно)
  isCorrect   Boolean     @default(false)
  mistakeType MistakeType @default(NONE) // буруу бол алдааны төрөл
  mistakeNote String? // багшийн тайлбар: яагаад энэ хариу руу хүрдэг вэ
  imageKey    String? // сонголтын зураг (StoredFile key) — график/зурган хариу
  order       Int

  @@unique([problemId, label])
  @@index([problemId])
  @@index([imageKey])
}

model Problem {
  id            String        @id @default(cuid())
  token         String        @unique // "100-23-05" = ном-хуудас-бодлого
  chapterId     String
  chapter       Chapter       @relation(fields: [chapterId], references: [id])
  page          Int?
  number        Int?
  format        ProblemFormat
  statementText String?
  imageKey      String?
  choices       Json? // CHOICE форматын сонголтууд
  correctAnswer Json // форматаас хамаарсан бүтэцтэй
  points        Int           @default(1)
  price         Int? // дэлгүүрт тусдаа зарагдвал (₮)
  createdById   String
  createdAt     DateTime      @default(now())

  // Датанаас тооцогддог үзүүлэлтүүд — гараар оноохгүй (SPEC §9.3)
  eloRating    Float  @default(1000)
  attemptCount Int    @default(0)
  correctRate  Float?

  // YouTube бодолтын бичлэг (1000 бодлого) — youtube.com/watch, youtu.be, youtube.com/shorts
  youtubeUrl   String?

  // 2-р хэсгийн (FILL_NUMBER) алхмын багц: [{ label: "1-1", boxes: ["a","b"], points: 3 }].
  // Багцын бүх нүд зөв → багцын оноо, нэг нь буруу → 0; 0 оноотой багц тооцогдохгүй.
  // Хоосон бол бодлого бүхэлдээ нэг зүйл (tests/exam-items.ts).
  scoringGroups Json?

  // Буцаах ба өөрчлөлтийн түүх (ContentRevision): засвар бүрд +1. Засварлагч
  // ачаалсан хувилбараа expectedVersion болгон илгээнэ — зөрвөл 409 (зэрэг
  // засахад сүүлд хадгалсан нь чимээгүй дарахгүй). updatedAt-ийг @updatedAt
  // болгохгүй: статистик (attemptCount…) шинэчлэх нь засвар биш.
  version     Int       @default(0)
  updatedAt   DateTime?
  updatedById String?

  // Зөөлөн устгал: hard DELETE хийвэл Attempt зэрэг аналитикийн түүхэн
  // бичлэгүүд орфон үлдэнэ. Уншихдаа заавал deletedAt: null гэж шүүнэ.
  deletedAt DateTime?

  tags          ProblemTag[]
  formulas      ProblemFormula[]
  analysis      ProblemAnalysis?
  choiceOptions ProblemChoice[] // бүтэцтэй сонголтууд (correct/wrong + алдааны шалтгаан)
  attempts      Attempt[]
  mistakeEntries MistakeEntry[]
  videos        Video[]
  testItems     TestProblem[]
  studyReviewItems StudyReviewItem[]

  @@index([chapterId])
  @@index([deletedAt])
}

// Таксономи: бодлогыг ангилах ангилалууд. Tag нь нэрлэгдсэн REFERENCED entity —
// нэрийг нь нэг өөрчлөхөд тэрхүү tag-тай холбоотой БҮХ бодлого автоматаар
// шинэчлэгддэг (admin code-руу орох шаардлагагүй, багш гараар нэрлэнэ).
enum TagType {
  METHOD // бодох арга: орлуулах, хувиргах…
  QUESTION_FORM // асуултын хэлбэр: утга олох, график унших…
  SUBTOPIC // дэд сэдэв: бутархай, тойрог…
  SKILL // ур чадвар: анхаарал, тооцоолол…
  SOLUTION_TYPE // бодогдох төрөл: "Дискриминантаар бодох", "Виетээр бодох"… (багш засна)
}

model Tag {
  id   String  @id @default(cuid())
  type TagType
  name String

  problems ProblemTag[]

  @@unique([type, name])
}

model ProblemTag {
  problemId String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([problemId, tagId])
}

// Томьёо бүр бүртгэлтэй объект (SPEC §7.2)
model Formula {
  id          String  @id @default(cuid())
  name        String  @unique // "Виетийн теорем"
  latex       String?
  description String?

  slug           String?         @unique
  sectionSlug    String?
  section        FormulaSection? @relation(fields: [sectionSlug], references: [slug], onDelete: SetNull)
  order          Int             @default(0)
  level          String          @default("CORE")
  grade          Int?
  topicSlugs     String[]        @default([])
  general        String?
  variants       Json?
  conditions     Json?
  explanation    String?
  derivation     Json?
  mnemonic       String?
  examples       Json?
  commonMistakes Json?
  eeshTip        String?
  relatedSlugs   String[]        @default([])
  keywords       String[]        @default([])
  widget         String?
  quiz           Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now()) @updatedAt

  problems ProblemFormula[]
  reviews FormulaReview[]
  reviewAttempts FormulaReviewAttempt[]

  @@index([sectionSlug])
  @@index([level])
}

model FormulaSection {
  slug        String    @id
  title       String
  order       Int       @default(0)
  icon        String?
  description String?
  formulas    Formula[]
}

model ProblemFormula {
  problemId String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  formulaId String
  formula   Formula @relation(fields: [formulaId], references: [id], onDelete: Cascade)

  @@id([problemId, formulaId])
}

// Бодлого бүрийн нарийн шинжилгээ — сэдэв, томьёо, тодорхойлох муж,
// тэмдэг солигдох дүрэм, нийтлэг алдааг source-оос салгаж хадгална.
enum ProblemAnalysisStatus {
  AUTO_DRAFT // системийн дүрмээр автоматаар үүсгэсэн, багш баталгаажуулаагүй
  REVIEW_REQUIRED // source/хариу/parse тодорхойгүй тул заавал хүн шалгана
  VERIFIED // багш/админ баталгаажуулсан
}

enum AnswerKeyStatus {
  VERIFIED // хариуны түлхүүрээс үсэг/утга баталгаатай олдсон
  MISSING // хариуны түлхүүрт хоосон эсвэл олдоогүй
  REVIEW_REQUIRED // source болон хариу зөрөх магадлалтай тул хүн шалгана
}

model ProblemAnalysis {
  problemId       String                @id
  problem         Problem               @relation(fields: [problemId], references: [id], onDelete: Cascade)
  status          ProblemAnalysisStatus @default(AUTO_DRAFT)
  answerKeyStatus AnswerKeyStatus       @default(VERIFIED)
  confidence      Float                 @default(0)
  sourcePath      String?
  sourceVariant   String?
  topic           String
  subtopic        String?
  skills          String[]
  methods         String[]
  formulas        Json
  domainNotes     String[]
  signRules       String[]
  commonMistakes  String[]
  solutionOutline String?
  auditNotes      String[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([status])
  @@index([answerKeyStatus])
  @@index([topic])
}

// ============ Тест / Шалгалт ============

enum TestType {
  DAILY // өдөр тутмын
  CHAPTER_EXAM // сэдвийн бүлгийн шалгалт (36+4, дүнг багш оруулна)
  EESH_MOCK // ЭЕШ сорил
  CUSTOM
  THEORY // онолын асуулт-хариултын модуль (Шийдвэр 8)
  THOUSAND // «1000 бодлого» — «Шалгалт» хэсэгт (/tests?includeThousand=1), эргэн харалт /thousand/tests/:id/review
}

enum TestGradingMode {
  AUTO // зөв хариу баталгаатай, систем шууд оноо бодно
  MANUAL // PDF/source орсон ч хариу баталгаажаагүй эсвэл багш гараар дүн оруулна
}

enum ReviewLevel {
  NONE // огт нээхгүй
  PROBLEMS // бодлого + зураг + сурагчийн өөрийн хариу
  FULL // + зөв хариу, бодолт, YouTube видео
}

model Test {
  id           String          @id @default(cuid())
  title        String
  type         TestType
  gradingMode  TestGradingMode @default(AUTO)
  chapterId    String?
  chapter      Chapter?        @relation(fields: [chapterId], references: [id])
  timeLimitMin Int?
  pdfKey       String? // PDF-ээр оруулсан тест (Багш+/Админ)
  price        Int?
  // A/B хувилбарууд: groupKey ижил, variantLabel ялгаатай (ж: "Тест 18" → A, B)
  groupKey     String?
  variantLabel String?
  createdById  String
  createdAt    DateTime        @default(now())

  // Зөөлөн устгал: hard DELETE хийвэл TestResult/Attempt зэрэг түүхэн
  // бичлэгүүд орфон үлдэнэ. Уншихдаа заавал deletedAt: null гэж шүүнэ.
  deletedAt DateTime?
  // Нийтэд харагдахгүй түр хуулбар. Ангиудад оноосон үед засварын замаар ил тод нийтэлнэ.
  isDraft Boolean @default(false)

  // Буцаах ба өөрчлөлтийн түүх (ContentRevision) — Problem-ийнхтэй ижил утгатай.
  version     Int       @default(0)
  updatedAt   DateTime?
  updatedById String?

  problems        TestProblem[]
  access          TestAccess[]
  results         TestResult[]
  attemptSessions TestAttemptSession[]
  itemMarks       TestItemMark[]
  absences        TestAbsence[]
  mockEvents      MockExamEvent[]

  @@index([deletedAt])
  @@index([isDraft, deletedAt])
}

model TestDraft {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  state     Json     @db.JsonB
  revision  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, updatedAt])
}

model TestProblem {
  testId    String
  test      Test    @relation(fields: [testId], references: [id], onDelete: Cascade)
  problemId String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  order     Int
  points    Int     @default(1)

  @@id([testId, problemId])
}

// Тест аль ангиудад харагдахыг сонгоно — автоматаар бүх ангид харагдахгүй
model TestAccess {
  testId      String
  test        Test      @relation(fields: [testId], references: [id], onDelete: Cascade)
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  // 1000 бодлогын шалгалт: ангид оноосон огноо ба эргэн харалтын түвшин.
  // Гараар нээгээгүй (NONE) бол reviewAutoAt (өгөгдмөл assignedAt + 7 хоног)
  // хүрэхэд FULL болж нээгдэнэ — серверт тооцно (thousand/review-gate.ts).
  assignedAt    DateTime    @default(now())
  reviewLevel   ReviewLevel @default(NONE)
  reviewAutoAt  DateTime?
  reviewOpenedAt DateTime?
  reviewOpenedById String?
  reviewOpenedBy User?     @relation("TestAccessReviewOpenedBy", fields: [reviewOpenedById], references: [id], onDelete: SetNull)

  @@id([testId, classroomId])
}

// Онлайн шалгалтын session — сервер-эрхт таймер, shuffle, autosave (Шийдвэр 2).
// Дараалал анх нэг удаа санамсаргүй үүсээд session дуустал хөлдөнө; явц нь
// draftAnswers-т хадгалагдах тул refresh/гацалтад тэсвэртэй. Дуусмагц хөлддөг.
enum AttemptSessionStatus {
  IN_PROGRESS
  SUBMITTED
}

model TestAttemptSession {
  id        String @id @default(cuid())
  testId    String
  test      Test   @relation(fields: [testId], references: [id], onDelete: Cascade)
  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  seed         Int // shuffle-ийн үр (аудит мөрдлөгт)
  problemOrder Json // [problemId] — харуулах дараалал (одоогоор каноник)
  choiceOrder  Json // { problemId: [эх индексүүд display дарааллаар] } — TEXT горимд л
  draftAnswers Json @default("{}") // { problemId: displayIdx | үсэг | утга }
  draftStates  Json @default("{}") // { problemId: SelfState }
  problemTimes Json @default("{}") // { problemId: сек } — бодлого бүрийн бодит хугацаа
  leaveCount   Int  @default(0) // шалгалтын горимоос гарсан тоо (анти-чит)
  events       Json @default("[]") // [{t, type}] — сүүлийн 100 үйл явдал

  startedAt   DateTime             @default(now())
  deadlineAt  DateTime? // null = хугацаагүй; шалгалтыг сервер энэ цагаар хаана
  status      AttemptSessionStatus @default(IN_PROGRESS)
  submittedAt DateTime?
  updatedAt   DateTime             @updatedAt

  @@unique([testId, studentId])
  @@index([studentId, status])
}

model TestResult {
  id          String        @id @default(cuid())
  testId      String
  test        Test          @relation(fields: [testId], references: [id], onDelete: Cascade)
  studentId   String
  student     User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  totalScore  Float
  maxScore    Float
  enteredById String? // CHAPTER_EXAM үед багш гараар оруулна
  source      AttemptSource
  createdAt   DateTime      @default(now())
  // Дүн өөрчлөгдөх бүрт +1 (гар засвар, онлайн дүнг Багш+ засах). regradeNote —
  // системийн товч тэмдэглэл; ажилтны бичсэн шалтгаан зөвхөн AuditLog-д.
  version     Int           @default(1)
  regradeNote String?
  updatedAt   DateTime      @default(now()) @updatedAt

  acknowledgements ResultAcknowledgement[]

  @@unique([testId, studentId])
  @@index([studentId])
}

// ============================================================================
// Шалгалтын бодлого/алхам бүрийн зөв-буруу — онлайн, гар шивэлт, Excel, OMR
// бүгд ЭНЭ нэг хүснэгтэд бичигдэнэ (анализ нэг эх сурвалжтай).
// itemKey: "p:<problemId>" — сонгох эсвэл бүхэл бодлого;
//          "g:<problemId>:<label>" — 2-р хэсгийн алхмын багц (Problem.scoringGroups).
// Оноог энд хадгалахгүй — TestProblem.points / scoringGroups-оос бодно.
// ============================================================================
enum ItemMarkStatus {
  CORRECT
  WRONG
  BLANK // хариулаагүй (онлайн)
}

enum ItemMarkSource {
  ONLINE
  MANUAL
  EXCEL
  OMR
}

model TestItemMark {
  id          String         @id @default(cuid())
  testId      String
  test        Test           @relation(fields: [testId], references: [id], onDelete: Cascade)
  studentId   String
  student     User           @relation("TestItemMarkStudent", fields: [studentId], references: [id], onDelete: Cascade)
  itemKey     String
  status      ItemMarkStatus
  source      ItemMarkSource
  enteredById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([testId, studentId, itemKey])
  @@index([studentId])
}

// Шалгалтад ирээгүй сурагч — дүн, дундажид тооцогдохгүй. TestResult-аас тусдаа
// (TestResult-ийг уншдаг бүх газар 0 оноо гэж андуурахгүйн тулд).
model TestAbsence {
  testId     String
  test       Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  studentId  String
  student    User     @relation("TestAbsenceStudent", fields: [studentId], references: [id], onDelete: Cascade)
  markedById String?
  createdAt  DateTime @default(now())

  @@id([testId, studentId])
  @@index([studentId])
}

// ============================================================================
// Эцэг эх шалгалтын дүнтэй ТАНИЛЦСАН баримт — цаасан гарын үсгийг орлоно.
// Имэйл OTP-оор баталгаажина (эзний шийдвэр 2026-08-08: SMS түр хойшилсон).
// Хэзээ, хаанаас, ямар сувгаар танилцсаныг хадгалснаар маргаан гарахад
// цаасан гарын үсгээс дутахгүй мөрдлөг болно.
// ============================================================================
model ResultAcknowledgement {
  id           String     @id @default(cuid())
  testResultId String
  testResult   TestResult @relation(fields: [testResultId], references: [id], onDelete: Cascade)
  parentId     String
  parent       User       @relation(fields: [parentId], references: [id], onDelete: Cascade)
  channel      String // "EMAIL_OTP" — ирээдүйд "SMS_OTP", "DAN" нэмэгдэж болно
  verifiedAt   DateTime   @default(now())
  ip           String?

  // Нэг дүнг нэг эцэг эх нэг л удаа танилцана (давтан дарахад алдаа биш,
  // байгаа бичлэгээ буцаана — service түвшинд upsert)
  @@unique([testResultId, parentId])
  @@index([parentId])
}

// Имэйлээр илгээх нэг удаагийн код — SMS-ийн PasswordResetToken-ий ижил
// зарчим (хэшлэж хадгална, оролдлого тоолно), гэхдээ зориулалт олон төрөл.
model EmailOtp {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose    String // "RESULT_ACK" | ирээдүйд бусад
  codeHash   String // HMAC-SHA256 (RESET_TOKEN_SECRET-ээр) — ил хадгалахгүй
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([userId, purpose, createdAt])
}

// ============ Оролдлого — аналитикийн цөм (SPEC §9) ============

enum SelfState {
  SOLVED_CLEAN // ✅ 100% ойлгож, алдалгүй бодсон
  FIXED_AFTER_ERROR // 🔁 эхэлж алдаад засч дуусгасан
  FAILED // ❌ алдсан / чадаагүй
  GUESSED // 🎯 буудсан — таамгаар оноо авсан
}

enum AttemptSource {
  EVENING_SELF_REPORT // оройн өөрийн тэмдэглэгээ (танхимд утас хураадаг тул)
  ONLINE_TEST // системийн авто шалгалт
  CHAPTER_EXAM // 36+4 шалгалт, багш оруулсан
  OMR_IMPORT // хариултын хуудас уншигч машин
  MANUAL_ENTRY // бусад төрлийн (ЭЕШ сорил, 1000 бодлого …) цаасан дүн — гар/Excel
}

model Attempt {
  id           String        @id @default(cuid())
  studentId    String
  student      User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  problemId    String
  problem      Problem       @relation(fields: [problemId], references: [id], onDelete: Cascade)
  source       AttemptSource
  // Аль өдрийн хичээлд хамаарах вэ (оройн тэмдэглэгээ өчигдрийнхөө өдрөөр бичигдэнэ)
  occurredOn   DateTime      @db.Date
  autoCorrect  Boolean? // системийн авто үр дүн (онлайн тест, OMR)
  selfState    SelfState? // өөрийн тэмдэглэгээ
  timeSpentSec Int?

  /**
   * Сурагчийн ЯГ ЮУ хариулсан — гүйцэтгэлийн үнэлгээ БИШ, агуулга.
   * ⚠️ ЯАГААД ЭНЭ ХЭРЭГТЭЙ ВЭ (2026-08-08-нд нэмсэн):
   * Өмнө нь зөвхөн `autoCorrect` (үнэн/худал) хадгалагддаг байсан. Тэр нь
   * «буруу» гэдгийг л хэлнэ, «ЯАГААД буруу» гэдгийг хэлэхгүй. Улмаас:
   * • distractor analysis (аль буруу сонголтыг хэн сонгов) БОЛОМЖГҮЙ
   * • алдааны ангилал / misconception илрүүлэлт БОЛОМЖГҮЙ
   * • ирээдүйд загвар сургахад хамгийн үнэ цэнэтэй дохио ДУТУУ
   * Хариулт нь `TestAttemptSession.draftAnswers`-т үлддэг ч тэр нь зөвхөн
   * онлайн сесстэй холбоотой, цаасан/OMR эх сурвалжийг хамрахгүй.
   * ХАДГАЛАХ УТГА: `gradeAnswer()`-ийн буцаадаг `canonicalAnswer` —
   * сонголтын ЖИНХЭНЭ ТЕКСТ (эсвэл тоон хариу), холилтын дараалалаас ҮЛ
   * ХАМААРНА. Түүхий индекс хадгалбал тухайн сессийн `choiceOrder` байхгүй
   * бол дараа нь тайлагдахгүй болно.
   * Хоосон (null) байж болно: хариулаагүй, эсвэл хариу тодорхойгүй бодлого.
   */
  givenAnswer Json?
  testId      String?
  classroomId String?
  // Non-null means collection is complete (new legacy rows default to now).
  // New wrong attempts explicitly set this to null for durable collector retry.
  mistakeCollectedAt DateTime? @default(now())
  createdAt   DateTime @default(now())

  @@index([studentId, occurredOn])
  @@index([problemId])
  @@index([studentId, problemId])
  @@index([mistakeCollectedAt, autoCorrect])
}

model MistakeEntry {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId         String
  problem           Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  source            String // "PRACTICE" | "TEST"
  sourceRefId       String?
  sourceOccurredAt DateTime?
  testTitle         String?
  givenAnswer       Json?
  status            String   @default("NEW") // NEW | RETRYING | MASTERED
  retryCount        Int      @default(0)
  consecutiveCorrect Int     @default(0)
  lastRetryAt       DateTime?
  lastCorrectAt     DateTime?
  nextRetryAt       DateTime?
  reason            String? // CALC | CONCEPT | FORMULA | READING | TIME | UNKNOWN
  note              String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, problemId])
  @@index([userId, status, nextRetryAt])
}

// Шөнө бүрийн cron-ийн анги тус бүрийн өдрийн дүгнэлт (SPEC §9.1.1)
model DailyClassSummary {
  id          String    @id @default(cuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  date        DateTime  @db.Date
  stats       Json // тэмдэглэсэн/тэмдэглээгүй, төлөвийн тархалт, сэдвийн зураглал
  createdAt   DateTime  @default(now())

  @@unique([classroomId, date])
}

// Таамаглал бүр хадгалагдаж бодит үр дүнтэй харьцуулагдана (SPEC §9.3)
enum PredictionKind {
  ERROR_RISK // "энэ сэдэв/бодлогод алдах магадлал X%"
  EESH_SCORE // таамаглах ЭЕШ онооны муж
}

model Prediction {
  id          String         @id @default(cuid())
  studentId   String
  student     User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  kind        PredictionKind
  payload     Json // таамаглалын утга, муж, ашигласан загварын хувилбар
  predictedAt DateTime       @default(now())
  evaluatedAt DateTime?
  actual      Json? // бодит үр дүн — загварын нарийвчлалыг хэмжихэд

  @@index([studentId, kind])
}

// Багшийн өнгөний тэмдэглэгээ — зөвхөн багш нар + админд харагдана (SPEC §13.1)
model StudentColorTag {
  id          String   @id @default(cuid())
  studentId   String
  student     User     @relation("TaggedStudent", fields: [studentId], references: [id], onDelete: Cascade)
  color       String // hex эсвэл нэрлэсэн өнгө
  note        String?
  createdById String
  updatedAt   DateTime @updatedAt

  @@unique([studentId, createdById])
}

// ============ Сурагчийн тэмдэглэл (Student Notes) ============
// Ерөнхий (GENERAL) болон төлбөртэй холбоотой (PAYMENT) тэмдэглэлийг тусад
// нь ялгаж хадгална — эрхийн матриц дахь мөнгөтэй холбоотой асуудлыг зөвхөн
// Багш+ шийддэг зарчимтай уялдана.
enum StudentNoteType {
  GENERAL
  PAYMENT
}

// БИЗНЕСИЙН ДҮРЭМ (StudentNotesService дотор шалгагдана):
// Жилийн төлбөрөө бүтэн төлсөн сурагчид PAYMENT төрлийн тэмдэглэл үүсгэхийг
// хориглоно (tuitionPlan = FULL_YEAR бөгөөд төлбөр баталгаажсан). Бусад
// сурагчдад зөвшөөрнө. Шалгалт нь StudentNotesService дотор.
model StudentNote {
  id           String          @id @default(cuid())
  studentId    String
  student      User            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type         StudentNoteType
  body         String // 1–4000 тэмдэгт
  createdById  String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  resolvedAt   DateTime?
  resolvedById String?
  // Төлбөрийн тэмдэглэл: эцэг эх «хэзээ төлнө» гэж амласан өдөр. Энэ өдөр
  // өнгөрөөд тэмдэглэлээс хойш баталгаажсан төлбөр ирээгүй бол «амлалт тасарсан».
  promisedOn   DateTime?       @db.Date

  @@index([studentId, type])
  @@index([createdAt])
}

// ============ Аудит лог (Audit Log) ============
// Эрхийн матрицаар контент/төлбөр/дүн засварлах эрх Багш+-д нээгдсэнтэй
// холбоотойгоор бүх мөнгөтэй болон бусад засварлагдах бичлэгийн өөрчлөлтийг
// хэн, юуг, хэзээ, ямар шалтгаанаар өөрчилснийг бүрэн хадгална.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actorRole String
  action    String // ж: "UPDATE", "CONFIRM", "REVERSE", "DELETE"
  entity    String // ж: "Payment", "StudentProfile", "TestResult"
  entityId  String
  before    Json?
  after     Json?
  reason    String?
  at        DateTime @default(now())

  @@index([actorId])
  @@index([at])
  @@index([entity, entityId])
  @@index([actorId, at])
}

// ============ Контентын хувилбар — буцаах ба өөрчлөлтийн түүх ============
// docs/v2/BUTSAAH-TUUKH-TOLOVLOGOO.md. Бодлого/тестийн засвар бүр БҮРЭН
// хуулбартай (snapshot) энд бичигдэнэ: хэн, хэзээ, юу өөрчилсөн (товч), шалтгаан.
// Сэргээх нь өөрөө шинэ хувилбар (RESTORE) — түүх устахгүй. Хувилбар 0 = анхны
// төлөв; хуучин мөрд анх засахад залхуугаар үүснэ (8000 мөрийг backfill хийхгүй).
// Засварын transaction дотор бичигдэнэ (api/src/revisions/revision-store.ts).
// AuditLog хэвээр бичигдсээр — энэ нь түүнийг орлохгүй, нэмэлт.
enum RevisionEntity {
  PROBLEM
  TEST
}

enum RevisionAction {
  CREATE
  UPDATE
  RESTORE
  IMPORT
}

model ContentRevision {
  id        String         @id @default(cuid())
  entity    RevisionEntity
  entityId  String
  version   Int
  snapshot  Json // сэргээж болох бүрэн төлөв (revisions/revision-snapshot.ts)
  summary   String // монгол товч: «B сонголтыг зөв болгосон»
  action    RevisionAction
  actorId   String
  actorRole String
  reason    String?
  createdAt DateTime       @default(now())

  @@unique([entity, entityId, version])
  @@index([entity, entityId, createdAt])
}

// ============ Эрх (named pass) ба Төлбөр ============

model Pass {
  id           String  @id @default(cuid())
  name         String  @unique // "Сарын онлайн эрх", "ЭЕШ багц", "Тоо тоолол бүлэг"…
  durationDays Int
  // Хамрах хүрээ: chapterIds, bookIds, videoIds, testIds жагсаалтууд
  scope        Json
  price        Int? // заавал биш — чөлөөт дүнгийн зарчимтай зэрэгцэнэ
  active       Boolean @default(true)

  userPasses UserPass[]
}

model UserPass {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  passId    String
  pass      Pass     @relation(fields: [passId], references: [id])
  startsAt  DateTime @default(now())
  expiresAt DateTime
  paymentId String?
  // Immutable entitlement at grant; null denotes legacy live definition.
  scopeSnapshot Json?

  @@index([userId, expiresAt])
}

enum PaymentMethod {
  QPAY
  BANK_TRANSFER
  CASH
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
  REVERSED // Багш+/Админ баталгаажсан төлбөрийг буцаасан — эрх автоматаар цуцлагдана
}

// ============================================================================
// Хаан банкны хуулгын мөр — шууд шилжүүлгийг сурагчтай тулгах түүхий өгөгдөл.
// Гүйлгээний утгаас утасны дугаар олдвол сурагчтай АВТОМАТААР тулгана, гэхдээ
// Payment CONFIRMED болгох нь ХАТУУ болзолтой: утас яг 1 сурагчид таарсан БА
// дүн хүлээгдэж буй төлбөртэй тэнцүү үед л. Бусад бүх мөр админд гараар.
// ============================================================================
enum BankMatchStatus {
  UNMATCHED // тулгаагүй — админы жагсаалтад
  AUTO_MATCHED // утас + дүн хоёул таарч автоматаар баталгаажсан
  MANUAL_MATCHED // админ гараар сурагчтай холбосон
  IGNORED // төлбөр биш гүйлгээ (цалин, түрээс…) — админ нуусан
}

model BankTransaction {
  id      String @id @default(cuid())
  // Банкны журналын дугаар — ИДЕМПОТЕНТ байдлын түлхүүр: ижил хуулгыг дахин
  // импортлоход @unique нь давхар мөр үүсэхийг ӨС түвшинд зогсооно.
  bankRef String @unique

  bookedAt     DateTime // гүйлгээ хийгдсэн огноо (хуулгаас)
  amount       Int // ₮, зөвхөн ОРЛОГО (кредит) импортлоно
  description  String // гүйлгээний утга — утасны дугаар эндээс хайна
  accountNo    String? // хүлээн авсан данс
  counterparty String? // шилжүүлэгчийн нэр/данс (хуулгад байвал)

  matchStatus   BankMatchStatus @default(UNMATCHED)
  matchedUserId String?
  matchedUser   User?           @relation("BankTxMatchedUser", fields: [matchedUserId], references: [id])
  // Тулгалтаас үүссэн/холбогдсон төлбөр — нэг гүйлгээ нэг л төлбөр үүсгэнэ
  paymentId     String?         @unique

  importedById String
  importedBy   User     @relation("BankTxImportedBy", fields: [importedById], references: [id])
  importedAt   DateTime @default(now())
  // Хуулгын эх мөр — маргаан гарвал эх өгөгдөл рүү буцаж харна
  rawRow       Json

  @@index([matchStatus, bookedAt])
  @@index([matchedUserId])
}

// Хуучин SIE- кодын архив — шинэ формат руу шилжүүлэхэд эх кодыг хадгална
model StudentCodeLegacy {
  userId  String @id
  oldCode String
}

model Payment {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id])
  amount            Int // хэрэглэгчийн өөрөө бичсэн дүн (₮)
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  description       String? // төлсөн зам, тайлбар
  forMonth          String? // "2026-09" — аль сарын төлбөр
  paidAt            DateTime?
  confirmedById     String? // данс/бэлэн үед Багш+/Админ гараар баталгаажуулна
  qpayInvoiceId     String?
  clientRequestId   String?
  normalizedRequestHash String?
  invoiceAttemptedAt DateTime?
  qpayCheckoutSnapshot Json?
  storePurchaseId String?
  storePurchase Purchase? @relation("CheckoutPurchase", fields: [storePurchaseId], references: [id], onDelete: Restrict)
  // QPay-ийн ГҮЙЛГЭЭНИЙ дугаар (invoice биш). Callback хоёр удаа ирэх, эсвэл
  // callback болон polling хоёулаа нэг гүйлгээг барих нь ХЭВИЙН тохиолдол —
  // @unique нь тэр үед хоёр дахь бичилтийг ӨС түвшинд зогсооно. Кодын түвшний
  // шалгалт race condition-д алдаж болох тул баталгаа нь ЭНД байх ёстой.
  providerPaymentId String?       @unique
  createdAt         DateTime      @default(now())

  @@index([userId, forMonth])
  @@index([status])
  @@unique([userId, clientRequestId])
  @@index([storePurchaseId])
}


// ============ Нэг удаагийн худалдан авалт (тест, ном, эрх) ============

enum ProductKind {
  TEST // сургалтын шалгалт
  BOOK // нууцлалт хэрэглэгдэх хичээл ном
  PASS // ХУГАЦААТ эрх (одоогийн Pass模型 орнот)
}

model ProductItem {
  id     String      @id @default(cuid())
  kind   ProductKind
  refId  String // Test.id эсвэл Book.id
  price  Int // ₮, БҮХЭЛ (Float ХЭРЭГЛЭХГҮЙ)
  active Boolean     @default(true)

  // Номын 2 хувилбар (эзний шийдвэр 2026-08-08): нэг ном «зөвхөн ном» ба
  // «ном + видео тайлбар» гэсэн 2 бүтээгдэхүүнээр зарагдана. true үед
  // худалдан авалт баталгаажихад тухайн номын бүлгүүдийн видео эрх давхар
  // олгогдоно (store.service → videos эрхийн шалгалт).
  includesVideo Boolean @default(false)

  purchases Purchase[]

  // Хуучин @@unique([kind, refId]) байсан — нэг ном 2 хувилбартай болохоор
  // includesVideo талбар түлхүүрт нэмэгдэв.
  @@unique([kind, refId, includesVideo])
  @@index([active])
}

model Purchase {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  productItemId String
  productItem   ProductItem @relation(fields: [productItemId], references: [id], onDelete: Cascade)
  paymentId     String? // тав Payment-тэй холбоогүй худалдан авалт ч байж болно (эзний шийдвэр)
  price         Int // ₮, худалдан авах үеийн үнэ (шалтгаанаас хамаарна шинээр өөрчлөгдсөн бодвол)
  grantedAt     DateTime? // эрх эхлэсэн цаг
  expiresAt     DateTime? // эрх дуусах цаг (ном нь null, тест = гэрээний үргэлжлэх хугацаа)
  createdAt     DateTime    @default(now())
  // version, passId, durationDays and scope frozen at the pending quote.
  passSnapshot  Json?
  checkoutPayments Payment[] @relation("CheckoutPurchase")

  @@index([userId, productItemId])
  @@index([userId, expiresAt])
}

// ============ Орлого/зарлага ============

enum ExpenseCategory {
  SALARY // цалин
  RENT // ааш
  UTILITIES // коммунал
  MARKETING // сурталчилга
  MATERIALS // материал
  EQUIPMENT // тоног төхөөрөмж
  OTHER // бусад
}

model ExpenseRecord {
  id          String          @id @default(cuid())
  amount      Int // ₮
  category    ExpenseCategory
  description String?
  occurredOn  DateTime        @db.Date
  createdById String
  createdAt   DateTime        @default(now())

  @@index([occurredOn])
  @@index([category])
  @@index([createdAt])
}

// ============ Төлбөрийн буцаалт ============

enum RefundStatus {
  DRAFT // ноорог (ТООЦОО хийгдсэн, баталгаажаагүй)
  PENDING_APPROVAL // админд явуулсан (баталгаажахыг хүлээж байна)
  APPROVED // админ баталгаажуулсан
  PAID // төлөгдсөн
  CANCELLED // цуцалсан
}

model TuitionRefund {
  id                 String       @id @default(cuid())
  studentId          String
  student            User         @relation(fields: [studentId], references: [id], onDelete: Cascade, name: "StudentTuitionRefunds")
  classroomId        String
  classroom          Classroom    @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  leftOn             DateTime     @db.Date // ангиас гарсан огноо
  totalLessonDays    Int // гэрээний нийт хичээлийн өдөр
  attendedLessonDays Int // суусан хичээлийн өдөр
  dailyRate          Int // ₮/өдөр (бүхэл, дугуйруулсан)
  totalPaid          Int // ₮, нийт төлсөн
  owed               Int // ₮, барагдуулсан хэмжээ
  refundAmount       Int // ₮, буцаалтын хэмжээ (owed - totalPaid нь сөрөг байвал 0)
  shortfall          Int // ₮, дутуу төлсөн дүн (сөрөг байж болохгүй)
  status             RefundStatus @default(DRAFT)
  warnings           String? // Анхааруулга (JSON массив)
  note               String? // админ, багш+ тайлбар
  paymentMethod      String? // "BANK_TRANSFER", "CASH", "QPAY" гэх мэт

  createdById        String
  createdBy          User         @relation("TuitionRefundCreatedBy", fields: [createdById], references: [id])
  approvedById       String?
  approvedBy         User?        @relation("TuitionRefundApprovedBy", fields: [approvedById], references: [id])
  approvedAt         DateTime?

  paidById           String?
  paidBy             User?        @relation("TuitionRefundPaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  paidAt             DateTime? // төлөгдсөн цаг

  cancelledById      String?
  cancelledBy        User?        @relation("TuitionRefundCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  cancelledAt        DateTime?
  cancelReason       String?

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([studentId])
  @@index([status])
  @@index([classroomId, leftOn])
}

// Төвийн зарлал — танхимын сурагчдын нийтийн самбарт харагдана
enum AnnouncementAudience {
  ALL_STUDENTS // бүх сурагч
  ALL_CLASSROOM // бүх танхимын сурагчид
  ALL_ONLINE // бүх онлайн сурагч
  ONE_CLASSROOM // тодорхой нэг анги (хуучин compatibility)
  SELECTED_CLASSROOMS // олон тодорхой анги
}

model Announcement {
  id               String                        @id @default(cuid())
  title            String
  body             String
  audience         AnnouncementAudience          @default(ALL_CLASSROOM)
  classroomId      String? // ONE_CLASSROOM үед
  pinned           Boolean                       @default(false)
  createdById      String
  createdAt        DateTime                      @default(now())
  classroomTargets AnnouncementClassroomTarget[]

  // Зөөлөн устгал: hard DELETE-ийн оронд түүхийг хадгална. Уншихдаа заавал
  // deletedAt: null гэж шүүнэ.
  deletedAt DateTime?

  @@index([audience, createdAt])
  @@index([classroomId])
  @@index([deletedAt])
}

model AnnouncementClassroomTarget {
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  classroomId    String
  classroom      Classroom    @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@id([announcementId, classroomId])
  @@index([classroomId])
}

// In-app inbox entries. Each row belongs to exactly one recipient.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      NotificationKind
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model NotificationPreference {
  userId         String   @id
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailWeekly    Boolean  @default(true)
  emailReminders Boolean  @default(true)
  updatedAt      DateTime @updatedAt
}

model NotificationDelivery {
  id              String    @id @default(cuid())
  sentKey         String    @unique
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind            NotificationKind
  title           String
  body            String
  link            String?
  inAppSentAt     DateTime?
  emailAttemptedAt DateTime?
  emailSentAt     DateTime?
  emailError      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId, createdAt])
}

model JobRun {
  id         String   @id @default(cuid())
  name       String
  lockKey    String?  @unique
  startedAt  DateTime @default(now())
  finishedAt DateTime?
  ok         Boolean?
  summary    Json?

  @@index([name, startedAt])
}

enum NotificationKind {
  PAYMENT_DUE
  HOMEWORK
  SCHEDULE_CHANGE
  ANNOUNCEMENT
  SYSTEM
}

// Анги тухайн өдөр ямар тест/шалгалт хийснийг багш бүртгэнэ.
// Сурагч оройн тэмдэглэгээндээ token мэдэхгүйгээр бодлогуудаа эндээс шууд хардаг.
model ClassTestSession {
  id                 String   @id @default(cuid())
  classroomId        String
  // Бодлогын сангийн тест бол энд testId байна.
  // ГАРААР бичсэн (гаднын) тест бол testId = null, оронд нь manualTitle.
  // Учир: сурагчид заримдаа манай санд ОГТ байхгүй бодлого бодох тул багш
  // зөвхөн НЭРИЙГ нь бичээд бүртгэх боломжтой байх ёстой. Тест үүсгэхгүй.
  testId             String?
  // Гараар бичсэн тестийн нэр (testId = null үед л утгатай)
  manualTitle        String?
  // Гараар бичсэн тестийн бодлогын тоо — сурагчийн оройн тэмдэглэгээнд
  // 1..N хүртэлх дугаар гаргахад ашиглана.
  manualProblemCount Int?
  date               DateTime @db.Date
  createdById        String
  createdAt          DateTime @default(now())

  // Тухайн анги уг өдөр ХИЙГЭЭГҮЙ (алгассан) бодлогуудын Problem.id.
  // Хоосон = бүх бодлого орсон. Сурагчийн оройн тэмдэглэгээнд эдгээр харагдахгүй.
  excludedProblemIds String[] @default([])

  @@unique([classroomId, testId, date])
  @@index([classroomId, date])
}

// ============ Сурагчийн үйлдлийн урсгал (Knowledge-Tracing/аналитикийн суурь) ============

enum LearningEventType {
  LOGIN
  LOGOUT
  SEARCH
  CHAPTER_OPENED
  VIDEO_STARTED
  VIDEO_COMPLETED
  PROBLEM_OPENED
  ANSWER_SUBMITTED
  HINT_USED
  RETRY
  BOOKMARK
  TEST_STARTED
  TEST_FINISHED
  EVENING_MARK
  PAGE_VIEW
}

// Зөвхөн нэмэгддэг (append-only) төлөвийн урсгал — ирээдүйн Knowledge-Tracing/
// аналитик давхаргын суурь. problemId/testId/chapterId/videoId-г санаатайгаар
// холбоос (foreign key) биш, чөлөөт String болгосон: энэ бол аналитикийн лог тул
// холбогдох контент устсан ч (Problem/Test/Chapter/Video устгагдсан ч) хуучин
// event-үүд алдагдахгүй, лог бүрэн хадгалагдана.
model LearningEvent {
  id         String            @id @default(cuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       LearningEventType
  occurredAt DateTime          @default(now())
  // Клиент талд үүсгэсэн session бүлэглэлт (нэг landing-аас гарах хүртэлх урсгал)
  sessionId  String?
  problemId  String?
  testId     String?
  chapterId  String?
  videoId    String?
  durationMs Int?
  device     String?
  meta       Json?

  // Дан @@index([userId]) байсныг ХАССАН (PERF-AUDIT.md §0 олдвор #8): доорх
  // composite [userId, occurredAt]-ийн prefix нь `WHERE userId = ...` query-г
  // аль хэдийн бүрхдэг тул давхардал байсан — EXPLAIN-ээр баталгаажуулав (энэ
  // migration-ий description-д дэлгэрэнгүй). Экзамен-hot биш ч write overhead-г
  // (exam замд Attempt/TestAttemptSession bulk write-той зэрэгцэн ажилладаг DB
  // instance) шалтгаангүй нэмдэг байсныг цэвэрлэв.
  @@index([occurredAt])
  @@index([sessionId])
  @@index([userId, occurredAt])
}

// ============ Элсэлтийн цонх (Enrollment Windows) ============
// Эзний тогтоосон дүрэм (2026-07-27): элсэлт жилийн турш бүх цагт нээлттэй
// биш, хичээл БҮР ӨӨРСДИЙН ХУВЬД дүүрч болно. Багш+/Админ хичээл тус бүрийг
// өөрсдөө нээж/хааж чадах ёстой тул статусыг код руу chit хийхгүй, энэ
// хүснэгтэд дата болгож хадгална.
enum EnrollmentStatus {
  OPEN
  CLOSED
  COMING_SOON
}

// 🎯 Танхим/онлайн сурагчид аль хичээл нээлттэйг тодорхойлно — ЭНЭ БОЛ
// ЭЗНИЙ ГОЛ ДҮРМИЙГ ДАТА БОЛГОСОН хэсэг (UI дотор hardcode хийхгүй):
//   Математик        → BOTH (танхим ба онлайн хоёуланд)
//   Нийгэм судлал     → CLASSROOM_ONLY
//   SAT               → CLASSROOM_ONLY (мөн одоогоор COMING_SOON)
// Ирээдүйд төв Нийгэм судлалыг онлайнаар нээвэл энэ зөвхөн НЭГ МӨРИЙН
// (EnrollmentWindow.availability) утга солих байх ёстой — код өөрчлөх
// шаардлагагүй.
enum SubjectAvailability {
  CLASSROOM_ONLY
  ONLINE_ONLY
  BOTH
}

// Хичээл тус бүрийн элсэлтийн цонх — landing page (нийтэд) болон Lead
// баталгаажуулалт (сервер талд) хоёул үүнийг эх сурвалж болгон уншина.
model EnrollmentWindow {
  id           String              @id @default(cuid())
  subject      Subject             @unique
  status       EnrollmentStatus
  availability SubjectAvailability
  note         String?
  updatedById  String
  updatedAt    DateTime            @updatedAt
}

// ============ Нийтийн лийд бүртгэл (Landing page lead-capture) ============
// Бизнесийн контекст: төв Facebook-ийн 7,900 followers-тэй ч бүх элсэлтийг
// гараар Messenger DM-ээр боловсруулдаг байсан (шөнө/амралтын өдөр алдагдсан
// лийд, хэмжигдэхгүй урсгал). Энэ хүснэгт нүүр хуудасны 4 талбарт маягтаас
// (Нэр/Утас/Хичээл/Анги) ирсэн хүсэлтийг бодитоор хадгалж, ADMIN/TEACHER_PLUS
// нар статусыг нь ажиллуулна.

// LeadSubject нь Content модулийн Subject enum-тай яг адилгүй: энд лийд
// "аль аль хичээлээр" сонирхож болох тул BOTH нэмэлт утгатай. Тиймээс
// Book/Chapter-д ашиглагдаж буй Subject enum-ыг өөрчлөхгүй, тусад нь
// зарлав — өөр модулийн миграцтай мөргөлдөхгүй.
enum LeadSubject {
  MATH
  SOCIAL_STUDIES
  BOTH
}

enum LeadStatus {
  NEW
  CONTACTED
  ENROLLED
  LOST
}

// Нийтийн (нэвтрэлтгүй) маягтаас ирдэг тул userId огт байхгүй — зөвхөн
// сонирхогчийн бөглөсөн 4 талбар + ажилтны ажиллуулах статус.
model Lead {
  id        String      @id @default(cuid())
  name      String
  phone     String
  // ХАСАГДСАН (deprecated): хуучин "нэг хичээл" талбар. Зөвхөн ХУУЧИН
  // бичлэгүүд алдагдахгүй байхын тулд үлдээв — шинэ код бүгд `subjects`-ийг
  // ашиглана. Шинэ бичилт хийхдээ энэ талбарыг `subjects`-ээс тооцоолж
  // бөглөнө (нэг хичээл → тэр утга; олон хичээл → BOTH).
  subject   LeadSubject
  // Сонирхогчийн сонгосон хичээлүүд (1–3ыг зөвшөөрнө, DTO дээр шалгана).
  subjects  Subject[]
  grade     Int
  status    LeadStatus  @default(NEW)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
}

// ============ Ажилтны төлөвлөгч (Staff Work Planner) ============
// Жилийн турш 16 ажилтан ажлаа жижиг даалгавар болгон хуваан төлөвлөнө
// (Taskly загварчлал). parentTaskId нь нэг том ажлыг дэд даалгавар
// (subtask) болгон "жижиг хэсэг болгон хуваах" шаардлагыг хангана.

enum TaskStatus {
  PLANNED
  IN_PROGRESS
  DONE
  BLOCKED
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model StaffTask {
  id            String       @id @default(cuid())
  title         String
  description   String?
  status        TaskStatus   @default(PLANNED)
  priority      TaskPriority @default(NORMAL)
  startDate     DateTime?
  dueDate       DateTime?
  // Эцэг даалгавар устахад дэд даалгаварууд устахгүй, харин дээд
  // түвшний бие даасан даалгавар болж үлдэнэ (parentTaskId = null).
  parentTaskId  String?
  parentTask    StaffTask?   @relation("StaffTaskSubtasks", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subtasks      StaffTask[]  @relation("StaffTaskSubtasks")
  createdById   String
  createdBy     User         @relation(fields: [createdById], references: [id])
  classroomId   String?
  classroom     Classroom?   @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  subject       Subject?
  estimateHours Int?
  orderIndex    Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  assignees StaffTaskAssignee[]

  @@index([status, dueDate])
  @@index([dueDate])
}

// Нэг даалгавар дээр олон ажилтан хамтарч болно (олон-олон холбоос).
model StaffTaskAssignee {
  taskId     String
  task       StaffTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime  @default(now())

  @@id([taskId, userId])
}

// ============ Хичээлийн хуваарь (Class Schedule) ============
// Хуваарь долоо хоног бүр бараг өөрчлөгддөггүй тул тодорхой огноон дээрх
// мөр мөрөөр биш, ДАВТАГДАХ ХЭВ МАЯГ (recurring pattern) байдлаар хадгална.
// startMinute/endMinute-ийг DateTime биш, шөнө дундаас хойшхи МИНУТ тоогоор
// хадгалсан: хуваарь бол тодорхой ХУАНЛИЙН ОГНОО огт байхгүй, зөвхөн 7
// хоногийн өдөр дээр давтагддаг хэв маяг тул огноо шаарддаг DateTime төрөл
// ашиглавал шаардлагагүй цагийн бүсийн (timezone) асуудлыг датандаа чирж
// оруулах болно — минутаар хадгалснаар энэ асуудал огт үүсэхгүй.
model ClassSchedule {
  id            String    @id @default(cuid())
  classroomId   String
  classroom     Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  weekday       Int // 0=Ням, 1=Даваа … 6=Бямба (JS Date.getDay()-тэй ижил дараалал)
  startMinute   Int // шөнө дундаас хойшхи минут (жишээ нь 09:00 = 540)
  endMinute     Int
  teacherId     String?
  teacher       User?     @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  room          String?
  subject       Subject?
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())

  exceptions ScheduleException[]
  topics     LessonTopic[]
  staffing   LessonStaffing[]

  @@unique([classroomId, weekday, startMinute, effectiveFrom])
  @@index([classroomId, weekday])
}

// Тухайн долоо хоногийн НЭГ тохиолдол (occurrence) өөрчлөгдөх нь — цуцлагдах
// (CANCELLED) эсвэл өөр огноо/цагт шилжих (MOVED). "date" талбар нь ХУУЧИН,
// анхны тохиолдлын огноо — шинэ огноог newDate-д хадгална.
enum ScheduleExceptionKind {
  CANCELLED
  MOVED
}

model ScheduleException {
  id             String                @id @default(cuid())
  scheduleId     String
  schedule       ClassSchedule         @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  date           DateTime              @db.Date
  kind           ScheduleExceptionKind
  newDate        DateTime?             @db.Date
  newStartMinute Int?
  newEndMinute   Int?
  newRoom        String?
  note           String?
  createdAt      DateTime              @default(now())

  @@unique([scheduleId, date])
}

// Тухайн тохиолдол дээр багшийн товлосон "өнөөдөр орох сэдэв".
model LessonTopic {
  id          String        @id @default(cuid())
  scheduleId  String
  schedule    ClassSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  date        DateTime      @db.Date
  title       String
  // Plain string — Chapter устсан ч энэ бичлэг найдвартай хэвээр үлдэнэ
  // (LearningEvent-ийн адилхан конвенц).
  chapterId   String?
  createdById String
  updatedAt   DateTime      @updatedAt
  // ── Хичээлийн төлөвлөгөө (эзэн 2026-10-18; Багш+ өмнөх өдөр нь тавина) ──
  // Тухайн хичээлд хийх тестүүд, номын дарааллаар (Test.id). Хийсэн нь ClassTestSession.
  testIds        String[] @default([])
  // «DISMISS» = тарах, «STAY» = үлдэнэ — зөвхөн багш нарт харагдана, сурагчид ХЭЗЭЭ Ч үгүй
  dismissMode    String?
  // Онолын зургийг илгээх сурагч (User.id) — ангийнхан хэн болохыг урьдчилж харна
  photoStudentId String?

  @@unique([scheduleId, date])
}

// Өдрийн хуваарийг нийтэлсэн тэмдэг (эзэн 2026-10-11): Багш+ «Нийтлэх» дарахад
// тэр өдөр хичээлтэй багш, сурагчдад мэдэгдэл очно; дахин дарвал «өөрчлөгдсөн».
model SchedulePublication {
  date          DateTime @id @db.Date
  publishedAt   DateTime
  publishedById String
  recipients    Int
}

// Тухайн өдрийн хичээлд орох АХЛАХ ба ТУСЛАХ багш (эзэн 2026-10-08).
// Төв хуваариа өдөр өдрөөр гаргадаг тул багшийг огноогоор оноодог; хоёулаа
// хоосон байж болно. Багшийн id-г энгийн мөр болгож хадгална (LessonTopic-ийн
// createdById-тэй ижил конвенц) — багш архивлагдсан ч түүх үлдэнэ.
model LessonStaffing {
  id                 String        @id @default(cuid())
  scheduleId         String
  schedule           ClassSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  date               DateTime      @db.Date
  leadTeacherId      String?
  assistantTeacherId String?
  updatedById        String
  updatedAt          DateTime      @updatedAt

  @@unique([scheduleId, date])
}

// ============ Багшийн долоо хоногийн ажлын өдрийн бүртгэл ============
// Багш бүр өөрийн гэсэн ажлын өдрийн хэв маягтай (ж: Даваа/Мягмар ирдэггүй)
// — энэ нь ClassSchedule-ээс тусдаа, зөвхөн "энэ багш тухайн өдөр
// төвд ирдэг эсэх"-ийг илэрхийлнэ.
model TeacherWorkDay {
  id        String  @id @default(cuid())
  teacherId String
  teacher   User    @relation("TeacherWorkDayTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  weekday   Int // 0=Ням … 6=Бямба
  // Төвийн хүснэгт СОНДГОЙ/ТЭГШ 7 хоногоор ээлжилдэг (эзэн 2026-10-11):
  // 0 = 7 хоног бүр, 1 = сондгой, 2 = тэгш. 1-р (сондгой) 7 хоног нь
  // 2026-08-31 (Даваа)-аас эхэлнэ — week-resolver.ts `weekParityOf`.
  parity    Int     @default(0)
  // Хүснэгтийн мөрийн дараалал — «Энэ өдөр ажиллах багш» жагсаалтын эрэмбэ.
  sortOrder Int     @default(0)
  note      String?

  @@unique([teacherId, weekday, parity])
}

// Багшийн ажлын өдрийн хүснэгтийн горим ба хүчинтэй хугацаа (ганц мөр, id="default").
// mode: FIXED = 7 хоног бүр ижил (parity 0), ALTERNATING = сондгой/тэгш (1/2).
// validFrom..validTo-гаас гадуурх өдөрт хүснэгт хэрэгжихгүй (онцгой өдөр л).
model TeacherRosterConfig {
  id          String    @id @default("default")
  mode        String    @default("ALTERNATING")
  validFrom   DateTime? @db.Date
  validTo     DateTime? @db.Date
  updatedAt   DateTime  @updatedAt
  updatedById String?
}

// Тухайн ганц огноон дээрх давхардлын override — жирийн бол амардаг өдөр
// нэмэлт ажиллах, эсвэл жирийн ажлын өдөр амрах.
model TeacherWorkException {
  id        String   @id @default(cuid())
  teacherId String
  teacher   User     @relation("TeacherWorkExceptionTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  working   Boolean // true = нэмэлт ажиллана, false = амарна
  note      String?

  @@unique([teacherId, date])
}

// ============ Сургалтын хуанли (Academic Calendar) ============
// Төвөөс тогтоосон амралт/чөлөөт өдрүүд. Идэвхийн heatmap-д амралтын
// өдрийг сурагчийн "алгассан" өдөр гэж ХЭЗЭЭ Ч харуулж болохгүй — тэр
// шударга байдлыг л энэ хүснэгт хангана.
enum CalendarDayType {
  HOLIDAY
  BREAK
  EXAM_DAY
  SPECIAL
  NO_CLASS
}

model AcademicCalendarDay {
  id          String          @id @default(cuid())
  // Нэг өдөр хэд хэдэн бичлэгтэй байж болно (өөр өөр ангид) — давхцлыг
  // сервис шалгана. classrooms хоосон = БҮХ анги хамаарна.
  date        DateTime        @db.Date
  type        CalendarDayType
  title       String
  note        String?
  createdById String
  createdAt   DateTime        @default(now())

  classrooms AcademicCalendarDayClassroom[]

  @@index([date])
}

// Онцгой өдөр (амралт/шалгалт) аль ангид хамаарахыг заана. Мөр байхгүй бол
// тухайн өдөр БҮХ ангид хамаарна.
model AcademicCalendarDayClassroom {
  calendarDayId String
  classroomId   String
  calendarDay   AcademicCalendarDay @relation(fields: [calendarDayId], references: [id], onDelete: Cascade)
  classroom     Classroom           @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@id([calendarDayId, classroomId])
  @@index([classroomId])
}

// ============ Сурагчийн зорилго (Student Goals) ============
// Ажилтны төлөвлөгчийн сурагч талын хувилбар — сурагч өөрөө богино
// хугацааны зорилго тавьж, явцаа TaskStatus-оор ажиглана.
model StudentGoal {
  id          String     @id @default(cuid())
  studentId   String
  student     User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title       String
  description String?
  targetDate  DateTime?
  status      TaskStatus @default(PLANNED)
  subject     Subject?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([studentId, status])
}

// ============ Стрийк хамгаалалт (Streak Freeze) ============
// Хүндэтгэх шалтгаантай (өвчтэй, айлын хэрэгтэй гэх мэт) тасалдалд
// сурагчийн стрийкийг хамгаална — стрийк тасрахад сурагч сургалтаа
// орхидог (churn) гэдгийг дата харуулсан тул үүнийг бууруулах зорилготой.
model StreakFreeze {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  reason    String?
  createdAt DateTime @default(now())

  @@unique([studentId, date])
}

// ============================================================================
// Google OAuth (authorization code flow, сервер талд).
//
// Урсгал: вэб → GET /auth/google/url (эсвэл POST /auth/google/link) → Google →
// GET /auth/google/callback (state шалгана, code-ыг токеноор солино, id_token-ийг
// шалгана) → вэб /auth/google?code=<нэг удаагийн> → POST /auth/google/exchange →
// JWT. Нууц утгуудын зөвхөн SHA-256 хэшийг хадгална.
// ============================================================================

enum GoogleOAuthPurpose {
  LOGIN
  LINK
}

model GoogleIdentity {
  id            String   @id @default(cuid())
  userId        String   @unique
  googleSubject String   @unique // id_token-ийн `sub` — имэйл солигдсон ч тогтвортой
  email         String
  pictureUrl    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GoogleOAuthState {
  id         String             @id @default(cuid())
  stateHash  String             @unique
  purpose    GoogleOAuthPurpose
  userId     String? // LINK үед холбох хэрэглэгч
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime           @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model GoogleLoginExchange {
  id         String    @id @default(cuid())
  codeHash   String    @unique
  userId     String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

// ============================================================================
// Байршуулсан файлын байнгын хуулбар (G05, 2026-09-27).
// Render-ийн үнэгүй багцын диск deploy бүрт устдаг — файлыг ӨС-д (Supabase,
// үнэгүй) давхар хадгалж, диск дээр байхгүй бол эндээс сэргээж үйлчилнэ.
// Диск нь кэш, энэ хүснэгт нь эх сурвалж. 25MB хүртэл (upload-ийн хязгаар).
// ============================================================================
model StoredFile {
  ownerId   String? // legacy ownerless files require reference authorization
  key       String   @id // uploads-ийн key (uuid.ext)
  mime      String
  size      Int
  bytes     Bytes? // зөвхөн storage="db" үед; S3-ийн файлд null
  storage   String   @default("db") // db | s3 — байт хаана байгаа
  pages     Int? // PDF-ийн хуудасны тоо (байршуулахад тоолно, зураг = null)
  expiresAt DateTime? // хадгалах хугацаа дуусах (гэрийн даалгавар 7 хоног), null = байнга
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// T10: six success stages; unseen is represented by no row.
model FormulaReview {
  userId String
  formulaId String
  box Int @default(0)
  dueAt DateTime
  lastResult String?
  streak Int @default(0)
  reviewCount Int @default(0)
  lapses Int @default(0)
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  formula Formula @relation(fields: [formulaId], references: [id], onDelete: Cascade)
  @@id([userId, formulaId])
  @@index([userId, dueAt])
}

model FormulaReviewDay {
  userId String
  day DateTime @db.Date
  count Int @default(0)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([userId, day])
}

// One signed exercise may be recorded once. Same-answer retries return its receipt.
model FormulaReviewAttempt {
  userId String
  exerciseId String
  formulaId String
  fingerprint String
  response Json
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  formula Formula @relation(fields: [formulaId], references: [id], onDelete: Cascade)
  @@id([userId, exerciseId])
  @@index([formulaId])
}

// Owner-visible bug reports and suggestions; administrators triage safely.
model Feedback {
  id              String   @id @default(cuid())
  authorId        String
  author          User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  clientRequestId String
  kind            String
  subject         String
  body            String
  contextPath     String?
  attachmentKeys  String[] @default([])
  state           String   @default("OPEN")
  response        String?
  respondedById   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([authorId, clientRequestId])
  @@index([state, createdAt])
}

// Teacher-issued approximate class dismissal; never individual GPS/departure proof.
model ClassDismissal {
  id            String    @id @default(cuid())
  classroomId   String
  classroom     Classroom @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  date          DateTime  @db.Date
  approximateAt DateTime
  lastLeftAt    DateTime?
  issuedById    String
  note          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([classroomId, date])
  @@index([date])
}

// Class/day teaching packet links theory, in-class work, homework and absent-pupil makeup.
model LessonPacket {
  id                   String @id @default(cuid())
  classroomId          String
  classroom            Classroom @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  date                 DateTime @db.Date
  chapterId            String
  chapter              Chapter @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  theoryBlockIds       String[]
  testSessionId        String?
  homeworkAssignmentId String?
  makeupTestId         String?
  createdById          String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  receipts             LessonReceipt[]
  photoTurn            LessonPhotoTurn?
  @@unique([classroomId, date])
}
// Append-only evidence receipts; revisions remain distinguishable and auditable.
model LessonReceipt {
  id              String @id @default(cuid())
  packetId        String
  packet          LessonPacket @relation(fields: [packetId], references: [id], onDelete: Restrict)
  studentId       String
  kind            String
  imageKeys       String[]
  clientRequestId String
  submittedAt     DateTime @default(now())
  @@unique([packetId, studentId, kind, clientRequestId])
  @@index([packetId, kind, submittedAt])
}
model LessonPhotoTurn {
  id           String @id @default(cuid())
  packetId     String @unique
  packet       LessonPacket @relation(fields: [packetId], references: [id], onDelete: Restrict)
  studentId    String
  reason       String
  assignedById String?
  createdAt    DateTime @default(now())
}
model LessonRotation {
  classroomId      String @id
  classroom        Classroom @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  cursorStudentId  String?
  pendingStudentIds String[] @default([])
  servedStudentIds String[] @default([])
  cycle            Int @default(0)
  updatedAt        DateTime @updatedAt
}

// Named privileged actions granted by stable user ID. Empty scope means global.
// Grants are revoked in place; an audit snapshot keeps every change.
model StaffCapabilityGrant {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  capability  String
  scopeKey    String   @default("")
  grantedById String
  reason      String
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, capability, scopeKey])
  @@index([userId, revokedAt, expiresAt])
}


// Self-selected reviews are independent of official TestResults and rankings.
enum StudyReviewStatus {
  OPEN
  SUBMITTED
  EXPIRED
}

model StudyReviewRun {
  id                    String @id @default(cuid())
  userId                String
  user                  User @relation(fields: [userId], references: [id], onDelete: Restrict)
  clientRequestId       String
  normalizedRequestHash String
  budgetMinutes         Int
  requestedChapterIds   String[]
  status                StudyReviewStatus @default(OPEN)
  startedAt             DateTime
  deadlineAt            DateTime
  submittedAt           DateTime?
  selectionVersion      String
  seed                  Int
  createdAt             DateTime @default(now())
  items                 StudyReviewItem[]

  @@unique([userId, clientRequestId])
  @@index([userId, startedAt])
}

model StudyReviewItem {
  id                   String @id @default(cuid())
  runId                String
  run                  StudyReviewRun @relation(fields: [runId], references: [id], onDelete: Restrict)
  problemId            String
  problem              Problem @relation(fields: [problemId], references: [id], onDelete: Restrict)
  order                Int
  // Only the safe source projection may leave the API before submission.
  sourceSnapshot       Json
  gradeSnapshot        Json
  gradingVersion       String
  eligibilityAtStart   String
  exposureBeforeFirst  Boolean @default(false)
  firstRecordedAt      DateTime?
  immutableFirstAnswer Json?
  immutableFirstFlags  String[] @default([])
  immutableFirstCorrect Boolean?
  responses            StudyReviewResponse[]

  @@unique([runId, order])
  @@unique([runId, problemId])
  @@index([problemId])
}

model StudyReviewResponse {
  id              String @id @default(cuid())
  itemId          String
  item            StudyReviewItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  userId          String
  user            User @relation(fields: [userId], references: [id], onDelete: Restrict)
  clientRequestId String
  requestHash     String
  kind            String
  answer          Json
  flags           String[] @default([])
  correct         Boolean?
  occurredAt      DateTime @default(now())
  assistance      Boolean @default(false)

  @@unique([itemId, userId, clientRequestId])
  @@index([userId, occurredAt])
}

// ============ Батлагдсан хичээлийн түүх (эзэн 2026-10-08) ============
// Өдрийн хичээл дууссаны дараа багш «Батлах» дарахад тухайн хуваарь+огнооны
// бодит баримтыг (сэдэв, ахлах/туслах багш, тест, ирц) ХУУЛБАРЛАЖ хадгална —
// дараа нь хуваарь/нэр засагдсан ч түүх өөрчлөгдөхгүй. Хуваарь/анги устсан ч
// түүх үлдэх ёстой тул FK-гүй (LessonStaffing-ийн мөрийн id конвенц).
model LessonRecord {
  id                   String   @id @default(cuid())
  scheduleId           String
  classroomId          String
  date                 DateTime @db.Date
  classroomName        String
  startMinute          Int
  endMinute            Int
  room                 String?
  topic                String?
  leadTeacherId        String?
  leadTeacherName      String?
  assistantTeacherId   String?
  assistantTeacherName String?
  // [{ id, testId, title }] — тухайн өдөр анги хийсэн тест (ClassTestSession)
  tests                Json     @default("[]")
  testCount            Int      @default(0)
  // Батлахад багшийн бичсэн чөлөөт тайлбар (эзэн 2026-10-27)
  description          String?
  // Бодсон бодлогын дугаар — багшийн бичсэнээр («1-12, 15, 20»)
  problemNumbersText   String?
  // Дээрхийг задалсан тоон жагсаалт (задалж чадаагүй бол хоосон)
  problemNumbers       Int[]    @default([])
  enrolledCount        Int      @default(0)
  presentCount         Int      @default(0)
  absentCount          Int      @default(0)
  attendanceMarked     Int      @default(0)
  confirmedById        String
  confirmedByName      String
  confirmedAt          DateTime @default(now())
  updatedAt            DateTime @updatedAt
  // «Батламж цуцлах» ЗӨӨЛӨН (эзэн 2026-10-23 дүрэм): мөр, сурагчид DB-д үлдэнэ;
  // cancelledAt-тэй мөр ямар ч уншилтад орохгүй. Дахин батлахад энэ мөрийг
  // сэргээнэ (@@unique [scheduleId, date]), өмнөх утга AuditLog-д.
  cancelledAt          DateTime?
  cancelledById        String?

  students LessonRecordStudent[]

  @@unique([scheduleId, date])
  @@index([classroomId, date])
  @@index([date])
}

// Тухайн өдөр ангид элссэн байсан сурагч бүр — «энэ хүүхэд энэ өдөр энэ
// хичээлийг хийсэн» сургалтын мөчлөгийн түүх. attendance = Attendance.status
// (тэмдэглээгүй бол null).
model LessonRecordStudent {
  id          String       @id @default(cuid())
  recordId    String
  record      LessonRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  studentId   String
  studentName String
  attendance  String?
  // Дахин батлахад snapshot-оос гарсан сурагч — устгахгүй, removedAt бөглөнө
  removedAt   DateTime?

  @@unique([recordId, studentId])
  @@index([studentId])
}

// Багшийн нэмэлт тайлбар — ЗӨВХӨН ажилтанд. Сурагч/эцэг эхэд хэзээ ч
// буцаахгүй (lesson-records модуль л уншина). Хоосолбол мөр устахгүй —
// deletedAt бөглөгдөж (body хэвээр), уншилтаас хасагдана.
model LessonNote {
  id            String    @id @default(cuid())
  scheduleId    String
  date          DateTime  @db.Date
  body          String    @db.VarChar(500)
  updatedById   String
  updatedByName String
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  deletedById   String?

  @@unique([scheduleId, date])
}

// Сурагчийн зан төлөвийн шошго (эзэн 2026-10-13, «Анги» самбар): «Буудаж
// боддог», «Хуулдаг», «Анхаарал», «Сайжирсан» гэх мэт. Багш бүр нэмж/хасна,
// ТҮҮХ ХАДГАЛАГДАНА — хасахад мөр устахгүй, removedAt бөглөгдөнө. kind нь
// чөлөөт мөр (жагсаалт нь class-dashboard/behavior-flags.ts-д) — шинэ төрөл
// нэмэхэд миграци хэрэггүй. LessonRecord-ийн адил FK-гүй (түүх найдвартай).
model StudentBehaviorFlag {
  id            String    @id @default(cuid())
  studentId     String
  classroomId   String?
  kind          String    @db.VarChar(40)
  note          String?   @db.VarChar(300)
  createdById   String
  createdByName String
  createdAt     DateTime  @default(now())
  removedAt     DateTime?
  removedById   String?
  removedByName String?
  removeNote    String?   @db.VarChar(300)

  @@index([studentId, removedAt])
  @@index([classroomId, removedAt])
}

// ============ «Дотоод» ноорог (эзэн 2026-10-13) ============
// Ажилтан бодлогыг НИЙТЛЭХЭЭС ӨМНӨ бичиж, бодож, засна (web /app/internal,
// api/src/internal-drafts). Problem/Test-ийг ноорогоор бохирдуулахгүйн тулд
// тусдаа хүснэгт: нийтлэх үед л Problem (+Test) үүснэ. Сурагч, эцэг эхэд ХЭЗЭЭ Ч
// харагдахгүй — зөвхөн Багш+/Админ. User-т FK-гүй, нэрийг хадгална
// (StudentBehaviorFlag-ийн адил — түүх найдвартай).
model DraftSet {
  id              String       @id @default(cuid())
  title           String       @db.VarChar(200)
  subject         Subject      @default(MATH)
  // Нийтлэх бүлгийн шошго (заавал биш) — нийтлэх цонхонд урьдчилан сонгогдоно
  chapterId       String?
  topic           String?      @db.VarChar(120)
  createdById     String
  createdByName   String
  updatedById     String
  updatedByName   String
  createdAt       DateTime     @default(now())
  // Блокийн засвар ч энэ огноог шинэчилнэ (жагсаалтын «сүүлд зассан»)
  updatedAt       DateTime     @default(now())
  publishCount    Int          @default(0)
  publishedAt     DateTime?
  publishedTestId String?
  deletedAt       DateTime?
  blocks          DraftBlock[]

  @@index([deletedAt, updatedAt])
}

// Нэг бодлого = нэг блок. kind: CHOICE (A–E) | NUMERIC (тоон хариу).
// answer: CHOICE-д үсэг ("B"), NUMERIC-т утга ("12.5"). Сонголтын текст бүгд
// хоосон бол сонголт зурагт байна гэж үзнэ (нийтлэхэд үсгээр дүгнэнэ).
model DraftBlock {
  id                 String   @id @default(cuid())
  setId              String
  set                DraftSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  order              Int
  kind               String   @default("CHOICE") @db.VarChar(16)
  statement          String   @default("")
  choices            String[] @default([])
  answer             String?  @db.VarChar(100)
  solution           String?
  imageKey           String?
  tag                String?  @db.VarChar(120)
  points             Int      @default(1)
  // Зэрэг засвар: хадгалах бүрд +1, хуучин хувилбараас хадгалбал 409
  version            Int      @default(0)
  publishedProblemId String?
  updatedById        String
  updatedByName      String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now())

  @@index([setId, order])
  @@index([imageKey])
}

// Хэн юуг өөрчилсөн — ноорогийн түүх (автосейв нэг хүний нэг блок дээр 10 мин
// дотор нэг мөрөнд нэгтгэгдэнэ). Нийтлэх/устгах нь AuditLog-д давхар бичигдэнэ.
model DraftEvent {
  id        String   @id @default(cuid())
  setId     String
  blockId   String?
  actorId   String
  actorName String
  action    String   @db.VarChar(32)
  summary   String   @db.VarChar(300)
  at        DateTime @default(now())

  @@index([setId, at])
}

// Түвшин тогтоох шалгалт (нийтэд нээлттэй, нэвтрэлтгүй). Хүүхэд мэдээллээ
// бөглөөд цагтай тест бодно, бодлого бүрийн бодолтын ЗУРГИЙГ илгээнэ; багш
// зургийг харж түвшинг тогтоогоод холбогдоно. Бодлого ба хариуны түлхүүр нь
// кодонд (api/src/placement/placement-tests.ts), энд зөвхөн хүүхдийн өгөгдөл.
enum PlacementStatus {
  NEW
  REVIEWED
  CONTACTED
}

model PlacementAttempt {
  id            String          @id @default(cuid())
  /// Зочны эрхийн нууц түлхүүрийн sha256 (түлхүүр өөрөө хадгалагдахгүй)
  secretHash    String
  testKey       String
  /// Эхлэх үеийн бодлогууд (хариутай) — тест засагдсан ч дүн өөрчлөгдөхгүй
  testSnapshot  Json?
  name          String
  phone         String
  grade         Int
  school        String?
  parentPhone   String?
  /// { "1": "E", "10": { "a": "6", ... } }
  answers       Json            @default("{}")
  /// { "1": ["uuid.jpg"] } — бодлого бүрийн бодолтын зураг
  photos        Json            @default("{}")
  /// photos-ийн бүх key — файлын эрх шалгахад (`has`)
  photoKeys     String[]        @default([])
  autoScore     Int?
  maxScore      Int?
  startedAt     DateTime        @default(now())
  deadlineAt    DateTime
  submittedAt   DateTime?
  autoSubmitted Boolean         @default(false)
  status        PlacementStatus @default(NEW)
  level         String?
  teacherNote   String?
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([status, createdAt])
  @@index([phone])
}

// Түвшин тогтоох шалгалтын агуулга — «Удирдлага»-аас засварлана. Анхны агуулга
// api/src/placement/placement-tests.ts (эзний PDF). problems = PlacementProblem[]
model PlacementTestConfig {
  key          String   @id
  title        String
  minutes      Int
  instructions String?
  problems     Json
  updatedById  String?
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
}

// Долоо хоног бүрийн онлайн ЖИШИГ СОРИЛ (эзэн 2026-10-14). Нийтэд цаг, бүртгэлийн
// тоо харагдана; бүртгүүлэхэд нэвтэрсэн STUDENT/BUYER байх ёстой. Цонхны
// (startsAt..endsAt) дотор бүртгүүлсэн хэрэглэгч тестэд assertStudentAccess-ээр
// нэвтэрнэ; шалгалтын хугацааг Test.timeLimitMin тогтооно.
model MockExamEvent {
  id            String                 @id @default(cuid())
  title         String
  testId        String
  test          Test                   @relation(fields: [testId], references: [id])
  startsAt      DateTime
  /// Шалгалтыг эхлүүлж болох сүүлийн мөч (хоцорч орох зөвшөөрөл)
  endsAt        DateTime
  note          String?
  published     Boolean                @default(true)
  createdById   String
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  registrations MockExamRegistration[]

  @@index([startsAt])
  @@index([testId])
}

model MockExamRegistration {
  id        String        @id @default(cuid())
  eventId   String
  event     MockExamEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([eventId, userId])
  @@index([userId])
}

/// Ангид тест «хассан» (эзэн 2026-10-18): REMOVED = энэ ангид дахиж санал болгохгүй.
/// «Хийсэн» = ClassTestSession, «үлдсэн» (алгассан) = номын дарааллаас тооцоолно — энд хадгалахгүй.
model ClassTestStatus {
  id          String   @id @default(cuid())
  classroomId String
  testId      String
  status      String
  note        String?
  updatedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([classroomId, testId])
  @@index([classroomId])
}

/// «Өмнө үзсэн сэдэв» (эзэн 2026-10-27): систем эхлэхээс ӨМНӨ анги үзсэн тестийг
/// ОГНООГҮЙгээр тэмдэглэнэ. Огноотой (өдрийн хичээлээр батлагдсан) үзсэн тест нь
/// ClassTestSession-д — ангийн түүх = ClassTestSession (огноотой) ∪ энэ (огноогүй).
/// Хасах нь ЗӨӨЛӨН: removedAt тавина, мөр устахгүй; дахин тэмдэглэвэл removedAt-г
/// цэвэрлэнэ. Өөрчлөлт бүр AuditLog-д (entity «ClassCoveredTest», entityId = анги).
/// classroomId/testId/chapterId — plain string (LessonTopic-ийн адил, тест устсан ч мөр үлдэнэ).
model ClassCoveredTest {
  id          String    @id @default(cuid())
  classroomId String
  testId      String
  // Тэмдэглэх үеийн бүлэг (snapshot) — бүлгээр нь нэгтгэхэд
  chapterId   String?
  // «PAST» = өмнө үзсэн (огноогүй). Ирээдүйд өөр огноогүй эх сурвалж нэмэгдэж болно.
  source      String    @default("PAST")
  createdById String
  createdAt   DateTime  @default(now())
  updatedById String?
  updatedAt   DateTime?
  removedAt   DateTime?
  removedById String?

  @@unique([classroomId, testId])
  @@index([classroomId, removedAt])
  @@index([testId])
}

/// Онолын зураг (эзэн 2026-10-18): тухайн өдрийн хичээлийн онолыг томилогдсон сурагч
/// илгээнэ; тэр өдрийн тестүүдэд (testIds) холбогдож хадгалагдана — хэдэн сарын
/// дараа ч тухайн тестийн онолын зургийг олно. Ангийн сурагчид, багш нар харна.
model LessonPhoto {
  id          String   @id @default(cuid())
  classroomId String
  date        DateTime @db.Date
  studentId   String
  imageKeys   String[] @default([])
  testIds     String[] @default([])
  createdAt   DateTime @default(now())

  @@index([classroomId, date])
  @@index([studentId])
}

/// Нөхөх хичээл (эзэн 2026-10-18): тасалсан/чөлөөтэй/хоцорсон сурагч тухайн өдрийн
/// хичээлийг нөхөнө — тэмдэглэлийн зургаа илгээж, тестийн A, B хувилбарыг
/// шалгалтын горимоор хийнэ (ангид A хийсэн бол A тооцогдоно). Үүрэг нь ирц +
/// ClassTestSession-оос тооцоологдоно; энд зөвхөн илгээсэн зураг ба багшийн баталгаа.
model LessonMakeup {
  id            String    @id @default(cuid())
  classroomId   String
  studentId     String
  date          DateTime  @db.Date
  imageKeys     String[]  @default([])
  submittedAt   DateTime?
  confirmedById String?
  confirmedAt   DateTime?
  note          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([studentId, classroomId, date])
  @@index([classroomId, date])
}

/// «Чек» — ангийн нэртэй шалгах жагсаалт (эзэн 2026-10-22): «Номны мөнгө 25,000₮»
/// гэх мэт. Багш бүр (ADMIN/TEACHER_PLUS/TEACHER) нээж, сурагч бүрийг +/− тэмдэглэнэ.
/// Хаах нь зөөлөн (archivedAt) — түүх үлдэнэ. api/src/class-checks.
/// classroomId → Classroom FK (ON DELETE CASCADE) нь ЗӨВХӨН SQL-д (миграци
/// 20261022002000_class_checks): Classroom model-д буцах талбар нэмэхгүйн тулд
/// Prisma relation-гүй. Хэрэглэгчийн id-ууд FK-гүй (StudentBehaviorFlag-ийн адил).
model ClassCheck {
  id           String           @id @default(cuid())
  classroomId  String
  title        String           @db.VarChar(80)
  /// Нэг сурагчийн мөнгөн дүн (₮), заавал биш
  amount       Int?
  createdById  String
  createdAt    DateTime         @default(now())
  archivedAt   DateTime?
  archivedById String?
  /// Зөөлөн устгал (эзэн 2026-10-23: өгөгдөл алга болохгүй) — жагсаалтаас нуугдана, DB-д үлдэнэ
  deletedAt    DateTime?
  deletedById  String?
  marks        ClassCheckMark[]

  @@index([classroomId, archivedAt])
}

/// Сурагч тус бүрийн тэмдэглэгээ — (checkId, studentId) давхардахгүй тул хоёр багш
/// зэрэг дарсан ч upsert нэг мөрөнд бичнэ. studentId → User FK нь SQL-д (CASCADE).
model ClassCheckMark {
  id          String     @id @default(cuid())
  checkId     String
  check       ClassCheck @relation(fields: [checkId], references: [id], onDelete: Cascade)
  studentId   String
  checked     Boolean    @default(false)
  updatedById String
  updatedAt   DateTime   @updatedAt

  @@unique([checkId, studentId])
  @@index([studentId])
}

/// Нэвтрэх хуудасны тайлбар/зарлал (эзэн 2026-10-22, Агент D). Ганц мөр id="default";
/// зөвхөн ADMIN засна (PUT /auth/login-text), нийтэд уншигдана (GET). Энгийн текст.
model LoginText {
  id          String   @id @default("default")
  body        String   @default("")
  updatedById String?
  updatedAt   DateTime @updatedAt
}

// ── Google Sheet синк (эзэн 2026-10-27) ──────────────────────────────────────
// «2027 оны төлбөрийн мэдээлэл» шийтийг 5 минут тутам уншина (шийт → вэб, нэг
// чиглэл). ЮУ Ч УСТГАХГҮЙ: шийтээс мөр алга болбол goneAt, өөрчлөгдвөл өмнөх
// хувилбар SheetRowVersion-д үлдэнэ, зөрүү SheetIssue-д (арилмагц resolvedAt).
model SheetSyncRun {
  id         String    @id @default(cuid())
  trigger    String // CRON | MANUAL
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean   @default(false)
  skipped    Boolean   @default(false) // шийт өөрчлөгдөөгүй — бичилт хийгээгүй
  hash       String? // уншсан утгын хэш (өөрчлөлт илрүүлэх)
  stats      Json?
  error      String?

  @@index([startedAt])
}

model SheetRow {
  id          String            @id @default(cuid())
  tab         String
  rowKey      String // нэр + утас (эрэмбэлэхэд мөрийн дугаар өөрчлөгддөг)
  rowNumber   Int
  hash        String
  cells       Json // { A: …, B: … } — хоосон биш нүднүүд
  studentId   String?
  matchBy     String?
  firstSeenAt DateTime          @default(now())
  lastSeenAt  DateTime          @default(now())
  changedAt   DateTime          @default(now())
  goneAt      DateTime?
  versions    SheetRowVersion[]

  @@unique([tab, rowKey])
  @@index([studentId])
}

model SheetRowVersion {
  id         String   @id @default(cuid())
  sheetRowId String
  sheetRow   SheetRow @relation(fields: [sheetRowId], references: [id], onDelete: Restrict)
  hash       String
  cells      Json
  seenAt     DateTime @default(now())

  @@index([sheetRowId, seenAt])
}

model SheetIssue {
  id          String    @id @default(cuid())
  fingerprint String    @unique
  kind        String
  severity    String // ERROR | WARN | INFO
  tab         String?
  rowNumber   Int?
  studentId   String?
  title       String
  detail      Json?
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([resolvedAt, severity])
  @@index([studentId])
}

// Шийтээс орсон гүйлгээ ↔ шийтийн нүд (`main|2026-09`). Payment-д хүрэхгүй
// (FK-гүй) — гүйлгээ хэзээ ч устдаггүй тул холбоос найдвартай.
model SheetPayment {
  paymentId String   @id
  studentId String
  cell      String
  createdAt DateTime @default(now())

  @@index([studentId, cell])
}
