generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ============ Хэрэглэгчид ============

enum Role {
  ADMIN
  TEACHER_PLUS
  TEACHER
  STUDENT
  PARENT
  BUYER
}

enum StudentType {
  CLASSROOM // танхимын сурагч
  ONLINE
}

model User {
  id                 String    @id @default(cuid())
  // Нэвтрэх түлхүүрүүд: утас, имэйл (gmail), эсвэл username — аль нэгээр нэвтэрнэ.
  // Утсыг сонголттой болгосон тул зөвхөн имэйлээр ч бүртгүүлж болно.
  phone              String?   @unique
  email              String?   @unique
  username           String?   @unique // нийтэд харагдах нэр (овог нэр эсвэл өөрийн nickname)
  studentCode        String?   @unique // сурагчийн дотоод код (дугаараас тусдаа)
  teacherCode        String?   @unique // багшийн дотоод код (дугаараас тусдаа)
  firstName          String
  lastName           String
  passwordHash       String
  // Дараагийн нэвтрэлтээр нууц үг СОЛИУЛАХ шаардлагатай эсэх. Одоогоор ХААЛТТАЙ
  // (@default(false)) — эзэн байнга турших тул саад болохгүй. Ирээдүйд идэвхжүүлэхэд
  // энэ талбарыг create үед true болгоод/эсвэл эндхийн default-ыг true болговол хангалттай.
  mustChangePassword Boolean   @default(false)
  // Нууц үг ХАМГИЙН СҮҮЛД солигдсон мөч. JwtStrategy энэ мөчийг токены `iat`-тай
  // харьцуулж, түүнээс ӨМНӨ олгогдсон бүх токеныг хүчингүйд тооцно. Ингэснээр
  // нууц үгээ сэргээхэд хулгайлагдсан сесс автоматаар тасарна — сэргээлтийн
  // гол утга учир нь энэ (эс бөгөөс халдагч хуучин токеноороо орсоор байна).
  passwordChangedAt  DateTime?
  role               Role
  avatarUrl          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  studentProfile         StudentProfile?
  teacherProfile         TeacherProfile?
  externalTeacherProfile ExternalTeacherProfile?

  parentLinks             ParentLink[]         @relation("ParentSide")
  childLinks              ParentLink[]         @relation("ChildSide")
  teacherGroups           TeacherGroup[]       @relation("TeacherGroupOwner")
  teacherGroupMemberships TeacherGroupMember[]
  payments                Payment[]
  userPasses              UserPass[]
  attempts                Attempt[]
  attendances             Attendance[]         @relation("AttendanceStudent")
  submissions             Submission[]
  dailyHomeworkMarks      DailyHomeworkMark[]  @relation("DailyHomeworkMarkStudent")
  testResults             TestResult[]
  predictions             Prediction[]
  colorTags               StudentColorTag[]    @relation("TaggedStudent")
  ownedClassrooms         Classroom[]          @relation("ClassroomTeacher")
  enrollments             Enrollment[]
  attemptSessions         TestAttemptSession[]
  learningEvents          LearningEvent[]

  // Wave 3: ажилтны төлөвлөгч / хуваарь / сурагчийн зорилго / стрийк
  createdStaffTasks     StaffTask[]
  staffTaskAssignments  StaffTaskAssignee[]
  taughtSchedules       ClassSchedule[]
  studentGoals          StudentGoal[]
  streakFreezes         StreakFreeze[]
  teacherWorkDays       TeacherWorkDay[]       @relation("TeacherWorkDayTeacher")
  teacherWorkExceptions TeacherWorkException[] @relation("TeacherWorkExceptionTeacher")

  // Эцсийн долгион: сурагчийн тэмдэглэл
  studentNotes StudentNote[]

  // Төлбөрийн буцаалт — эзэмшлийн гурван шуу: сурагч + үүсгэгч + баталгаажуулагч
  tuitionRefundsAsStudent TuitionRefund[] @relation("StudentTuitionRefunds")
  createdTuitionRefunds   TuitionRefund[] @relation("TuitionRefundCreatedBy")
  approvedTuitionRefunds  TuitionRefund[] @relation("TuitionRefundApprovedBy")
  paidTuitionRefunds      TuitionRefund[] @relation("TuitionRefundPaidBy")
  cancelledTuitionRefunds TuitionRefund[] @relation("TuitionRefundCancelledBy")

  // Худалдан авалтууд
  purchases Purchase[]

  passwordResetTokens PasswordResetToken[]

  // SMS: бүртгэл, загвар, батч
  smsMessagesAsRecipient SmsMessage[]      @relation("SmsMessageRecipient")
  smsMessagesAsCreator   SmsMessage[]      @relation("SmsMessageCreatedBy")
  smsBatches             SmsBatch[]        @relation("SmsBatchCreatedBy")
  smsTemplates           SmsTemplate[]     @relation("SmsTemplateCreatedBy")
}

// ============ Нууц үг сэргээлт ============

enum NotifyChannel {
  SMS
  EMAIL
}

// ============ SMS Бүртгэл & Шалгалт (SMS Logging & Audit) ============

/**
 * SMS илгээлтийн статус — хүсэлтийг системэд хүлээлгэе (QUEUED), илгээлээ (SENT),
 * алдаа байлаа (FAILED), эсвэл цуцалсан (CANCELLED).
 */
enum SmsStatus {
  QUEUED
  SENT
  FAILED
  CANCELLED
}

/**
 * SMS мессежийн төрөл — юугаар илгээснийг ангилна, ингэснээр:
 * • Ирээдүйд загвар (SmsTemplate)-аар дахин ашиглах
 * • Сурагч/эзэн өөр өөр төрлийг дахиулах давтамжаа сонгох
 * • Аналитик: "нууц үг сэргээлтийн SMS хэдий хэмжээний хариу авсан"
 */
enum SmsKind {
  PASSWORD_RESET
  ANNOUNCEMENT
  PAYMENT_REMINDER
  ATTENDANCE
  EXAM
  MANUAL
  OTHER
}

/**
 * Бөөн SMS илгээлтийн статус — DRAFT үед сурагчдыг сонгож байж болно,
 * SENDING үед горим идэвхтэй (цуцлах боломжтой), DONE үед дууссан.
 */
enum SmsBatchStatus {
  DRAFT
  SENDING
  DONE
  CANCELLED
}

/**
 * Нэг удаагийн нууц үг сэргээх код.
 * ЯАГААД КОДЫГ ЭНД ХАДГАЛААГҮЙ ВЭ: `codeHash` нь серверийн нууц түлхүүрээр
 * (RESET_TOKEN_SECRET) хийсэн HMAC-SHA256. Ингэснээр өгөгдлийн сан бүхэлдээ
 * алдагдсан ч тэр түлхүүргүйгээр 6 оронтой кодыг сэргээж БОЛОХГҮЙ. Энгийн
 * SHA-256 бол 6 оронтой код дээр сая хүрэхгүй хувилбартай тул шууд эвдэгдэнэ.
 * `attempts` нь буруу оролдлогыг тоолж, тодорхой тооноос хэтэрвэл кодыг үхүүлнэ
 * (брутфорсоос хамгаална). `consumedAt` нь нэг удаагийн байдлыг баталгаажуулна.
 */
model PasswordResetToken {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash     String
  channel      NotifyChannel @default(SMS)
  /// Хаана илгээснийг харуулах МАСКЛАСАН хаяг (жишээ нь "8033****"). Бүтэн
  /// дугаарыг энд давхардуулж хадгалахгүй — User дээр аль хэдийн байгаа.
  sentToMasked String
  expiresAt    DateTime
  consumedAt   DateTime?
  attempts     Int           @default(0)
  /// Хүсэлт ирсэн IP — хэт олон хүсэлтийг мөрдөх, аудитад ашиглана.
  requestIp    String?
  createdAt    DateTime      @default(now())

  // Хэрэглэгчийн хамгийн сүүлийн идэвхтэй кодыг олох, мөн цонхон доторх
  // хүсэлтийн тоог тоолоход хоёуланд нь энэ индекс ажиллана.
  @@index([userId, createdAt])
  @@index([expiresAt])
}

/**
 * SMS мессежийн бүртгэл — илгээсэн бүр мессеж бүртгэлийн ленте ходолдна.
 * НУУЦЛАЛ: PASSWORD_RESET төрлийн мессежийн body дээр код БАЙХГҮЙ.
 * Зөвхөн "код илгээсэн" гэсэн үйл явдлыг бүртгэнэ, кодыг хадгалахгүй.
 * Ингэснээр нууцлалын эрсдэл бага байна — өгөгдлийн сан ялгарсан ч
 * хүмүүсийн нууц үгийн код яг сүүлийн үеийн байхгүй болно.
 */
model SmsMessage {
  id          String        @id @default(cuid())
  toPhone     String
  body        String
  status      SmsStatus
  kind        SmsKind
  userId      String?
  user        User?         @relation("SmsMessageRecipient", fields: [userId], references: [id], onDelete: SetNull)
  batchId     String?
  batch       SmsBatch?     @relation(fields: [batchId], references: [id], onDelete: SetNull)
  templateId  String?
  template    SmsTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  provider    String? // console | twilio | http
  providerRef String? // нийлүүлэгчийн месседжийн ID
  error       String? // амжилтгүй болсон шалтгаан
  segments    Int     @default(1) // SMS хэсгийн тоо (1 SMS = 160 символ)
  createdById String
  createdBy   User    @relation("SmsMessageCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  sentAt      DateTime?

  @@index([toPhone])
  @@index([status])
  @@index([batchId])
  @@index([createdAt])
}

/**
 * Бөөн SMS илгээлт — админ эсвэл багш+ дурын ангийн сурагчдад нэгэлгээр
 * мессеж илгээхдээ "батч" үүсгэнэ.
 */
model SmsBatch {
  id          String         @id @default(cuid())
  title       String
  kind        SmsKind
  total       Int // хэдэн хүнийг сонгосон
  sent        Int            @default(0)
  failed      Int            @default(0)
  status      SmsBatchStatus
  createdById String
  createdBy   User           @relation("SmsBatchCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime       @default(now())
  finishedAt  DateTime?

  messages    SmsMessage[]
}

/**
 * SMS загвар — {{name}}, {{amount}} зэрэг орлуулагчтай дахин ашиглах
 * мессежүүд. Админ/Багш+ нь сэтгэл ханамжтай загвар үүсгээд
 * мөн мөн иллүүлэхэд ашигладаг.
 */
model SmsTemplate {
  id          String    @id @default(cuid())
  name        String    @unique
  kind        SmsKind
  body        String // {{name}}, {{amount}} гэх мэт орлуулагчтай байж болно
  active      Boolean   @default(true)
  createdById String
  createdBy   User      @relation("SmsTemplateCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  messages    SmsMessage[]
}

// Жилийн төлбөрийн багц: Excel-ийн бүртгэлд байдаг төлбөрийн нөхцөл.
// UNKNOWN = хуучин импортоос орж ирсэн, төлбөрийн нөхцөл нь бүртгэлд
// тэмдэглэгдээгүй сурагч (дараа нь багш/багш+ гараар тодруулна).
enum TuitionPlan {
  FULL_YEAR
  INSTALLMENT
  MONTHLY
  UNKNOWN
}

model StudentProfile {
  userId         String      @id
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           StudentType
  grade          Int? // 1–12, бүртгүүлэхдээ сонгоно
  school         String?
  // Танхимын сурагч идэвхжүүлэх код (= тухайн өдрийн огноо) оруулсан эсэх
  activatedAt    DateTime?
  activationCode String?

  // Excel-ийн бүртгэлээс ирсэн бодит мэдээлэл (импортоор type/grade/school-оос
  // цааш алдагдаж байсан дата) — гэр бүлийн холбоо барих, байршил, төлбөр.
  fatherPhone   String?
  motherPhone   String?
  guardianNote  String?
  branch        String? // "Баруун 4" | "Зүүн 4"
  section       String? // "12-2" — бүртгэлд тэмдэглэсэн ангийн шошго (label)
  tuitionAmount Int?
  tuitionPlan   TuitionPlan?
  tuitionNote   String?
  joinedOn      DateTime?    @db.Date
  leftOn        DateTime?    @db.Date

  @@index([branch])
  @@index([section])
}

model TeacherProfile {
  userId            String  @id
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Админ олгодог эрх: сурагч нэмэх/хасах/анги солих (зөвхөн TEACHER_PLUS-д утгатай)
  canManageStudents Boolean @default(false)
}

// Гадны багш (манай төвийн бус). Баталгаажаагүй багш сурагчийн мэдээлэл ХАРАХГҮЙ.
model ExternalTeacherProfile {
  userId       String    @id
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization String? // ажилладаг сургууль/төв
  verifiedAt   DateTime? // админ баталгаажуулсан эсэх
  verifiedById String? // ADMIN эсвэл TEACHER_PLUS-ийн ID
  note         String? // админ тайлбар

  @@index([verifiedAt])
}

model ParentLink {
  id           String    @id @default(cuid())
  parentId     String
  parent       User      @relation("ParentSide", fields: [parentId], references: [id], onDelete: Cascade)
  studentId    String
  student      User      @relation("ChildSide", fields: [studentId], references: [id], onDelete: Cascade)
  // Багш+/Админ баталгаажуулсан эсэх
  verifiedAt   DateTime?
  verifiedById String?

  @@unique([parentId, studentId])
}

// ============ Анги ============

enum ClassroomType {
  IN_PERSON
  ONLINE
}

model Classroom {
  id                String        @id @default(cuid())
  name              String
  type              ClassroomType
  grade             Int?
  teacherId         String?
  teacher           User?         @relation("ClassroomTeacher", fields: [teacherId], references: [id])
  archived          Boolean       @default(false)
  createdAt         DateTime      @default(now())
  // Хөтөлбөрийн түгжээний гараар override (Шийдвэр 5). null = ClassTestSession-ээс
  // автоматаар тооцно; багш гараар урагшлуулж/буцаах бол энд Chapter.id тавина.
  progressChapterId String?

  enrollments         Enrollment[]
  attendances         Attendance[]
  assignments         Assignment[]
  testAccess          TestAccess[]
  dailySummaries      DailyClassSummary[]
  announcementTargets AnnouncementClassroomTarget[]
  dailyHomeworkMarks  DailyHomeworkMark[]

  // Wave 3: ажилтны төлөвлөгч / хичээлийн хуваарь
  staffTasks     StaffTask[]
  classSchedules ClassSchedule[]

  // Түнш хөрөнгө — ТӨВИЙН ангийн буцаалт
  tuitionRefunds TuitionRefund[]
}

// ============ Гадны багшийн анги ============

model TeacherGroup {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation("TeacherGroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  joinCode  String   @unique // сурагч кодоор нэгдэнэ
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())

  members TeacherGroupMember[]

  @@index([ownerId, archived])
}

model TeacherGroupMember {
  id        String       @id @default(cuid())
  groupId   String
  group     TeacherGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  studentId String
  student   User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  joinedAt  DateTime     @default(now())
  leftAt    DateTime?

  @@unique([groupId, studentId])
  @@index([studentId])
}

model Enrollment {
  id          String    @id @default(cuid())
  studentId   String
  student     User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  // Орсон өдрөөс хойшхи мэдээлэл л сурагчид харагдана; анги солиход leftAt бөглөгдөж шинэ бичилт үүснэ
  joinedAt    DateTime  @default(now())
  leftAt      DateTime?
  movedById   String?

  @@index([studentId, leftAt])
  @@index([classroomId, leftAt])
}

// ============ Ирц ============

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

// Хоцролтын хугацааны интервал (зөвхөн status=LATE үед утгатай).
// Багш ангийн өмнө зогсоод хурдан сонгох тул сонголтууд цөөхөн, тодорхой.
enum LateRange {
  FIVE_TO_TEN // 5–10 минут
  TEN_TO_THIRTY // 10–30 минут
  THIRTY_TO_SIXTY // 30 минут – 1 цаг
  OVER_ONE_HOUR // 1 цагаас дээш
}

model Attendance {
  id          String           @id @default(cuid())
  classroomId String
  classroom   Classroom        @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  studentId   String
  student     User             @relation("AttendanceStudent", fields: [studentId], references: [id], onDelete: Cascade)
  date        DateTime         @db.Date
  status      AttendanceStatus
  markedById  String
  // Сурагч тус бүрийн өдрийн тайлбар (ж: "Өвчтэй", "Гэрээсээ хожуу гарсан")
  note        String?
  // Хэдий хугацаагаар хоцорсон (зөвхөн status=LATE үед; бусад бүх статуст
  // NULL байх ёстой — mark() service дотор status LATE-ээс өөр болоход
  // автоматаар цэвэрлэгдэнэ). Чөлөөт тайлбар `note`-оос ялгаатайгаар
  // queryable, тайлагдах боломжтой бүтэцтэй утга учир тусдаа enum багана.
  lateRange   LateRange?

  @@unique([classroomId, studentId, date])
  @@index([studentId, date])
}

// ============ Даалгавар ============

enum AssignmentType {
  DAILY
  EXTRA
}

enum SubmissionState {
  NOT_DONE
  SUBMITTED // сурагч илгээсэн, багш хараагүй
  DONE_ONLINE // багш онлайнаар баталгаажуулсан
  DONE_IN_CLASS // багш ангид дэвтрийг биетээр шалгасан
  RETURNED // буцаасан — дахин илгээнэ
}

model Assignment {
  id          String         @id @default(cuid())
  classroomId String
  classroom   Classroom      @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  type        AssignmentType @default(DAILY)
  title       String
  description String?
  imageKeys   String[] // S3 түлхүүрүүд
  dueDate     DateTime?
  createdById String
  createdAt   DateTime       @default(now())

  // Зөөлөн устгал: hard DELETE хийвэл Submission-ы түүхэн бичлэгүүд орфон
  // үлдэнэ. Уншихдаа заавал deletedAt: null гэж шүүнэ.
  deletedAt DateTime?

  submissions Submission[]

  @@index([deletedAt])
}

model Submission {
  id           String          @id @default(cuid())
  assignmentId String
  assignment   Assignment      @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      User            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  state        SubmissionState @default(NOT_DONE)
  imageKeys    String[]
  note         String?
  checkedById  String?
  submittedAt  DateTime?
  checkedAt    DateTime?
  updatedAt    DateTime        @updatedAt

  @@unique([assignmentId, studentId])
  @@index([studentId])
}

// ============ Өдөр тутмын гэрийн даалгаврын тэмдэглэгээ (Daily Homework Marking) ============
// Эзний #1 хүсэлт: багш ангийнхаа гэрийн даалгаврыг өдөр бүр НЭГ ХУРДАН
// тороор (grid) тэмдэглэдэг байх ёстой — Assignment/Submission-ы "багш
// даалгавар үүсгээд сурагч илгээх" урсгалаас ЯЛГААТАЙ, "багш л ангиа хурдан
// нэг өнгөөр дүгнэнэ" гэсэн энгийн урсгал. Тиймээс Submission.state-ийг
// contort хийхгүй (өөр дэлгэцүүд үүнийг ашигладаг), харин тусдаа энгийн
// хүснэгт нэмэв: анги+сурагч+өдөр бүрийн НЭГ тэмдэглэгээ (өнгө + чөлөөт
// тайлбар). Мөр байхгүй бол "тэмдэглээгүй" (цагаан/хоосон, багш хараахан
// дүгнээгүй) — status null-ийг зөвшөөрнө.
enum HomeworkMarkStatus {
  DONE // хийсэн — ногоон
  PARTIAL // дутуу — шар
  NOT_DONE // хийгээгүй — улаан
}

model DailyHomeworkMark {
  id          String              @id @default(cuid())
  classroomId String
  classroom   Classroom           @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  studentId   String
  student     User                @relation("DailyHomeworkMarkStudent", fields: [studentId], references: [id], onDelete: Cascade)
  date        DateTime            @db.Date
  // null = багш хараахан тэмдэглээгүй (өгөгдмөл, цагаан харагдана)
  status      HomeworkMarkStatus?
  comment     String?
  markedById  String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([classroomId, studentId, date])
  @@index([classroomId, date])
  @@index([studentId, date])
}

// ============ Контент: Ном → Бүлэг сэдэв → Бодлого ============

// Хичээлийн төрөл — төв Математикаас гадна Нийгэм судлал, SAT мөн заадаг болсон.
// Enum-ыг Book дээр л тавьсан (тусдаа Subject модель биш): Chapter/Test/Topic-ийн
// хичээл нь Book-оор дамжин л тодорхойлогдоно (энэ migration-д тэдгээрт нэмэхгүй).
// SAT: одоогоор ЗӨВХӨН танхимд, бат бэх болоогүй тул EnrollmentWindow-д
// COMING_SOON статустай эхэлнэ (доор харна уу).
enum Subject {
  MATH
  SOCIAL_STUDIES
  SAT
}

model Book {
  id          String  @id @default(cuid())
  code        String  @unique // нийтэд харагдах цэвэр код: "100", "200", "300", "1000"
  title       String // нийтэд харагдах цэвэр нэр: "100x100"
  coverKey    String?
  // Жинхэнэ эх фолдер (админд мөрдөгдөх): UI-д "100x100" гэж харагдах ч дата нь
  // "100x100 V2" фолдероос ирснийг тэмдэглэнэ. ProblemAnalysis.sourcePath-тай уялдана.
  sourceLabel String?
  // Хуучин (V2 биш) шилжүүлсэн ном — каталогт харагдахгүй, харин дата нь хэвээр.
  archived    Boolean @default(false)
  // Аль хичээлд хамаарах вэ. Одоо байгаа ~6000 мөр Математик тул @default(MATH)
  // автоматаар бөглөнө.
  subject     Subject @default(MATH)

  // Зөөлөн устгал (soft delete): Attempt/TestResult зэрэг түүхэн бичлэгийг
  // орфон үлдээхгүйн тулд hard DELETE хийхгүй. Уншихдаа заавал deletedAt: null
  // гэж шүүнэ.
  deletedAt DateTime?

  chapters Chapter[]

  @@index([archived])
  @@index([subject])
  @@index([deletedAt])
}

model Chapter {
  id          String  @id @default(cuid())
  bookId      String?
  book        Book?   @relation(fields: [bookId], references: [id])
  title       String
  order       Int
  grade       Int? // аль ангийн хүүхдэд харагдах вэ
  // Нийтэд үнэгүй preview эсэх (эхний онол + эхний тест)
  freePreview Boolean @default(false)
  // БҮТ-ийн үндсэн сэдвийн муж (админ засварладаг, Шийдвэр 5)
  topicId     String?
  topic       Topic?  @relation(fields: [topicId], references: [id])

  // Зөөлөн устгал: hard DELETE хийвэл Attempt/TestResult зэрэг түүхэн
  // бичлэгүүд орфон үлдэнэ. Уншихдаа заавал deletedAt: null гэж шүүнэ.
  deletedAt DateTime?

  problems Problem[]
  theories TheoryBlock[]
  videos   Video[]
  tests    Test[]

  @@index([grade, order])
  @@index([topicId])
  @@index([deletedAt])
}

// БҮТ-ийн үндсэн агуулгын муж (Тоо тоолол, Алгебр, Функц, Геометр, Магадлал...).
// Админ засварладаг жагсаалт — код хөндөхгүйгээр нэр/дараалал өөрчлөгдөнө (Шийдвэр 5).
model Topic {
  id    String @id @default(cuid())
  name  String @unique
  order Int    @default(0)

  // Зөөлөн устгал: hard DELETE хийвэл холбогдох Chapter-үүдийн түүхэн дата
  // орфон үлдэнэ. Уншихдаа заавал deletedAt: null гэж шүүнэ.
  deletedAt DateTime?

  chapters Chapter[]

  @@index([deletedAt])
}

model TheoryBlock {
  id          String   @id @default(cuid())
  chapterId   String
  chapter     Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  title       String
  content     String // markdown
  imageKeys   String[]
  order       Int
  freePreview Boolean  @default(false)
}

model Video {
  id        String   @id @default(cuid())
  title     String
  s3Key     String
  duration  Int? // секунд
  chapterId String?
  chapter   Chapter? @relation(fields: [chapterId], references: [id])
  createdAt DateTime @default(now())

  // Зөөлөн устгал: hard DELETE хийвэл холбогдох LearningEvent зэрэг түүхэн
  // лог орфон үлдэнэ. Уншихдаа заавал deletedAt: null гэж шүүнэ.
  deletedAt DateTime?

  @@index([deletedAt])
}

enum ProblemFormat {
  CHOICE // сонгох тест (A,B,C,D…)
  FILL_NUMBER // ЭЕШ маягийн тоо нөхөх (a=…, b=…)
  OPEN // задгай хариулт
}

// Сурагч буруу хариу сонгосон бол ЯАГААД сонгосон шалтгааны төрөл.
// Энэ нь "энэ хүүхэд ингэж алдсан" гэсэн дата цуглуулахад чухал (SPEC §9).
enum MistakeType {
  NONE // зөв хариу — алдаа биш
  SIGN_ERROR // тэмдэг алдсан (+/−)
  INCOMPLETE_STEP // үйлдэл дутуу хийж зогссон
  CALC_ERROR_NEAR // энгийн нэмэх/хасах алдаа → ойролцоо хариу дугуйлсан
  CONCEPT_GAP // ухагдахуун/арга ойлгоогүйгээс
  UNRELATED_GUESS // огт хамааралгүй хариу → буудсан
  OTHER // бусад (тайлбар бичнэ)
}

// Бодлогын нэг сонголт (A–E). Зөв/буруу эсэх + буруу бол ЯАГААД алдсаныг хадгална.
// Багш/Багш+ гараар нэг бүрчлэн засна (AI автоматаар "баталгаажсан" гэж тэмдэглэхгүй).
model ProblemChoice {
  id          String      @id @default(cuid())
  problemId   String
  problem     Problem     @relation(fields: [problemId], references: [id], onDelete: Cascade)
  label       String // "A".."E" эсвэл "a".."e"
  text        String // сонголтын утга (LaTeX-тэй байж болно)
  isCorrect   Boolean     @default(false)
  mistakeType MistakeType @default(NONE) // буруу бол алдааны төрөл
  mistakeNote String? // багшийн тайлбар: яагаад энэ хариу руу хүрдэг вэ
  order       Int

  @@unique([problemId, label])
  @@index([problemId])
}

model Problem {
  id            String        @id @default(cuid())
  token         String        @unique // "100-23-05" = ном-хуудас-бодлого
  chapterId     String
  chapter       Chapter       @relation(fields: [chapterId], references: [id])
  page          Int?
  number        Int?
  format        ProblemFormat
  statementText String?
  imageKey      String?
  choices       Json? // CHOICE форматын сонголтууд
  correctAnswer Json // форматаас хамаарсан бүтэцтэй
  points        Int           @default(1)
  price         Int? // дэлгүүрт тусдаа зарагдвал (₮)
  createdById   String
  createdAt     DateTime      @default(now())

  // Датанаас тооцогддог үзүүлэлтүүд — гараар оноохгүй (SPEC §9.3)
  eloRating    Float  @default(1000)
  attemptCount Int    @default(0)
  correctRate  Float?

  // Зөөлөн устгал: hard DELETE хийвэл Attempt зэрэг аналитикийн түүхэн
  // бичлэгүүд орфон үлдэнэ. Уншихдаа заавал deletedAt: null гэж шүүнэ.
  deletedAt DateTime?

  tags          ProblemTag[]
  formulas      ProblemFormula[]
  analysis      ProblemAnalysis?
  choiceOptions ProblemChoice[] // бүтэцтэй сонголтууд (correct/wrong + алдааны шалтгаан)
  attempts      Attempt[]
  testItems     TestProblem[]

  @@index([chapterId])
  @@index([deletedAt])
}

// Таксономи: бодлогыг ангилах ангилалууд. Tag нь нэрлэгдсэн REFERENCED entity —
// нэрийг нь нэг өөрчлөхөд тэрхүү tag-тай холбоотой БҮХ бодлого автоматаар
// шинэчлэгддэг (admin code-руу орох шаардлагагүй, багш гараар нэрлэнэ).
enum TagType {
  METHOD // бодох арга: орлуулах, хувиргах…
  QUESTION_FORM // асуултын хэлбэр: утга олох, график унших…
  SUBTOPIC // дэд сэдэв: бутархай, тойрог…
  SKILL // ур чадвар: анхаарал, тооцоолол…
  SOLUTION_TYPE // бодогдох төрөл: "Дискриминантаар бодох", "Виетээр бодох"… (багш засна)
}

model Tag {
  id   String  @id @default(cuid())
  type TagType
  name String

  problems ProblemTag[]

  @@unique([type, name])
}

model ProblemTag {
  problemId String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([problemId, tagId])
}

// Томьёо бүр бүртгэлтэй объект (SPEC §7.2)
model Formula {
  id          String  @id @default(cuid())
  name        String  @unique // "Виетийн теорем"
  latex       String?
  description String?

  problems ProblemFormula[]
}

model ProblemFormula {
  problemId String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  formulaId String
  formula   Formula @relation(fields: [formulaId], references: [id], onDelete: Cascade)

  @@id([problemId, formulaId])
}

// Бодлого бүрийн нарийн шинжилгээ — сэдэв, томьёо, тодорхойлох муж,
// тэмдэг солигдох дүрэм, нийтлэг алдааг source-оос салгаж хадгална.
enum ProblemAnalysisStatus {
  AUTO_DRAFT // системийн дүрмээр автоматаар үүсгэсэн, багш баталгаажуулаагүй
  REVIEW_REQUIRED // source/хариу/parse тодорхойгүй тул заавал хүн шалгана
  VERIFIED // багш/админ баталгаажуулсан
}

enum AnswerKeyStatus {
  VERIFIED // хариуны түлхүүрээс үсэг/утга баталгаатай олдсон
  MISSING // хариуны түлхүүрт хоосон эсвэл олдоогүй
  REVIEW_REQUIRED // source болон хариу зөрөх магадлалтай тул хүн шалгана
}

model ProblemAnalysis {
  problemId       String                @id
  problem         Problem               @relation(fields: [problemId], references: [id], onDelete: Cascade)
  status          ProblemAnalysisStatus @default(AUTO_DRAFT)
  answerKeyStatus AnswerKeyStatus       @default(VERIFIED)
  confidence      Float                 @default(0)
  sourcePath      String?
  sourceVariant   String?
  topic           String
  subtopic        String?
  skills          String[]
  methods         String[]
  formulas        Json
  domainNotes     String[]
  signRules       String[]
  commonMistakes  String[]
  solutionOutline String?
  auditNotes      String[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([status])
  @@index([answerKeyStatus])
  @@index([topic])
}

// ============ Тест / Шалгалт ============

enum TestType {
  DAILY // өдөр тутмын
  CHAPTER_EXAM // сэдвийн бүлгийн шалгалт (36+4, дүнг багш оруулна)
  EESH_MOCK // ЭЕШ сорил
  CUSTOM
  THEORY // онолын асуулт-хариултын модуль (Шийдвэр 8)
}

enum TestGradingMode {
  AUTO // зөв хариу баталгаатай, систем шууд оноо бодно
  MANUAL // PDF/source орсон ч хариу баталгаажаагүй эсвэл багш гараар дүн оруулна
}

model Test {
  id           String          @id @default(cuid())
  title        String
  type         TestType
  gradingMode  TestGradingMode @default(AUTO)
  chapterId    String?
  chapter      Chapter?        @relation(fields: [chapterId], references: [id])
  timeLimitMin Int?
  pdfKey       String? // PDF-ээр оруулсан тест (Багш+/Админ)
  price        Int?
  // A/B хувилбарууд: groupKey ижил, variantLabel ялгаатай (ж: "Тест 18" → A, B)
  groupKey     String?
  variantLabel String?
  createdById  String
  createdAt    DateTime        @default(now())

  // Зөөлөн устгал: hard DELETE хийвэл TestResult/Attempt зэрэг түүхэн
  // бичлэгүүд орфон үлдэнэ. Уншихдаа заавал deletedAt: null гэж шүүнэ.
  deletedAt DateTime?

  problems        TestProblem[]
  access          TestAccess[]
  results         TestResult[]
  attemptSessions TestAttemptSession[]

  @@index([deletedAt])
}

model TestProblem {
  testId    String
  test      Test    @relation(fields: [testId], references: [id], onDelete: Cascade)
  problemId String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  order     Int
  points    Int     @default(1)

  @@id([testId, problemId])
}

// Тест аль ангиудад харагдахыг сонгоно — автоматаар бүх ангид харагдахгүй
model TestAccess {
  testId      String
  test        Test      @relation(fields: [testId], references: [id], onDelete: Cascade)
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@id([testId, classroomId])
}

// Онлайн шалгалтын session — сервер-эрхт таймер, shuffle, autosave (Шийдвэр 2).
// Дараалал анх нэг удаа санамсаргүй үүсээд session дуустал хөлдөнө; явц нь
// draftAnswers-т хадгалагдах тул refresh/гацалтад тэсвэртэй. Дуусмагц хөлддөг.
enum AttemptSessionStatus {
  IN_PROGRESS
  SUBMITTED
}

model TestAttemptSession {
  id        String @id @default(cuid())
  testId    String
  test      Test   @relation(fields: [testId], references: [id], onDelete: Cascade)
  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  seed         Int // shuffle-ийн үр (аудит мөрдлөгт)
  problemOrder Json // [problemId] — харуулах дараалал (одоогоор каноник)
  choiceOrder  Json // { problemId: [эх индексүүд display дарааллаар] } — TEXT горимд л
  draftAnswers Json @default("{}") // { problemId: displayIdx | үсэг | утга }
  draftStates  Json @default("{}") // { problemId: SelfState }
  problemTimes Json @default("{}") // { problemId: сек } — бодлого бүрийн бодит хугацаа
  leaveCount   Int  @default(0) // шалгалтын горимоос гарсан тоо (анти-чит)
  events       Json @default("[]") // [{t, type}] — сүүлийн 100 үйл явдал

  startedAt   DateTime             @default(now())
  deadlineAt  DateTime? // null = хугацаагүй; шалгалтыг сервер энэ цагаар хаана
  status      AttemptSessionStatus @default(IN_PROGRESS)
  submittedAt DateTime?
  updatedAt   DateTime             @updatedAt

  @@unique([testId, studentId])
  @@index([studentId, status])
}

model TestResult {
  id          String        @id @default(cuid())
  testId      String
  test        Test          @relation(fields: [testId], references: [id], onDelete: Cascade)
  studentId   String
  student     User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  totalScore  Float
  maxScore    Float
  enteredById String? // CHAPTER_EXAM үед багш гараар оруулна
  source      AttemptSource
  createdAt   DateTime      @default(now())

  @@unique([testId, studentId])
  @@index([studentId])
}

// ============ Оролдлого — аналитикийн цөм (SPEC §9) ============

enum SelfState {
  SOLVED_CLEAN // ✅ 100% ойлгож, алдалгүй бодсон
  FIXED_AFTER_ERROR // 🔁 эхэлж алдаад засч дуусгасан
  FAILED // ❌ алдсан / чадаагүй
  GUESSED // 🎯 буудсан — таамгаар оноо авсан
}

enum AttemptSource {
  EVENING_SELF_REPORT // оройн өөрийн тэмдэглэгээ (танхимд утас хураадаг тул)
  ONLINE_TEST // системийн авто шалгалт
  CHAPTER_EXAM // 36+4 шалгалт, багш оруулсан
  OMR_IMPORT // хариултын хуудас уншигч машин
}

model Attempt {
  id           String        @id @default(cuid())
  studentId    String
  student      User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  problemId    String
  problem      Problem       @relation(fields: [problemId], references: [id], onDelete: Cascade)
  source       AttemptSource
  // Аль өдрийн хичээлд хамаарах вэ (оройн тэмдэглэгээ өчигдрийнхөө өдрөөр бичигдэнэ)
  occurredOn   DateTime      @db.Date
  autoCorrect  Boolean? // системийн авто үр дүн (онлайн тест, OMR)
  selfState    SelfState? // өөрийн тэмдэглэгээ
  timeSpentSec Int?

  /**
   * Сурагчийн ЯГ ЮУ хариулсан — гүйцэтгэлийн үнэлгээ БИШ, агуулга.
   * ⚠️ ЯАГААД ЭНЭ ХЭРЭГТЭЙ ВЭ (2026-08-08-нд нэмсэн):
   * Өмнө нь зөвхөн `autoCorrect` (үнэн/худал) хадгалагддаг байсан. Тэр нь
   * «буруу» гэдгийг л хэлнэ, «ЯАГААД буруу» гэдгийг хэлэхгүй. Улмаас:
   * • distractor analysis (аль буруу сонголтыг хэн сонгов) БОЛОМЖГҮЙ
   * • алдааны ангилал / misconception илрүүлэлт БОЛОМЖГҮЙ
   * • ирээдүйд загвар сургахад хамгийн үнэ цэнэтэй дохио ДУТУУ
   * Хариулт нь `TestAttemptSession.draftAnswers`-т үлддэг ч тэр нь зөвхөн
   * онлайн сесстэй холбоотой, цаасан/OMR эх сурвалжийг хамрахгүй.
   * ХАДГАЛАХ УТГА: `gradeAnswer()`-ийн буцаадаг `canonicalAnswer` —
   * сонголтын ЖИНХЭНЭ ТЕКСТ (эсвэл тоон хариу), холилтын дараалалаас ҮЛ
   * ХАМААРНА. Түүхий индекс хадгалбал тухайн сессийн `choiceOrder` байхгүй
   * бол дараа нь тайлагдахгүй болно.
   * Хоосон (null) байж болно: хариулаагүй, эсвэл хариу тодорхойгүй бодлого.
   */
  givenAnswer Json?
  testId      String?
  classroomId String?
  createdAt   DateTime @default(now())

  @@index([studentId, occurredOn])
  @@index([problemId])
  @@index([studentId, problemId])
}

// Шөнө бүрийн cron-ийн анги тус бүрийн өдрийн дүгнэлт (SPEC §9.1.1)
model DailyClassSummary {
  id          String    @id @default(cuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  date        DateTime  @db.Date
  stats       Json // тэмдэглэсэн/тэмдэглээгүй, төлөвийн тархалт, сэдвийн зураглал
  createdAt   DateTime  @default(now())

  @@unique([classroomId, date])
}

// Таамаглал бүр хадгалагдаж бодит үр дүнтэй харьцуулагдана (SPEC §9.3)
enum PredictionKind {
  ERROR_RISK // "энэ сэдэв/бодлогод алдах магадлал X%"
  EESH_SCORE // таамаглах ЭЕШ онооны муж
}

model Prediction {
  id          String         @id @default(cuid())
  studentId   String
  student     User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  kind        PredictionKind
  payload     Json // таамаглалын утга, муж, ашигласан загварын хувилбар
  predictedAt DateTime       @default(now())
  evaluatedAt DateTime?
  actual      Json? // бодит үр дүн — загварын нарийвчлалыг хэмжихэд

  @@index([studentId, kind])
}

// Багшийн өнгөний тэмдэглэгээ — зөвхөн багш нар + админд харагдана (SPEC §13.1)
model StudentColorTag {
  id          String   @id @default(cuid())
  studentId   String
  student     User     @relation("TaggedStudent", fields: [studentId], references: [id], onDelete: Cascade)
  color       String // hex эсвэл нэрлэсэн өнгө
  note        String?
  createdById String
  updatedAt   DateTime @updatedAt

  @@unique([studentId, createdById])
}

// ============ Сурагчийн тэмдэглэл (Student Notes) ============
// Ерөнхий (GENERAL) болон төлбөртэй холбоотой (PAYMENT) тэмдэглэлийг тусад
// нь ялгаж хадгална — эрхийн матриц дахь мөнгөтэй холбоотой асуудлыг зөвхөн
// Багш+ шийддэг зарчимтай уялдана.
enum StudentNoteType {
  GENERAL
  PAYMENT
}

// БИЗНЕСИЙН ДҮРЭМ (StudentNotesService дотор шалгагдана):
// Жилийн төлбөрөө бүтэн төлсөн сурагчид PAYMENT төрлийн тэмдэглэл үүсгэхийг
// хориглоно (tuitionPlan = FULL_YEAR бөгөөд төлбөр баталгаажсан). Бусад
// сурагчдад зөвшөөрнө. Шалгалт нь StudentNotesService дотор.
model StudentNote {
  id           String          @id @default(cuid())
  studentId    String
  student      User            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type         StudentNoteType
  body         String // 1–4000 тэмдэгт
  createdById  String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  resolvedAt   DateTime?
  resolvedById String?

  @@index([studentId, type])
  @@index([createdAt])
}

// ============ Аудит лог (Audit Log) ============
// Эрхийн матрицаар контент/төлбөр/дүн засварлах эрх Багш+-д нээгдсэнтэй
// холбоотойгоор бүх мөнгөтэй болон бусад засварлагдах бичлэгийн өөрчлөлтийг
// хэн, юуг, хэзээ, ямар шалтгаанаар өөрчилснийг бүрэн хадгална.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actorRole String
  action    String // ж: "UPDATE", "CONFIRM", "REVERSE", "DELETE"
  entity    String // ж: "Payment", "StudentProfile", "TestResult"
  entityId  String
  before    Json?
  after     Json?
  reason    String?
  at        DateTime @default(now())

  @@index([actorId])
  @@index([at])
  @@index([entity, entityId])
  @@index([actorId, at])
}

// ============ Эрх (named pass) ба Төлбөр ============

model Pass {
  id           String  @id @default(cuid())
  name         String  @unique // "Сарын онлайн эрх", "ЭЕШ багц", "Тоо тоолол бүлэг"…
  durationDays Int
  // Хамрах хүрээ: chapterIds, bookIds, videoIds, testIds жагсаалтууд
  scope        Json
  price        Int? // заавал биш — чөлөөт дүнгийн зарчимтай зэрэгцэнэ
  active       Boolean @default(true)

  userPasses UserPass[]
}

model UserPass {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  passId    String
  pass      Pass     @relation(fields: [passId], references: [id])
  startsAt  DateTime @default(now())
  expiresAt DateTime
  paymentId String?

  @@index([userId, expiresAt])
}

enum PaymentMethod {
  QPAY
  BANK_TRANSFER
  CASH
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
  REVERSED // Багш+/Админ баталгаажсан төлбөрийг буцаасан — эрх автоматаар цуцлагдана
}

model Payment {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id])
  amount            Int // хэрэглэгчийн өөрөө бичсэн дүн (₮)
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  description       String? // төлсөн зам, тайлбар
  forMonth          String? // "2026-09" — аль сарын төлбөр
  paidAt            DateTime?
  confirmedById     String? // данс/бэлэн үед Багш+/Админ гараар баталгаажуулна
  qpayInvoiceId     String?
  // QPay-ийн ГҮЙЛГЭЭНИЙ дугаар (invoice биш). Callback хоёр удаа ирэх, эсвэл
  // callback болон polling хоёулаа нэг гүйлгээг барих нь ХЭВИЙН тохиолдол —
  // @unique нь тэр үед хоёр дахь бичилтийг ӨС түвшинд зогсооно. Кодын түвшний
  // шалгалт race condition-д алдаж болох тул баталгаа нь ЭНД байх ёстой.
  providerPaymentId String?       @unique
  createdAt         DateTime      @default(now())

  @@index([userId, forMonth])
  @@index([status])
}


// ============ Нэг удаагийн худалдан авалт (тест, ном, эрх) ============

enum ProductKind {
  TEST // сургалтын шалгалт
  BOOK // нууцлалт хэрэглэгдэх хичээл ном
  PASS // ХУГАЦААТ эрх (одоогийн Pass模型 орнот)
}

model ProductItem {
  id     String      @id @default(cuid())
  kind   ProductKind
  refId  String // Test.id эсвэл Book.id
  price  Int // ₮, БҮХЭЛ (Float ХЭРЭГЛЭХГҮЙ)
  active Boolean     @default(true)

  purchases Purchase[]

  @@unique([kind, refId])
  @@index([active])
}

model Purchase {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  productItemId String
  productItem   ProductItem @relation(fields: [productItemId], references: [id], onDelete: Cascade)
  paymentId     String? // тав Payment-тэй холбоогүй худалдан авалт ч байж болно (эзний шийдвэр)
  price         Int // ₮, худалдан авах үеийн үнэ (шалтгаанаас хамаарна шинээр өөрчлөгдсөн бодвол)
  grantedAt     DateTime? // эрх эхлэсэн цаг
  expiresAt     DateTime? // эрх дуусах цаг (ном нь null, тест = гэрээний үргэлжлэх хугацаа)
  createdAt     DateTime    @default(now())

  @@index([userId, productItemId])
  @@index([userId, expiresAt])
}

// ============ Орлого/зарлага ============

enum ExpenseCategory {
  SALARY // цалин
  RENT // ааш
  UTILITIES // коммунал
  MARKETING // сурталчилга
  MATERIALS // материал
  EQUIPMENT // тоног төхөөрөмж
  OTHER // бусад
}

model ExpenseRecord {
  id          String          @id @default(cuid())
  amount      Int // ₮
  category    ExpenseCategory
  description String?
  occurredOn  DateTime        @db.Date
  createdById String
  createdAt   DateTime        @default(now())

  @@index([occurredOn])
  @@index([category])
  @@index([createdAt])
}

// ============ Төлбөрийн буцаалт ============

enum RefundStatus {
  DRAFT // ноорог (ТООЦОО хийгдсэн, баталгаажаагүй)
  PENDING_APPROVAL // админд явуулсан (баталгаажахыг хүлээж байна)
  APPROVED // админ баталгаажуулсан
  PAID // төлөгдсөн
  CANCELLED // цуцалсан
}

model TuitionRefund {
  id                 String       @id @default(cuid())
  studentId          String
  student            User         @relation(fields: [studentId], references: [id], onDelete: Cascade, name: "StudentTuitionRefunds")
  classroomId        String
  classroom          Classroom    @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  leftOn             DateTime     @db.Date // ангиас гарсан огноо
  totalLessonDays    Int // гэрээний нийт хичээлийн өдөр
  attendedLessonDays Int // суусан хичээлийн өдөр
  dailyRate          Int // ₮/өдөр (бүхэл, дугуйруулсан)
  totalPaid          Int // ₮, нийт төлсөн
  owed               Int // ₮, барагдуулсан хэмжээ
  refundAmount       Int // ₮, буцаалтын хэмжээ (owed - totalPaid нь сөрөг байвал 0)
  shortfall          Int // ₮, дутуу төлсөн дүн (сөрөг байж болохгүй)
  status             RefundStatus @default(DRAFT)
  warnings           String? // Анхааруулга (JSON массив)
  note               String? // админ, багш+ тайлбар
  paymentMethod      String? // "BANK_TRANSFER", "CASH", "QPAY" гэх мэт

  createdById        String
  createdBy          User         @relation("TuitionRefundCreatedBy", fields: [createdById], references: [id])
  approvedById       String?
  approvedBy         User?        @relation("TuitionRefundApprovedBy", fields: [approvedById], references: [id])
  approvedAt         DateTime?

  paidById           String?
  paidBy             User?        @relation("TuitionRefundPaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  paidAt             DateTime? // төлөгдсөн цаг

  cancelledById      String?
  cancelledBy        User?        @relation("TuitionRefundCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  cancelledAt        DateTime?
  cancelReason       String?

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([studentId])
  @@index([status])
  @@index([classroomId, leftOn])
}

// Төвийн зарлал — танхимын сурагчдын нийтийн самбарт харагдана
enum AnnouncementAudience {
  ALL_STUDENTS // бүх сурагч
  ALL_CLASSROOM // бүх танхимын сурагчид
  ALL_ONLINE // бүх онлайн сурагч
  ONE_CLASSROOM // тодорхой нэг анги (хуучин compatibility)
  SELECTED_CLASSROOMS // олон тодорхой анги
}

model Announcement {
  id               String                        @id @default(cuid())
  title            String
  body             String
  audience         AnnouncementAudience          @default(ALL_CLASSROOM)
  classroomId      String? // ONE_CLASSROOM үед
  pinned           Boolean                       @default(false)
  createdById      String
  createdAt        DateTime                      @default(now())
  classroomTargets AnnouncementClassroomTarget[]

  // Зөөлөн устгал: hard DELETE-ийн оронд түүхийг хадгална. Уншихдаа заавал
  // deletedAt: null гэж шүүнэ.
  deletedAt DateTime?

  @@index([audience, createdAt])
  @@index([classroomId])
  @@index([deletedAt])
}

model AnnouncementClassroomTarget {
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  classroomId    String
  classroom      Classroom    @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@id([announcementId, classroomId])
  @@index([classroomId])
}

// Анги тухайн өдөр ямар тест/шалгалт хийснийг багш бүртгэнэ.
// Сурагч оройн тэмдэглэгээндээ token мэдэхгүйгээр бодлогуудаа эндээс шууд хардаг.
model ClassTestSession {
  id                 String   @id @default(cuid())
  classroomId        String
  // Бодлогын сангийн тест бол энд testId байна.
  // ГАРААР бичсэн (гаднын) тест бол testId = null, оронд нь manualTitle.
  // Учир: сурагчид заримдаа манай санд ОГТ байхгүй бодлого бодох тул багш
  // зөвхөн НЭРИЙГ нь бичээд бүртгэх боломжтой байх ёстой. Тест үүсгэхгүй.
  testId             String?
  // Гараар бичсэн тестийн нэр (testId = null үед л утгатай)
  manualTitle        String?
  // Гараар бичсэн тестийн бодлогын тоо — сурагчийн оройн тэмдэглэгээнд
  // 1..N хүртэлх дугаар гаргахад ашиглана.
  manualProblemCount Int?
  date               DateTime @db.Date
  createdById        String
  createdAt          DateTime @default(now())

  // Тухайн анги уг өдөр ХИЙГЭЭГҮЙ (алгассан) бодлогуудын Problem.id.
  // Хоосон = бүх бодлого орсон. Сурагчийн оройн тэмдэглэгээнд эдгээр харагдахгүй.
  excludedProblemIds String[] @default([])

  @@unique([classroomId, testId, date])
  @@index([classroomId, date])
}

// ============ Сурагчийн үйлдлийн урсгал (Knowledge-Tracing/аналитикийн суурь) ============

enum LearningEventType {
  LOGIN
  LOGOUT
  SEARCH
  CHAPTER_OPENED
  VIDEO_STARTED
  VIDEO_COMPLETED
  PROBLEM_OPENED
  ANSWER_SUBMITTED
  HINT_USED
  RETRY
  BOOKMARK
  TEST_STARTED
  TEST_FINISHED
  EVENING_MARK
  PAGE_VIEW
}

// Зөвхөн нэмэгддэг (append-only) төлөвийн урсгал — ирээдүйн Knowledge-Tracing/
// аналитик давхаргын суурь. problemId/testId/chapterId/videoId-г санаатайгаар
// холбоос (foreign key) биш, чөлөөт String болгосон: энэ бол аналитикийн лог тул
// холбогдох контент устсан ч (Problem/Test/Chapter/Video устгагдсан ч) хуучин
// event-үүд алдагдахгүй, лог бүрэн хадгалагдана.
model LearningEvent {
  id         String            @id @default(cuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       LearningEventType
  occurredAt DateTime          @default(now())
  // Клиент талд үүсгэсэн session бүлэглэлт (нэг landing-аас гарах хүртэлх урсгал)
  sessionId  String?
  problemId  String?
  testId     String?
  chapterId  String?
  videoId    String?
  durationMs Int?
  device     String?
  meta       Json?

  // Дан @@index([userId]) байсныг ХАССАН (PERF-AUDIT.md §0 олдвор #8): доорх
  // composite [userId, occurredAt]-ийн prefix нь `WHERE userId = ...` query-г
  // аль хэдийн бүрхдэг тул давхардал байсан — EXPLAIN-ээр баталгаажуулав (энэ
  // migration-ий description-д дэлгэрэнгүй). Экзамен-hot биш ч write overhead-г
  // (exam замд Attempt/TestAttemptSession bulk write-той зэрэгцэн ажилладаг DB
  // instance) шалтгаангүй нэмдэг байсныг цэвэрлэв.
  @@index([occurredAt])
  @@index([sessionId])
  @@index([userId, occurredAt])
}

// ============ Элсэлтийн цонх (Enrollment Windows) ============
// Эзний тогтоосон дүрэм (2026-07-27): элсэлт жилийн турш бүх цагт нээлттэй
// биш, хичээл БҮР ӨӨРСДИЙН ХУВЬД дүүрч болно. Багш+/Админ хичээл тус бүрийг
// өөрсдөө нээж/хааж чадах ёстой тул статусыг код руу chit хийхгүй, энэ
// хүснэгтэд дата болгож хадгална.
enum EnrollmentStatus {
  OPEN
  CLOSED
  COMING_SOON
}

// 🎯 Танхим/онлайн сурагчид аль хичээл нээлттэйг тодорхойлно — ЭНЭ БОЛ
// ЭЗНИЙ ГОЛ ДҮРМИЙГ ДАТА БОЛГОСОН хэсэг (UI дотор hardcode хийхгүй):
//   Математик        → BOTH (танхим ба онлайн хоёуланд)
//   Нийгэм судлал     → CLASSROOM_ONLY
//   SAT               → CLASSROOM_ONLY (мөн одоогоор COMING_SOON)
// Ирээдүйд төв Нийгэм судлалыг онлайнаар нээвэл энэ зөвхөн НЭГ МӨРИЙН
// (EnrollmentWindow.availability) утга солих байх ёстой — код өөрчлөх
// шаардлагагүй.
enum SubjectAvailability {
  CLASSROOM_ONLY
  ONLINE_ONLY
  BOTH
}

// Хичээл тус бүрийн элсэлтийн цонх — landing page (нийтэд) болон Lead
// баталгаажуулалт (сервер талд) хоёул үүнийг эх сурвалж болгон уншина.
model EnrollmentWindow {
  id           String              @id @default(cuid())
  subject      Subject             @unique
  status       EnrollmentStatus
  availability SubjectAvailability
  note         String?
  updatedById  String
  updatedAt    DateTime            @updatedAt
}

// ============ Нийтийн лийд бүртгэл (Landing page lead-capture) ============
// Бизнесийн контекст: төв Facebook-ийн 7,900 followers-тэй ч бүх элсэлтийг
// гараар Messenger DM-ээр боловсруулдаг байсан (шөнө/амралтын өдөр алдагдсан
// лийд, хэмжигдэхгүй урсгал). Энэ хүснэгт нүүр хуудасны 4 талбарт маягтаас
// (Нэр/Утас/Хичээл/Анги) ирсэн хүсэлтийг бодитоор хадгалж, ADMIN/TEACHER_PLUS
// нар статусыг нь ажиллуулна.

// LeadSubject нь Content модулийн Subject enum-тай яг адилгүй: энд лийд
// "аль аль хичээлээр" сонирхож болох тул BOTH нэмэлт утгатай. Тиймээс
// Book/Chapter-д ашиглагдаж буй Subject enum-ыг өөрчлөхгүй, тусад нь
// зарлав — өөр модулийн миграцтай мөргөлдөхгүй.
enum LeadSubject {
  MATH
  SOCIAL_STUDIES
  BOTH
}

enum LeadStatus {
  NEW
  CONTACTED
  ENROLLED
  LOST
}

// Нийтийн (нэвтрэлтгүй) маягтаас ирдэг тул userId огт байхгүй — зөвхөн
// сонирхогчийн бөглөсөн 4 талбар + ажилтны ажиллуулах статус.
model Lead {
  id        String      @id @default(cuid())
  name      String
  phone     String
  // ХАСАГДСАН (deprecated): хуучин "нэг хичээл" талбар. Зөвхөн ХУУЧИН
  // бичлэгүүд алдагдахгүй байхын тулд үлдээв — шинэ код бүгд `subjects`-ийг
  // ашиглана. Шинэ бичилт хийхдээ энэ талбарыг `subjects`-ээс тооцоолж
  // бөглөнө (нэг хичээл → тэр утга; олон хичээл → BOTH).
  subject   LeadSubject
  // Сонирхогчийн сонгосон хичээлүүд (1–3ыг зөвшөөрнө, DTO дээр шалгана).
  subjects  Subject[]
  grade     Int
  status    LeadStatus  @default(NEW)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
}

// ============ Ажилтны төлөвлөгч (Staff Work Planner) ============
// Жилийн турш 16 ажилтан ажлаа жижиг даалгавар болгон хуваан төлөвлөнө
// (Taskly загварчлал). parentTaskId нь нэг том ажлыг дэд даалгавар
// (subtask) болгон "жижиг хэсэг болгон хуваах" шаардлагыг хангана.

enum TaskStatus {
  PLANNED
  IN_PROGRESS
  DONE
  BLOCKED
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model StaffTask {
  id            String       @id @default(cuid())
  title         String
  description   String?
  status        TaskStatus   @default(PLANNED)
  priority      TaskPriority @default(NORMAL)
  startDate     DateTime?
  dueDate       DateTime?
  // Эцэг даалгавар устахад дэд даалгаварууд устахгүй, харин дээд
  // түвшний бие даасан даалгавар болж үлдэнэ (parentTaskId = null).
  parentTaskId  String?
  parentTask    StaffTask?   @relation("StaffTaskSubtasks", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subtasks      StaffTask[]  @relation("StaffTaskSubtasks")
  createdById   String
  createdBy     User         @relation(fields: [createdById], references: [id])
  classroomId   String?
  classroom     Classroom?   @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  subject       Subject?
  estimateHours Int?
  orderIndex    Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  assignees StaffTaskAssignee[]

  @@index([status, dueDate])
  @@index([dueDate])
}

// Нэг даалгавар дээр олон ажилтан хамтарч болно (олон-олон холбоос).
model StaffTaskAssignee {
  taskId     String
  task       StaffTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime  @default(now())

  @@id([taskId, userId])
}

// ============ Хичээлийн хуваарь (Class Schedule) ============
// Хуваарь долоо хоног бүр бараг өөрчлөгддөггүй тул тодорхой огноон дээрх
// мөр мөрөөр биш, ДАВТАГДАХ ХЭВ МАЯГ (recurring pattern) байдлаар хадгална.
// startMinute/endMinute-ийг DateTime биш, шөнө дундаас хойшхи МИНУТ тоогоор
// хадгалсан: хуваарь бол тодорхой ХУАНЛИЙН ОГНОО огт байхгүй, зөвхөн 7
// хоногийн өдөр дээр давтагддаг хэв маяг тул огноо шаарддаг DateTime төрөл
// ашиглавал шаардлагагүй цагийн бүсийн (timezone) асуудлыг датандаа чирж
// оруулах болно — минутаар хадгалснаар энэ асуудал огт үүсэхгүй.
model ClassSchedule {
  id            String    @id @default(cuid())
  classroomId   String
  classroom     Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  weekday       Int // 0=Ням, 1=Даваа … 6=Бямба (JS Date.getDay()-тэй ижил дараалал)
  startMinute   Int // шөнө дундаас хойшхи минут (жишээ нь 09:00 = 540)
  endMinute     Int
  teacherId     String?
  teacher       User?     @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  room          String?
  subject       Subject?
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())

  exceptions ScheduleException[]
  topics     LessonTopic[]

  @@unique([classroomId, weekday, startMinute, effectiveFrom])
  @@index([classroomId, weekday])
}

// Тухайн долоо хоногийн НЭГ тохиолдол (occurrence) өөрчлөгдөх нь — цуцлагдах
// (CANCELLED) эсвэл өөр огноо/цагт шилжих (MOVED). "date" талбар нь ХУУЧИН,
// анхны тохиолдлын огноо — шинэ огноог newDate-д хадгална.
enum ScheduleExceptionKind {
  CANCELLED
  MOVED
}

model ScheduleException {
  id             String                @id @default(cuid())
  scheduleId     String
  schedule       ClassSchedule         @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  date           DateTime              @db.Date
  kind           ScheduleExceptionKind
  newDate        DateTime?             @db.Date
  newStartMinute Int?
  newEndMinute   Int?
  newRoom        String?
  note           String?
  createdAt      DateTime              @default(now())

  @@unique([scheduleId, date])
}

// Тухайн тохиолдол дээр багшийн товлосон "өнөөдөр орох сэдэв".
model LessonTopic {
  id          String        @id @default(cuid())
  scheduleId  String
  schedule    ClassSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  date        DateTime      @db.Date
  title       String
  // Plain string — Chapter устсан ч энэ бичлэг найдвартай хэвээр үлдэнэ
  // (LearningEvent-ийн адилхан конвенц).
  chapterId   String?
  createdById String
  updatedAt   DateTime      @updatedAt

  @@unique([scheduleId, date])
}

// ============ Багшийн долоо хоногийн ажлын өдрийн бүртгэл ============
// Багш бүр өөрийн гэсэн ажлын өдрийн хэв маягтай (ж: Даваа/Мягмар ирдэггүй)
// — энэ нь ClassSchedule-ээс тусдаа, зөвхөн "энэ багш тухайн өдөр
// төвд ирдэг эсэх"-ийг илэрхийлнэ.
model TeacherWorkDay {
  id        String  @id @default(cuid())
  teacherId String
  teacher   User    @relation("TeacherWorkDayTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  weekday   Int // 0=Ням … 6=Бямба
  note      String?

  @@unique([teacherId, weekday])
}

// Тухайн ганц огноон дээрх давхардлын override — жирийн бол амардаг өдөр
// нэмэлт ажиллах, эсвэл жирийн ажлын өдөр амрах.
model TeacherWorkException {
  id        String   @id @default(cuid())
  teacherId String
  teacher   User     @relation("TeacherWorkExceptionTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  working   Boolean // true = нэмэлт ажиллана, false = амарна
  note      String?

  @@unique([teacherId, date])
}

// ============ Сургалтын хуанли (Academic Calendar) ============
// Төвөөс тогтоосон амралт/чөлөөт өдрүүд. Идэвхийн heatmap-д амралтын
// өдрийг сурагчийн "алгассан" өдөр гэж ХЭЗЭЭ Ч харуулж болохгүй — тэр
// шударга байдлыг л энэ хүснэгт хангана.
enum CalendarDayType {
  HOLIDAY
  BREAK
  EXAM_DAY
  SPECIAL
  NO_CLASS
}

model AcademicCalendarDay {
  id          String          @id @default(cuid())
  date        DateTime        @unique @db.Date
  type        CalendarDayType
  title       String
  note        String?
  createdById String
  createdAt   DateTime        @default(now())
}

// ============ Сурагчийн зорилго (Student Goals) ============
// Ажилтны төлөвлөгчийн сурагч талын хувилбар — сурагч өөрөө богино
// хугацааны зорилго тавьж, явцаа TaskStatus-оор ажиглана.
model StudentGoal {
  id          String     @id @default(cuid())
  studentId   String
  student     User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title       String
  description String?
  targetDate  DateTime?
  status      TaskStatus @default(PLANNED)
  subject     Subject?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([studentId, status])
}

// ============ Стрийк хамгаалалт (Streak Freeze) ============
// Хүндэтгэх шалтгаантай (өвчтэй, айлын хэрэгтэй гэх мэт) тасалдалд
// сурагчийн стрийкийг хамгаална — стрийк тасрахад сурагч сургалтаа
// орхидог (churn) гэдгийг дата харуулсан тул үүнийг бууруулах зорилготой.
model StreakFreeze {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  reason    String?
  createdAt DateTime @default(now())

  @@unique([studentId, date])
}
