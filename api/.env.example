# Pi.mn API — орчны хувьсагчийн жишээ. Хуулаад `.env` болгож бөглөнө.
# Прод дээрх бодит утгыг ЭНД бичихгүй (энэ файл git-д commit хийгддэг).

# ---------------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------------
# Стандарт Postgres connection string. НЭМЭЛТЭЭР доорх query параметрүүдийг
# DATABASE_URL-д ХАВСАРГАЖ болно (pgbouncer/connection pooler ашиглаж байгаа
# бол ЭНД тохируулна, харин манай `PrismaPg` adapter (src/prisma/prisma.service.ts)
# pool sizing-ийг ДООРХ DB_POOL_* env-ээр шууд удирддаг тул ихэнх тохиолдолд
# эдгээр query параметр ХЭРЭГГҮЙ — зөвхөн гадаад pgbouncer/pgpool ашиглах үед
# нэмнэ):
#   ?connection_limit=15   — (Prisma-ийн ӨӨРИЙН URL-based pooling ашиглавал;
#                             манай тохиолдолд DB_POOL_MAX-аар удирддаг тул
#                             давхар бичихгүй)
#   &pool_timeout=10        — секундээр, холболт хүлээх дээд хугацаа
#   &pgbouncer=true          — Render-ийн гадаад PgBouncer/Supavisor ашиглавал
DATABASE_URL="postgresql://pi:pi_dev_password@localhost:5432/pimn?schema=public"

# 🔌 Connection pool sizing — src/prisma/prisma.service.ts дэх Mongolian
# тайлбарт учир шалтгааныг нь бүрэн бичсэн. Товчоор: НЭГ Render instance-д
# зориулж 300 req/s оргил autosave ачааллыг Little's Law-аар тооцоолж (~6
# зэрэг холболт хэрэгтэй) + burst нөөц (~2.5x) = default 15.
#   DB_POOL_MAX-ийг Render Postgres төлөвлөгөөний max_connections-оос ЭРС
#   бага байлгах (нэг instance-д ~15-20, олон instance болвол instance
#   тоогоор хуваана).
DB_POOL_MAX=15
# Сул холболт хүлээх дээд хугацаа (мс) — pool дүүрсэн бол энэ хугацаанд
# алдаа шидээд буцна (хязгааргүй queue үүсгэхгүй, "fail fast").
DB_POOL_CONNECT_TIMEOUT_MS=5000
# Postgres талд нэг SQL query ажиллах дээд хугацаа (мс) — гацсан query-г
# сервер өөрөө таслаж, барьсан холболтоо суллана.
DB_STATEMENT_TIMEOUT_MS=10000
# Ашиглагдаагүй холболтыг pool-оос хасах хүртэлх хугацаа (мс).
DB_POOL_IDLE_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# AUTH
# ---------------------------------------------------------------------------
JWT_SECRET="dev_only_change_in_production"

# ---------------------------------------------------------------------------
# SERVER
# ---------------------------------------------------------------------------
# PORT="4000"
# Frontend-ийн CORS origin (prod-д Vercel домэйн).
# WEB_ORIGIN="https://web-one-pi-59.vercel.app"
# Байршуулсан файлын локал директор (диск идэвхжээгүй бол ./uploads руу буцна).
# UPLOAD_DIR="/var/data/uploads"

# ---------------------------------------------------------------------------
# STORAGE (S3-тэй нийцтэй — одоогоор идэвхжээгүй, диск ашиглаж байна)
# ---------------------------------------------------------------------------
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="pi"
S3_SECRET_KEY="pi_dev_password"
S3_BUCKET="pimn"

# ---------------------------------------------------------------------------
# QPAY (төлбөрийн гарц)
# ---------------------------------------------------------------------------
# QPAY_BASE_URL=""
# QPAY_CLIENT_ID=""
# QPAY_CLIENT_SECRET=""
# QPAY_INVOICE_CODE=""
# QPAY_CALLBACK_URL=""
# QPAY_TOKEN_TTL_FALLBACK_SECONDS="3300"
